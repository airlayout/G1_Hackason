+    def _yd_resample(self, env_ids):
+        """0104: 回ごとの外乱（向きつきの大きさ・始め・長さ）を引き、足した回りを 0 に戻す"""
+        if len(env_ids) == 0:
+            return
+        amp, t0, dur = sample_disturb(
+            self._yaw_disturb, self.door_open_lr[env_ids], torch.rand(len(env_ids), 5, device=self.device)
+        )
+        self._yd_amp[env_ids] = amp
+        self._yd_t0[env_ids] = t0
+        self._yd_dur[env_ids] = dur
+        self._yd_applied[env_ids] = 0.0
+
+    def _apply_yaw_disturb(self):
+        """0104: 物理の前に、この歩の終わりの目標の回りとこれまでに足した回りの差だけ、root を世界の鉛直軸のまわりに回して書く。
+        robot_root_states は 3.0 の xyzw で返り、set_actor_root_state_tensor は環境の 2.x の wxyz を受け取る（並びを直してから書く）"""
+        t_end = (self.episode_length_buf.float() + 1.0) * self.dt
+        delta = ramp_offset(t_end, self._yd_t0, self._yd_dur, self._yd_amp) - self._yd_applied
+        moved = delta.abs() > 1e-7
+        ids = torch.nonzero(moved, as_tuple=False).flatten()
+        if len(ids) == 0:
+            return
+        xyzw = self.simulator.robot_root_states
+        wxyz = torch.cat([xyzw[:, 0:3], xyzw[:, 6:7], xyzw[:, 3:6], xyzw[:, 7:13]], dim=-1)
+        delta = torch.where(moved, delta, torch.zeros_like(delta))
+        self.simulator.set_actor_root_state_tensor(ids, rotate_root_state_wxyz(wxyz, delta))
+        self._yd_applied = self._yd_applied + delta
+        self.log_dict["yaw_disturb_deg"] = torch.rad2deg(self._yd_applied.abs()).mean()
+
     @override
     def step(self, actor_state):
