new file mode 100644
index 0000000..2d037d9
--- /dev/null
+++ b/gr00t/rl/envs/door/yaw_disturb.py
@@ -0,0 +1,94 @@
+"""段 2 の途中で胴（pelvis）を鉛直軸のまわりに回す外乱（G1_Hackason 計画 docs/plan/2026-11-11-g1-door-stage2-fix.md の K2、
+パッチ 0104、2026-11-11）。
+
+11-11 の実機の段 2 は、手がレバーの上を内へ動く 1.4〜2.1 s に純正の脚の上で体が回り（IMU・/dog_odom・FAST-LIO が一致。
+4 回とも 1.5 s ごろに始まり 2.0 s で +10.6〜+24.7°）、手が把手の側へ 9〜14 cm ずれて空振りした。シムの立つ HOMIE は中央 2.8°。
+この回りをシムで起こして、外れ方が再現するか（K2）を見る。のちに学習の乱択（s2g）にも使う。
+
+回し方: 毎歩、物理の前に、その歩の終わりの目標の回り φ(t) とこれまでに足した回りの差 Δ だけ、root（pelvis）を世界の鉛直軸の
+まわりに回して書き込む。関節の角度はそのまま＝体ごと回る（足は床の上を滑る。高さと傾きは変わらない）。φ は t0 から dur かけて
+0 → amp を余弦でつなぐ。速さ・角速さのベクトルも Δ 回す（回る速さそのものは足さない）。
+向き: sign="lever_side" は把手の側へ（把手が左の扉 open_lr=+1 で +＝上から見て反時計回り。11-11 の実機の向き）、
+"away" は逆、"random" は回ごとに ±。
+
+env.config.yaw_disturb（無い・enabled=False なら元のまま）:
+  enabled: True で有効
+  amp_deg: 回りの大きさ [°]。[lo, hi] から回ごとに一様に引く（1 つの数は [v, v]）。既定 [20, 20]
+  start_s: 回し始める時刻 [s]（回の始めから）。既定 [1.4, 1.6]
+  dur_s: 回しきるまでの時間 [s]。既定 [0.5, 0.5]（実機は 0.5 s で 10〜25°）
+  sign: lever_side / away / random。既定 lever_side
+  prob: 外乱を入れる回の割合。既定 1.0
+
+ここは torch の関数だけ（Isaac Sim なしで試験できる）。環境（door_open_homie.py）が呼ぶ。
+"""
+
+from __future__ import annotations
+
+import math
+
+import torch
+
+DEFAULTS = {"amp_deg": (20.0, 20.0), "start_s": (1.4, 1.6), "dur_s": (0.5, 0.5)}
+SIGNS = ("lever_side", "away", "random")
+
+
+def _pair(v, name: str) -> tuple[float, float]:
+    if isinstance(v, (int, float)):
+        v = (v, v)
+    lo, hi = (float(x) for x in v)
+    assert lo <= hi, f"yaw_disturb.{name} は [小, 大]: {v}"
+    return lo, hi
+
+
+def yaw_disturb_config(cfg) -> dict | None:
+    """env.config.yaw_disturb を読んで確かめる。無い・enabled=False なら None"""
+    if cfg is None or not bool(cfg.get("enabled", False)):
+        return None
+    out = {k: _pair(cfg.get(k, d), k) for k, d in DEFAULTS.items()}
+    assert out["amp_deg"][0] >= 0.0, f"yaw_disturb.amp_deg は 0 以上（向きは sign で決める）: {out['amp_deg']}"
+    assert out["start_s"][0] >= 0.0, f"yaw_disturb.start_s は 0 以上: {out['start_s']}"
+    assert out["dur_s"][0] > 0.0, f"yaw_disturb.dur_s は正: {out['dur_s']}"
+    sign = str(cfg.get("sign", "lever_side"))
+    assert sign in SIGNS, f"yaw_disturb.sign は {SIGNS} のどれか: {sign}"
+    prob = float(cfg.get("prob", 1.0))
+    assert 0.0 <= prob <= 1.0, f"yaw_disturb.prob は 0〜1: {prob}"
+    return {**out, "sign": sign, "prob": prob}
+
+
+def sample_disturb(cfg: dict, open_lr: torch.Tensor, u: torch.Tensor):
+    """回ごとの外乱を引く。u は [n, 5] の 0〜1 の一様乱数（大きさ・始め・長さ・向き・入れるか）。
+    (向きつきの大きさ [rad]、始め [s]、長さ [s]) を返す（どれも [n]）。入れない回の大きさは 0"""
+
+    def lerp(pair, x):
+        return pair[0] + (pair[1] - pair[0]) * x
+
+    amp = torch.deg2rad(lerp(cfg["amp_deg"], u[:, 0]))
+    lever = torch.sign(open_lr).to(amp.dtype)
+    if cfg["sign"] == "lever_side":
+        sign = lever
+    elif cfg["sign"] == "away":
+        sign = -lever
+    else:
+        sign = torch.where(u[:, 3] < 0.5, torch.ones_like(amp), -torch.ones_like(amp))
+    on = (u[:, 4] < cfg["prob"]).to(amp.dtype)
+    return amp * sign * on, lerp(cfg["start_s"], u[:, 1]), lerp(cfg["dur_s"], u[:, 2])
+
+
+def ramp_offset(t: torch.Tensor, t0: torch.Tensor, dur: torch.Tensor, amp: torch.Tensor) -> torch.Tensor:
+    """時刻 t の目標の回り: t0 の前 0、t0+dur の後 amp、その間は余弦でつなぐ"""
+    x = torch.clamp((t - t0) / dur, 0.0, 1.0)
+    return amp * (0.5 - 0.5 * torch.cos(math.pi * x))
+
+
+def rotate_root_state_wxyz(state: torch.Tensor, delta: torch.Tensor) -> torch.Tensor:
+    """13 次元の root の状態 [pos, quat(wxyz), lin_vel, ang_vel]（[n, 13]）を、世界の鉛直軸のまわりに delta [rad]（[n]）回した新しいテンソル。
+    位置はそのまま（root のまわりに回す）、四元数は左から yaw を掛け、速さ・角速さのベクトルも回す"""
+    c, s = torch.cos(delta), torch.sin(delta)
+    ch, sh = torch.cos(delta / 2), torch.sin(delta / 2)
+    w, x, y, z = state[:, 3], state[:, 4], state[:, 5], state[:, 6]
+    quat = torch.stack([ch * w - sh * z, ch * x - sh * y, ch * y + sh * x, ch * z + sh * w], dim=-1)
+
+    def rot(v):
+        return torch.stack([c * v[:, 0] - s * v[:, 1], s * v[:, 0] + c * v[:, 1], v[:, 2]], dim=-1)
+
+    return torch.cat([state[:, 0:3], quat, rot(state[:, 7:10]), rot(state[:, 10:13])], dim=-1)
