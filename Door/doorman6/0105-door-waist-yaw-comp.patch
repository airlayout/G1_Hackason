diff --git a/gr00t/rl/envs/door/waist_yaw_comp.py b/gr00t/rl/envs/door/waist_yaw_comp.py
new file mode 100644
index 0000000..214130b
--- /dev/null
+++ b/gr00t/rl/envs/door/waist_yaw_comp.py
@@ -0,0 +1,63 @@
+"""腰 yaw で体（pelvis）の回りを打ち消す口（G1_Hackason 計画 docs/plan/2026-11-11-g1-door-stage2-fix.md の K3、パッチ 0105、2026-11-11）。
+
+11-11 の実機の段 2 は、手が下りる直前に純正の脚の上で体が +10〜29° 回り、手が把手の側へ 9〜14 cm ずれて空振りした。
+腰 yaw を回りと逆へ回せば、腕の付いている胴の向きは保てる（実機は arm_sdk が腰を持っているので、走らせ役が腰の目標に足せる）。
+シムでは: 毎歩、回の始めからの pelvis の回り Δ を読み（1 歩遅れ。実機の IMU と同じ扱い）、腰 yaw の目標に −倍率·Δ（上限で切る）を足す。
+  door_obs="torso": 方策に渡す扉の枠の位置と向きを、打ち消した胴の向きへ回して渡す（pelvis から見た扉は回って見えるので、そのまま
+    だと方策が腕でも直そうとして二重に直す）。"pelvis" は元のまま
+  hide_obs=True: 方策と HOMIE の観測の腰 yaw の角度・角速度から、打ち消しの分を引く（どちらも学習で見たことのない腰の角度を見ない）
+⚠️ シムの外乱（0104）は回りを外から決めて与えるので、腰を回す反作用で pelvis がさらに回る、という実機の効き方は出ない（上限の見積もり）
+
+env.config.waist_yaw_comp（無い・enabled=False なら元のまま）:
+  enabled: True で有効
+  gain: 倍率（既定 1.0）
+  max_deg: 打ち消しの上限 [°]（既定 35）
+  door_obs: torso / pelvis（既定 torso）
+  hide_obs: 既定 True
+
+ここは torch の関数だけ（Isaac Sim なしで試験できる）。環境（door_open_homie.py）と finger_primitive_base.py が呼ぶ。
+"""
+
+from __future__ import annotations
+
+import math
+
+import torch
+
+
+def waist_yaw_comp_config(cfg) -> dict | None:
+    """env.config.waist_yaw_comp を読んで確かめる。無い・enabled=False なら None"""
+    if cfg is None or not bool(cfg.get("enabled", False)):
+        return None
+    gain = float(cfg.get("gain", 1.0))
+    assert gain >= 0.0, f"waist_yaw_comp.gain は 0 以上: {gain}"
+    max_deg = float(cfg.get("max_deg", 35.0))
+    assert max_deg > 0.0, f"waist_yaw_comp.max_deg は正: {max_deg}"
+    door_obs = str(cfg.get("door_obs", "torso"))
+    assert door_obs in ("torso", "pelvis"), f"waist_yaw_comp.door_obs は torso か pelvis: {door_obs}"
+    return {"gain": gain, "max_rad": math.radians(max_deg), "door_obs": door_obs, "hide_obs": bool(cfg.get("hide_obs", True))}
+
+
+def wrap_angle(a: torch.Tensor) -> torch.Tensor:
+    return torch.atan2(torch.sin(a), torch.cos(a))
+
+
+def yaw_from_xyzw(q: torch.Tensor) -> torch.Tensor:
+    x, y, z, w = q.unbind(-1)
+    return torch.atan2(2 * (w * z + x * y), 1 - 2 * (y * y + z * z))
+
+
+def comp_offset(dyaw: torch.Tensor, gain: float, max_rad: float) -> torch.Tensor:
+    """腰 yaw の目標に足す打ち消し [rad] = −倍率 × 回り（±上限で切る）"""
+    return torch.clamp(-gain * dyaw, -max_rad, max_rad)
+
+
+def rotate_rel_yaw(rel_pos: torch.Tensor, rel_rot_xyzw: torch.Tensor, angle: torch.Tensor):
+    """機体から見た位置 [n, 3] と向き（xyzw）[n, 4] を、機体の鉛直軸のまわりに angle [rad]（[n]）回した新しいテンソル"""
+    c, s = torch.cos(angle), torch.sin(angle)
+    pos = torch.stack([c * rel_pos[:, 0] - s * rel_pos[:, 1], s * rel_pos[:, 0] + c * rel_pos[:, 1], rel_pos[:, 2]], dim=-1)
+    hz, hw = torch.sin(angle / 2), torch.cos(angle / 2)
+    x, y, z, w = rel_rot_xyzw.unbind(-1)
+    # q_z(angle) ⊗ q（xyzw）
+    rot = torch.stack([hw * x - hz * y, hw * y + hz * x, hw * z + hz * w, hw * w - hz * z], dim=-1)
+    return pos, rot
