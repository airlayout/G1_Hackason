+def occlude(x: torch.Tensor, d: torch.Tensor, prob: float, gen: torch.Generator) -> tuple[torch.Tensor, torch.Tensor]:
+    """写り込む物の真似。x: カラー [B, 3, H, W]（0〜1）・d: 深度 [B, H/2, W/2]（m）。prob の割合の台に四角を 1〜2 個貼る。
+    四角は縦 15〜50%・横 10〜40%。半分は画面の下半分に寄せる（腕と手は下から入る）。色は一様（半分）か雑音。
+    その台の半分は四角の所の深度を近い物（0.25〜0.7 m・1 cm の揺れ）にし、残りは深度をそのままにする（色だけ違う物）"""
+    if prob <= 0:
+        return x, d
+    b, _, h, w = x.shape
+    dh, dw = d.shape[1:]
+    dev = x.device
+    x, d = x.clone(), d.clone()
+
+    def u(lo, hi, *shape):
+        return torch.rand(*shape, device=dev, generator=gen) * (hi - lo) + lo
+
+    yy = torch.arange(h, device=dev)[None, :, None]
+    xx = torch.arange(w, device=dev)[None, None, :]
+    for k in range(2):
+        on = torch.rand(b, device=dev, generator=gen) < (prob if k == 0 else prob * 0.5)
+        bh, bw = u(0.15, 0.5, b) * h, u(0.10, 0.4, b) * w
+        low = torch.rand(b, device=dev, generator=gen) < 0.5
+        y0 = torch.where(low, h - bh * u(0.5, 1.0, b), u(0, 1, b) * (h - bh))
+        x0 = u(0, 1, b) * (w - bw)
+        m = on[:, None, None] & (yy >= y0[:, None, None]) & (yy < (y0 + bh)[:, None, None]) & (xx >= x0[:, None, None]) & (xx < (x0 + bw)[:, None, None])
+        flat = torch.rand(b, device=dev, generator=gen) < 0.5
+        col = torch.where(flat[:, None, None, None], u(0, 1, b, 3, 1, 1).expand(b, 3, h, w), u(0, 1, b, 3, h, w))
+        x = torch.where(m[:, None], col, x)
+        near = on & (torch.rand(b, device=dev, generator=gen) < 0.5)
+        md = m[:, ::h // dh, ::w // dw][:, :dh, :dw] & near[:, None, None]
+        dn = u(0.25, 0.7, b, 1, 1) + torch.randn(d.shape, device=dev, generator=gen) * 0.01
+        d = torch.where(md, dn, d)
+    return x, d
