diff --git a/gr00t/rl/isaac_utils/playground/env_rand/door.py b/gr00t/rl/isaac_utils/playground/env_rand/door.py
index eba662d..8953829 100644
--- a/gr00t/rl/isaac_utils/playground/env_rand/door.py
+++ b/gr00t/rl/isaac_utils/playground/env_rand/door.py
@@ -85,6 +85,7 @@ class DoorSpawnerCfg(sim_utils.RigidObjectSpawnerCfg):
     rand_spawn_hook: Optional[bool] = None
     rand_hinge_drive_max_force: Optional[float] = None
     rand_hinge_drive_stiffness: Optional[float] = None
+    rand_hinge_drive_target_deg: Optional[float] = None  # G1_Hackason: 蝶番のばねの目標角 [deg]（元は常に -10）
     rand_handle_drive_max_force: Optional[float] = None
     rand_front: Optional[bool] = None
     rand_rear: Optional[bool] = None
@@ -109,6 +110,11 @@ class DoorSpawnerCfg(sim_utils.RigidObjectSpawnerCfg):
     latch_throw_range: Optional[tuple[float, float]] = None
     # ラッチが引っ込みきるレバーの角度 [deg]。元は 45（＝回しきると外れる）。レバーの上限を超えない
     latch_release_angle_deg_range: Optional[tuple[float, float]] = None
+    # 閉じた位置での押し付け [N·m]。元は目標 -10° × ばね（1〜10 /deg）を力の上限で切った値で、閉じた位置でも上限まで押す。
+    # 上限を EN 1154 の等級まで強くすると、押し付けがラッチの斜面を押してレバーが勝手に回る（2026-10-07、等級 1 で
+    # 16 台中 12 台が 85〜99° まで回った。蝶番は閉位置を 0.003〜0.046° 越えていた）。指定すると目標角を -押し付け/ばね にし、
+    # 閉じた位置では元の扉と同じ程度に押し、開けるほど強くなって力の上限（等級）で頭打ちになる
+    hinge_closed_preload_range: Optional[tuple[float, float]] = None
 
 
 def _update_joint_transform(stage, joint_path, prim0_path, prim1_path):
@@ -538,6 +544,14 @@ def spawn_door(
         if cfg.rand_hinge_drive_stiffness is None
         else cfg.rand_hinge_drive_stiffness
     )
+    if cfg.rand_hinge_drive_target_deg is not None:
+        hinge_drive.GetTargetPositionAttr().Set(cfg.rand_hinge_drive_target_deg)
+    elif cfg.hinge_closed_preload_range is not None:
+        # 元の乱数の順（上限→ばね）を変えないよう、押し付けはばねの後に引く
+        hinge_drive.GetTargetPositionAttr().Set(
+            -float(np.random.uniform(*cfg.hinge_closed_preload_range))
+            / float(hinge_drive.GetStiffnessAttr().Get())
+        )
     _update_joint_transform(stage, hinge_joint_prim_path, root_prim_path, panel_prim_path)
 
     handle_joint_prim_path = os.path.join(panel_prim_path, "handle_joint")
@@ -1001,6 +1015,7 @@ def spawn_door(
         "spawnHook": spawn_hook,
         "hingeDriveMaxForce": hinge_drive.GetMaxForceAttr().Get(),
         "hingeDriveStiffness": hinge_drive.GetStiffnessAttr().Get(),
+        "hingeDriveTargetDeg": float(hinge_drive.GetTargetPositionAttr().Get()),
         "handleDriveMaxForce": handle_drive.GetMaxForceAttr().Get(),
         "handleCrossSection": str(handle_cross_section),
         "handleMaxAngleDeg": float(handle_max_angle_deg),
@@ -1151,6 +1166,7 @@ def get_deterministic_door_config(cfg: DoorSpawnerCfg, metadata: dict) -> DoorSp
     cfg.rand_spawn_hook = metadata["spawnHook"]
     cfg.rand_hinge_drive_max_force = metadata["hingeDriveMaxForce"]
     cfg.rand_hinge_drive_stiffness = metadata["hingeDriveStiffness"]
+    cfg.rand_hinge_drive_target_deg = metadata.get("hingeDriveTargetDeg", None)
     cfg.rand_handle_drive_max_force = metadata["handleDriveMaxForce"]
 
     if cfg.add_walls:
