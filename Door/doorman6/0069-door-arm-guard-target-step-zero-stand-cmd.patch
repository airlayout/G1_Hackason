+            self._guard_arm_accumulator(
+                float(guard_delta), float(self.config.get("arm_accum_guard_margin", 0.05))
+            )
 
         # Configration - 0
         # self._delta_actions[:, :3] *= 0.0
@@ -122,6 +135,25 @@ class DeltaActionBase(LeggedRobotBase):
             logger.warning(f"stage: {self.stage_buf}")
         return super().step(actor_state)
 
+    def _guard_arm_accumulator(self, delta: float, margin: float) -> None:
+        assert len(self._delta_action_indices) == ARM_ACCUM_START + NUM_ARM, (
+            "arm_accum_guard_delta は積み上げが [前後, 横, 旋回, 腕 14] の並びのときだけ使える"
+        )
+        lower = int(self.config.robot.lower_body_actions_dim)
+        dof = slice(lower, lower + NUM_ARM)
+        lim = self.simulator.hard_dof_pos_limits[dof]
+        arm = slice(ARM_ACCUM_START, ARM_ACCUM_START + NUM_ARM)
+        self._delta_actions[:, arm] = guard_arm_accumulator(
+            self._delta_actions[:, arm],
+            self.simulator.dof_pos[:, dof],
+            self.default_dof_pos[:, dof],
+            lim[:, 0],
+            lim[:, 1],
+            float(self.config.robot.control.action_scale),
+            delta,
+            margin,
+        )
+
     def _reward_penalty_delta_action_rate(self):
         return torch.sum(torch.square(self._last_delta_actions), dim=-1)
 
