             # 1 制御ステップ（4 回の物理の小ステップ）の間は同じ目標を使い、制御ステップが進んだときだけ前の目標から上限まで動かす。
             # どの台にかけるかは _arm_rate_limit_mask()（既定は全部。扉の環境は「手がレバーの近く」だけにできる）。既定 None＝かけない
@@ -137,6 +144,21 @@ class FingerPrimitiveBase(LeggedRobotBase):
                 f"Simulator {self.config.simulator.config.name} not implemented"
             )
 
+    def _limit_target_step(self, target: torch.Tensor, max_step: float) -> torch.Tensor:
+        """制御ステップが進んだ時（物理の小ステップの 1 回目）だけ、前の制御ステップに送った目標から ±max_step まで動かす。
+        回の最初の制御ステップ（リセットの直後、episode_length_buf == 0）は掛けない（前の回の目標から動かさない）"""
+        step = int(self.common_step_counter)
+        if getattr(self, "_tsl_step", None) != step:
+            prev = getattr(self, "_tsl_prev", None)
+            if prev is None:
+                new = target
+            else:
+                limited = limit_sent_target(target, prev, max_step=max_step)
+                new = torch.where((self.episode_length_buf > 0)[:, None], limited, target)
+            self._tsl_prev = new.clone()
+            self._tsl_step = step
+        return self._tsl_prev.clone()
+
     def _arm_rate_limit_mask(self) -> torch.Tensor:
         """腕の目標の変化に上限をかける台（[N] bool）。扉の環境で上書きする"""
         return torch.ones(self.num_envs, dtype=torch.bool, device=self.device)
