+++ b/gr00t/rl/isaac_utils/playground/env_rand/door_closer.py
@@ -0,0 +1,69 @@
+# G1_Hackason（段 2-4）: 実物の形のドアクローザー。
+#
+# PhysX の蝶番のドライブ（PD）では、DoorMan の扉は「動いている間はどの角度でも力の上限（等級の値）で一定」になる
+# （減衰 50 N·m·s/deg が大きく、少しでも動くと上限に張り付く）。実物のクローザーは閉じ際がいちばん強く、90° で
+# 1/3〜1/2 に落ち、開ける向きは効率（閉鎖 ÷ 開く向き、EN 1154 の最小 50〜65%）ぶん重い。70〜80° から先は
+# バックチェック（開ける向きの油圧の抵抗）が効く。PD ではこの形を作れないので、spawn_door（door.py）はドライブを切り、
+# env（door_open_homie.py）が物理ステップごとにこの力を蝶番に掛ける。
+#
+# 向き: 角度 theta・角速度 omega は開く向きが正 [rad]・[rad/s]。返す力も開く向きが正 [N·m]（閉じる力は負）。
+# 出典: EN 1154 の表とメーカーの実測曲線（docs/referrence/2026-10-11_ドア課題_強い扉と学習の崩れ_先行調査.html の 5 章）
+import math
+
+import torch
+
+# 開ける向きの摩擦（効率ぶんの重さ）を角速度でなだらかに立ち上げる幅 [rad/s]（約 3°/s）。
+# 静止摩擦は扱えないので、これより遅く押すと摩擦が小さい。ただしこの速さでは区間 4 の持ち時間（6 s）に 17° ほどしか
+# 進めないので「ゆっくり押せば軽い」抜け道にはならない。物理ステップ 200 Hz・最も軽い扉（15 kg・幅 0.8 m）でも陽解法で安定
+OPEN_FRICTION_RAMP_RAD_S = 0.05
+# 閉じた位置（0°）の押し付けから、0〜4° の閉鎖モーメント（等級の値）まで上げる角度 [rad]。
+# 閉じた位置で等級の力を掛けると、押し付けがラッチの円錐を押してレバーが勝手に回る（2026-10-07、0017）
+PRELOAD_RAMP_RAD = math.radians(2.0)
+RIGHT_ANGLE_RAD = math.pi / 2
+
+
+def closing_moment(theta, m0, ratio_90, preload):
+    """閉じる向きの力の大きさ [N·m]（0 以上）。
+
+    0°: preload（閉じた位置の押し付け）→ 2° までに m0 へ上げる → 90° で m0 × ratio_90 まで直線で下げる → その先は一定。
+    """
+    profile = m0 * (1.0 - (1.0 - ratio_90) * torch.clamp(theta / RIGHT_ANGLE_RAD, 0.0, 1.0))
+    ramp = torch.clamp(theta / PRELOAD_RAMP_RAD, 0.0, 1.0)
+    return preload + (profile - preload) * ramp
+
+
+def closer_torque(
+    theta,
+    omega,
+    *,
+    m0,
+    ratio_90,
+    efficiency,
+    preload,
+    close_damping,
+    backcheck_angle,
+    backcheck_damping,
+):
+    """蝶番に掛ける力 [N·m]（開く向きが正）。引数はすべて台ごとのテンソル（同じ形）。
+
+    - 止まっている: 閉鎖モーメントで閉じる向きに押す
+    - 開けている（omega > 0）: 閉鎖モーメント ÷ 効率 の抵抗（効率ぶんの摩擦）。backcheck_angle より先は減衰を足す
+    - 閉まっている（omega < 0）: 油圧の減衰 close_damping が閉まる速さを抑える
+    """
+    m_close = closing_moment(theta, m0, ratio_90, preload)
+    opening = torch.clamp(omega, min=0.0)
+    closing = torch.clamp(omega, max=0.0)
+    friction = m_close * (1.0 / efficiency - 1.0) * torch.clamp(opening / OPEN_FRICTION_RAMP_RAD_S, max=1.0)
+    backcheck = backcheck_damping * opening * (theta > backcheck_angle).to(theta.dtype)
+    return -m_close - friction - backcheck - close_damping * closing
+
+
+def close_damping_for(close_time, m0, ratio_90):
+    """90° から閉まるまでの時間が close_time [s] になる、閉じる向きの減衰 [N·m·s/rad]。
+
+    慣性を無視した釣り合い omega = −閉鎖モーメント / 減衰 を 0〜90° で積分した式（閉鎖モーメントは m0 から m0×ratio_90 へ直線）:
+    close_time = 減衰 × (π/2) × ln(1/ratio_90) / (m0 × (1 − ratio_90))
+    """
+    if not 0.0 < ratio_90 < 1.0:
+        raise ValueError(f"ratio_90 は 0 と 1 の間（90° の閉鎖モーメント ÷ 0〜4° の閉鎖モーメント）: {ratio_90}")
+    return close_time * m0 * (1.0 - ratio_90) / (RIGHT_ANGLE_RAD * math.log(1.0 / ratio_90))
