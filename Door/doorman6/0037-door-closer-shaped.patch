+    return torch.tensor([x], dtype=torch.float32)
+
+
+def torque(theta_deg, omega_rad_s, **overrides):
+    params = dict(
+        m0=t(M0),
+        ratio_90=t(RATIO_90),
+        efficiency=t(EFFICIENCY),
+        preload=t(PRELOAD),
+        close_damping=t(close_damping_for(CLOSE_TIME, M0, RATIO_90)),
+        backcheck_angle=t(BACKCHECK_DEG * DEG),
+        backcheck_damping=t(BACKCHECK_DAMPING),
+    )
+    params.update({k: t(v) for k, v in overrides.items()})
+    return closer_torque(t(theta_deg * DEG), t(omega_rad_s), **params).item()
+
+
+def moment(theta_deg):
+    return closing_moment(t(theta_deg * DEG), t(M0), t(RATIO_90), t(PRELOAD)).item()
+
+
+def test_closing_moment_near_closed_is_the_grade_value():
+    # EN 1154 の等級は 0〜4° の閉鎖モーメント。2〜4° で m0 の 95% 以上
+    for deg in (2.0, 3.0, 4.0):
+        assert 0.95 * M0 <= moment(deg) <= M0
+
+
+def test_closing_moment_at_closed_position_is_only_the_preload():
+    # 閉じた位置で等級の力を掛けるとラッチの斜面を押してレバーが勝手に回る（0017）。閉じた位置は押し付けだけ
+    assert moment(0.0) == pytest.approx(PRELOAD)
+    assert moment(-0.05) == pytest.approx(PRELOAD)  # 閉位置をわずかに越えた（めり込んだ）ときも同じ
+
+
+def test_closing_moment_falls_to_ratio_at_90_deg_and_stays():
+    assert moment(90.0) == pytest.approx(RATIO_90 * M0)
+    assert moment(120.0) == pytest.approx(RATIO_90 * M0)
+
+
+def test_closing_moment_decreases_with_angle_after_the_ramp():
+    values = [moment(d) for d in (2, 15, 30, 45, 60, 75, 90)]
+    assert all(a > b for a, b in zip(values, values[1:]))
+
+
+def test_static_door_is_pushed_closed_by_the_closing_moment():
+    assert torque(30.0, 0.0) == pytest.approx(-moment(30.0))
+
+
+def test_opening_is_heavier_by_the_efficiency():
+    # 開ける向きの抵抗＝閉鎖モーメント ÷ 効率（EN 1154 の開く向きの上限は 閉鎖の最大 ÷ 効率の最小）
+    omega = 2 * OPEN_FRICTION_RAMP_RAD_S
+    assert torque(30.0, omega) == pytest.approx(-moment(30.0) / EFFICIENCY, rel=1e-5)
+
+
+def test_slow_opening_has_less_friction_but_never_less_than_closing():
+    slow = torque(30.0, 0.5 * OPEN_FRICTION_RAMP_RAD_S)
+    assert -moment(30.0) / EFFICIENCY < slow < -moment(30.0)
+
+
+def test_closing_motion_is_damped():
+    # 閉じる向き（ω < 0）では油圧の減衰が閉まる速さを抑える（力は開く向き＝正の向きに足される）
+    omega = -0.3
+    damping = close_damping_for(CLOSE_TIME, M0, RATIO_90)
+    assert torque(45.0, omega) == pytest.approx(-moment(45.0) - damping * omega, rel=1e-5)
+
+
+def test_backcheck_only_beyond_its_angle_and_only_when_opening():
+    omega = 0.4
+    base_80 = -moment(80.0) / EFFICIENCY
+    assert torque(80.0, omega) == pytest.approx(base_80 - BACKCHECK_DAMPING * omega, rel=1e-5)
+    assert torque(60.0, omega) == pytest.approx(-moment(60.0) / EFFICIENCY, rel=1e-5)
+    damping = close_damping_for(CLOSE_TIME, M0, RATIO_90)
+    assert torque(80.0, -omega) == pytest.approx(-moment(80.0) + damping * omega, rel=1e-5)
+
+
+def test_close_damping_gives_the_requested_close_time_from_90_deg():
+    # 慣性を無視した釣り合い（ω = −閉鎖モーメント／減衰）で 90° → 0° を積分すると close_time になる
+    damping = close_damping_for(CLOSE_TIME, M0, RATIO_90)
+    thetas = torch.linspace(0.0, 90.0 * DEG, 20001)
+    m = closing_moment(thetas, t(M0), t(RATIO_90), t(M0))  # 押し付けの傾きを除いた形（preload=m0）
+    seconds = torch.trapezoid(damping / m, thetas).item()
+    assert seconds == pytest.approx(CLOSE_TIME, rel=1e-3)
+
+
+@pytest.mark.parametrize(
+    "grade_max, efficiency_min, en1154_opening_max",
+    [(13.0, 0.50, 26.0), (18.0, 0.50, 36.0), (26.0, 0.55, 47.0), (37.0, 0.60, 62.0)],
+)
+def test_strongest_door_of_a_grade_stays_within_en1154_opening_limit(
+    grade_max, efficiency_min, en1154_opening_max
+):
+    # 等級の最大の閉鎖モーメント・最小の効率で、0〜60° の開く向きの力が EN 1154 の上限に収まる（丸めの 2% まで）
+    omega = 2 * OPEN_FRICTION_RAMP_RAD_S
+    worst = max(
+        -torque(d, omega, m0=grade_max, efficiency=efficiency_min) for d in range(0, 61)
+    )
+    assert worst <= en1154_opening_max * 1.02
+
+
+def test_batched_inputs_keep_their_shape():
+    n = 5
+    theta = torch.linspace(0.0, 1.5, n)
+    omega = torch.linspace(-0.5, 0.5, n)
+    ones = torch.ones(n)
+    out = closer_torque(
+        theta,
+        omega,
+        m0=M0 * ones,
+        ratio_90=RATIO_90 * ones,
+        efficiency=EFFICIENCY * ones,
+        preload=PRELOAD * ones,
+        close_damping=10.0 * ones,
+        backcheck_angle=BACKCHECK_DEG * DEG * ones,
+        backcheck_damping=BACKCHECK_DAMPING * ones,
+    )
+    assert out.shape == (n,)
+    assert torch.isfinite(out).all()
+
+
+def test_close_damping_rejects_out_of_range_ratio():
+    with pytest.raises(ValueError):
+        close_damping_for(CLOSE_TIME, M0, 1.0)
+    with pytest.raises(ValueError):
+        close_damping_for(CLOSE_TIME, M0, 0.0)
