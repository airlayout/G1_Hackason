+# G1_Hackason（段 2-4 の学習用）: G1_Hackason/Door/tools/make_door_scenarios.py が door/scenario_cfg/isaacsim.py から生成した。
+# 手で直さず、生成し直すこと。EN 1154 等級 1〜3（台 i は i % 3 + 1）・実物の形のクローザー。開いたまま止まる角度は exp の door_hold_open_angle_deg。
+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+
+import logging
+
+logging.getLogger("asyncio").setLevel(logging.WARNING)
+
+import isaaclab.sim as sim_utils
+from isaaclab.actuators import ImplicitActuatorCfg
+from isaaclab.assets import ArticulationCfg
+
+from gr00t.rl.isaac_utils.playground.env_rand.door import DoorSpawnerCfg, spawn_door
+
+door_spawner_cfg = DoorSpawnerCfg(
+    func=spawn_door,
+    articulation_props=sim_utils.ArticulationRootPropertiesCfg(
+        enabled_self_collisions=True,
+        solver_position_iteration_count=4,
+        solver_velocity_iteration_count=4,
+        fix_root_link=True,
+    ),
+    activate_contact_sensors=True,
+    build_latch=True,
+    # UIS Room 4: 幅 0.94 m・レバー左・蝶番右・押して開ける・バックセット 64 mm・レバー 約 142 mm・ラッチの出 11.5 mm
+    door_width=(0.8, 1.1),
+    door_weight=(15.0, 100.0),
+    hinge_drive_max_force_range=(9.0, 13.0),  # EN 1154 等級 1 [N·m]（等級 2・3 は下の door_spawner_cfg_g2・_g3）
+    closer_shaped=True,  # 閉じ際が最大・90° で 1/3〜1/2・開ける向きは効率ぶん重い（env が毎物理ステップ力を掛ける）
+    closer_efficiency_range=(0.5, 0.65),  # EN 1154 等級 1 の最小〜+0.15
+    hinge_closed_preload_range=(2.5, 4.5),  # 閉じた位置での押し付け [N·m]（DoorMan の既定と同じ）
+    handle_drive_max_force_range=(0.5, 4.0),  # レバーを回す力 [N·m]（下限はレバーに掛け続ける 0.26 N·m より上）
+    handle_length_range=(0.10, 0.16),
+    handle_cross_section=["round", "square"],
+    handle_max_angle_deg_range=(30.0, 60.0),
+    latch_release_angle_deg_range=(30.0, 60.0),  # レバーの上限を超える分は上限で外れる
+    latch_throw_range=(0.008, 0.015),
+    add_floors=True,
+    door_open_lr=["left", "right"],
+    door_open_io=["out"],
+    door_handle_tblr=(1.10, 0.85, 0.03, 0.10),
+    randomize_material=True,
+    use_preloaded_materials=True,
+    preloaded_materials_num_transform=20,
+    preloaded_materials_num_color=100,
+    dynamic_material_randomization=False,
+    dynamic_material_randomization_interval=1.0,
+)
+
+door_spawner_cfg_g2 = door_spawner_cfg.replace(
+    hinge_drive_max_force_range=(13.0, 18.0),  # EN 1154 等級 2 [N·m]
+    closer_efficiency_range=(0.5, 0.65),
+)
+door_spawner_cfg_g3 = door_spawner_cfg.replace(
+    hinge_drive_max_force_range=(18.0, 26.0),  # EN 1154 等級 3 [N·m]
+    closer_efficiency_range=(0.55, 0.70),
+)
+
+multi_spawner_cfg = sim_utils.MultiAssetSpawnerCfg(
+    # 台 i に i 番目の扉（DoorMan の isaacsim.py が spawn_paths を env_i に明示する）。等級 1・2・3 を順に並べて 1/3 ずつ
+    assets_cfg=[door_spawner_cfg, door_spawner_cfg_g2, door_spawner_cfg_g3] * 1366,
+    random_choice=False,
+    activate_contact_sensors=True,
+    rigid_props=sim_utils.RigidBodyPropertiesCfg(
+        disable_gravity=False,
+        retain_accelerations=False,
+        linear_damping=0.0,
+        angular_damping=0.0,
+        max_linear_velocity=1000.0,
+        max_angular_velocity=1000.0,
+        max_depenetration_velocity=1.0,
+    ),
+)
+
+TaskObjCfgDict = {
