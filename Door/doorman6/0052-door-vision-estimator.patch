diff --git a/gr00t/rl/utils/vision_dataset.py b/gr00t/rl/utils/vision_dataset.py
new file mode 100644
index 0000000..e4edb72
--- /dev/null
+++ b/gr00t/rl/utils/vision_dataset.py
@@ -0,0 +1,81 @@
+# G1_Hackason（V2、2026-10-16）: 評価のループで、頭のカメラの灰色の画像と、扉の状態の正解を npz に書く（推定のモデルの学習用）。
+#
+# 使い方: ++algo.config.eval.vision_dataset_dir=<出力先> （任意で vision_dataset_every=5・vision_dataset_envs=16・vision_dataset_shard=2000）
+# カメラは simulator.config.cameras で有効にしておく。閉ループの評価（door_vision.estimator_path を渡したとき）では、
+# 推定した値（est）も一緒に書くので、推定の誤差を同じ記録で見られる。
+import os
+
+import numpy as np
+import torch
+
+from gr00t.rl.envs.door.door_vision import planar_pose_in_door, rgb_to_gray_u8
+from gr00t.rl.utils.state_recorder import _t
+
+
+def _np(x: torch.Tensor) -> np.ndarray:
+    return x.detach().cpu().numpy().copy()
+
+
+class VisionDataset:
+    def __init__(self, out_dir: str, every: int, num_envs: int, shard: int) -> None:
+        self.dir = str(out_dir)
+        os.makedirs(self.dir, exist_ok=True)
+        self.every = max(1, int(every))
+        self.k = int(num_envs)
+        self.shard = int(shard)
+        self.rows: dict[str, list] = {}
+        self.count = 0
+        self.n_shards = 0
+        self.n_samples = 0
+        self.episode = None  # 台ごとの回の番号
+
+    def maybe_record(self, env) -> None:
+        self.count += 1
+        k = min(self.k, env.num_envs)
+        ep_len = env.episode_length_buf[:k]
+        if self.episode is None:
+            self.episode = torch.zeros(k, dtype=torch.long, device=ep_len.device)
+            self._last_len = ep_len.clone()
+        self.episode += (ep_len < self._last_len).long()  # 回の長さが減った＝新しい回
+        self._last_len = ep_len.clone()
+        if self.count % self.every:
+            return
+        cam = getattr(env.simulator, "ego_camera", None)
+        if cam is None:
+            raise RuntimeError("vision_dataset: カメラが無い（simulator.config.cameras.enable_cameras=True にする）")
+        rgb = _t(env.simulator.scene.sensors["ego_camera"].data.output["rgb"])[:k]
+        root = env.simulator.robot_root_states[:k]
+        door = env.simulator.get_task_root_state("door")[:k]
+        door_dof = env.simulator.get_task_dof_pos("door")[:k]
+        pose = planar_pose_in_door(root[:, :3], root[:, 3:7], door[:, :3], door[:, 3:7])
+        row = {
+            "img": _np(rgb_to_gray_u8(rgb)),
+            "pose": _np(pose),
+            "angle": _np(door_dof[:, 0]),
+            "lever": _np(door_dof[:, 1]) if door_dof.shape[1] > 1 else np.zeros(k, np.float32),
+            "waist": _np(env.simulator.dof_pos[:k, 12:15]),
+            "gravity": _np(env.projected_gravity[:k]),
+            "stage": _np(env.stage_buf[:k]),
+            "ep_len": _np(ep_len),
+            "episode": _np(self.episode),
+            "env": np.arange(k),
+            "step": np.full(k, env.common_step_counter),
+        }
+        est = getattr(env, "_door_vision_est", None)
+        if est is not None:
+            row["est"] = _np(est[:k])
+        for key, v in row.items():
+            self.rows.setdefault(key, []).append(v)
+        self.n_samples += k
+        if len(self.rows["img"]) * k >= self.shard:
+            self.flush()
+
+    def flush(self) -> None:
+        if not self.rows:
+            return
+        out = {key: np.concatenate(v) for key, v in self.rows.items()}
+        path = os.path.join(self.dir, f"shard_{self.n_shards:04d}.npz")
+        np.savez_compressed(path, **out)
+        self.n_shards += 1
+        self.rows = {}
+        print(f"[G1_Hackason] vision dataset: {path}（{out['img'].shape[0]} 枚、累計 {self.n_samples}）", flush=True)
diff --git a/tests/test_door_vision.py b/tests/test_door_vision.py
new file mode 100644
index 0000000..f5b667e
--- /dev/null
+++ b/tests/test_door_vision.py
@@ -0,0 +1,74 @@
+# G1_Hackason（V2）: 推定した姿勢から扉の位置と向きを作り直す計算が、環境の relative_door_pos_buf と同じになるかを確かめる。torch だけ。
+import math
+
+import torch
+
+from gr00t.rl.envs.door.door_vision import (
+    door_rel_from_planar,
+    planar_pose_in_door,
+    quat_mul_xyzw,
+    quat_z,
+    rgb_to_gray_u8,
+    wrap,
+)
+from gr00t.rl.isaac_utils.isaaclab_math_wxyz import subtract_frame_transforms
+from gr00t.rl.isaac_utils.rotations import wxyz_to_xyzw, xyzw_to_wxyz
+
+
+def random_tilted_pose(n: int, g: torch.Generator):
+    """傾き（±15°）と向きと位置がばらばらの pelvis、向きのある扉"""
+    roll = (torch.rand(n, generator=g) - 0.5) * math.radians(30)
+    pitch = (torch.rand(n, generator=g) - 0.5) * math.radians(30)
+    yaw = (torch.rand(n, generator=g) - 0.5) * 2 * math.pi
+    qx = torch.stack([torch.sin(roll / 2), torch.zeros(n), torch.zeros(n), torch.cos(roll / 2)], -1)
+    qy = torch.stack([torch.zeros(n), torch.sin(pitch / 2), torch.zeros(n), torch.cos(pitch / 2)], -1)
+    root_q = quat_mul_xyzw(quat_z(yaw), quat_mul_xyzw(qy, qx))
+    root_p = torch.randn(n, 3, generator=g)
+    root_p[:, 2] = 0.75
+    door_yaw = (torch.rand(n, generator=g) - 0.5) * 2 * math.pi
+    door_q = quat_z(door_yaw)
+    door_p = torch.randn(n, 3, generator=g)
+    door_p[:, 2] = 0.0
+    return root_p, root_q, door_p, door_q
+
+
+def env_relative(root_p, root_q, door_p, door_q):
+    """door_open_homie.py の _pre_compute_observations_callback と同じ計算"""
+    door_p = door_p.clone()
+    door_p[:, 2] = root_p[:, 2]
+    pos, rot = subtract_frame_transforms(root_p, xyzw_to_wxyz(root_q), door_p, xyzw_to_wxyz(door_q))
+    return pos, wxyz_to_xyzw(rot)
+
+
+def same_rotation(a, b):
+    """四元数の符号の違いを無視して比べる"""
+    return torch.minimum((a - b).abs().amax(-1), (a + b).abs().amax(-1))
+
+
+def test_rel_from_true_planar_pose_matches_env():
+    g = torch.Generator().manual_seed(0)
+    root_p, root_q, door_p, door_q = random_tilted_pose(256, g)
+    pose = planar_pose_in_door(root_p, root_q, door_p, door_q)
+    pos, rot = door_rel_from_planar(pose, root_q, door_q)
+    want_pos, want_rot = env_relative(root_p, root_q, door_p, door_q)
+    assert (pos - want_pos).abs().max() < 1e-5
+    assert same_rotation(rot, want_rot).max() < 1e-5
+
+
+def test_yaw_error_rotates_door_direction_by_the_same_angle():
+    """推定の yaw が 5° ずれると、扉の +x 軸（tan）も pelvis の座標で 5° ずれる（傾きなしのとき）"""
+    n = 8
+    root_q = quat_z(torch.zeros(n))
+    pose = torch.tensor([[-1.0, 0.2, 0.0]]).repeat(n, 1)
+    pose_err = pose.clone()
+    pose_err[:, 2] += math.radians(5)
+    _, r0 = door_rel_from_planar(pose, root_q, quat_z(torch.zeros(n)))
+    _, r1 = door_rel_from_planar(pose_err, root_q, quat_z(torch.zeros(n)))
+    d = wrap(2 * torch.atan2(r1[:, 2], r1[:, 3]) - 2 * torch.atan2(r0[:, 2], r0[:, 3]))
+    assert torch.allclose(d, torch.full((n,), -math.radians(5)), atol=1e-6)
+
+
+def test_gray_conversion():
+    rgb = torch.tensor([[[[255, 0, 0], [0, 255, 0], [0, 0, 255], [255, 255, 255]]]], dtype=torch.uint8)
+    g = rgb_to_gray_u8(rgb)
