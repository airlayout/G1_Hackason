diff --git a/gr00t/rl/envs/door/door_vision.py b/gr00t/rl/envs/door/door_vision.py
new file mode 100644
index 0000000..f87a6c4
--- /dev/null
+++ b/gr00t/rl/envs/door/door_vision.py
@@ -0,0 +1,102 @@
+# G1_Hackason（V2、2026-10-16）: 頭のカメラの画像から扉の状態（扉の開いた角度・扉の座標での pelvis の床の上の姿勢）を推定し、
+# 状態入力の生徒に「LiDAR と測位の代わり」として渡す。torch だけ（Isaac Sim なしで試験できる）。
+#
+# 推定するもの（4 つ）: [x, y, yaw, angle]
+#   x, y, yaw  扉の座標（原点＝開口の中心の床・+x＝押して入る向き）での pelvis の位置と向き（実機の door_frame.py の PlanarPose と同じ）
+#   angle      扉の開いた角度 [rad]（閉じて 0、押し開けると正）
+# 推定のモデルに入れるもの: 灰色の画像（uint8 [N, H, W]）と、関節で分かる値 6 つ（腰の 3 関節の角度・pelvis で見た重力の向き）
+# 生徒に渡すときは、推定した x, y, yaw と pelvis の傾き（IMU。実機でも分かる）から door_frame_loc の向きと位置を作り直す。
+import math
+
+import torch
+
+PROPRIO_DIM = 6  # 腰 yaw・roll・pitch（SDK 12〜14）＋ projected_gravity 3
+TARGET_NAMES = ("x", "y", "yaw", "angle")
+
+
+def quat_mul_xyzw(a: torch.Tensor, b: torch.Tensor) -> torch.Tensor:
+    ax, ay, az, aw = a.unbind(-1)
+    bx, by, bz, bw = b.unbind(-1)
+    return torch.stack(
+        [
+            aw * bx + ax * bw + ay * bz - az * by,
+            aw * by - ax * bz + ay * bw + az * bx,
+            aw * bz + ax * by - ay * bx + az * bw,
+            aw * bw - ax * bx - ay * by - az * bz,
+        ],
+        dim=-1,
+    )
+
+
+def quat_conj_xyzw(q: torch.Tensor) -> torch.Tensor:
+    return torch.cat([-q[..., :3], q[..., 3:]], dim=-1)
+
+
+def quat_rotate_xyzw(q: torch.Tensor, v: torch.Tensor) -> torch.Tensor:
+    """q（xyzw）で v を回す"""
+    qv = torch.cat([v, torch.zeros_like(v[..., :1])], dim=-1)
+    return quat_mul_xyzw(quat_mul_xyzw(q, qv), quat_conj_xyzw(q))[..., :3]
+
+
+def yaw_of_xyzw(q: torch.Tensor) -> torch.Tensor:
+    x, y, z, w = q.unbind(-1)
+    return torch.atan2(2.0 * (w * z + x * y), 1.0 - 2.0 * (y * y + z * z))
+
+
+def quat_z(yaw: torch.Tensor) -> torch.Tensor:
+    zero = torch.zeros_like(yaw)
+    return torch.stack([zero, zero, torch.sin(yaw / 2), torch.cos(yaw / 2)], dim=-1)
+
+
+def wrap(a: torch.Tensor) -> torch.Tensor:
+    return torch.atan2(torch.sin(a), torch.cos(a))
+
+
+def planar_pose_in_door(root_pos, root_quat_xyzw, door_pos, door_quat_xyzw) -> torch.Tensor:
+    """扉の座標での pelvis の [x, y, yaw]（[N, 3]）。扉の root の向きは yaw だけとみなす"""
+    door_yaw = yaw_of_xyzw(door_quat_xyzw)
+    d = root_pos[:, :2] - door_pos[:, :2]
+    c, s = torch.cos(-door_yaw), torch.sin(-door_yaw)
+    x = c * d[:, 0] - s * d[:, 1]
+    y = s * d[:, 0] + c * d[:, 1]
+    yaw = wrap(yaw_of_xyzw(root_quat_xyzw) - door_yaw)
+    return torch.stack([x, y, yaw], dim=-1)
+
+
+def door_rel_from_planar(pose: torch.Tensor, root_quat_xyzw: torch.Tensor, door_quat_xyzw: torch.Tensor):
+    """推定した pelvis の床の上の姿勢と、本当の pelvis の傾き（IMU で分かる）から、pelvis の座標で見た扉の位置と向き。
+
+    door_open_homie.py の relative_door_pos_buf・relative_door_rot_buf と同じ定義（扉の点の高さは pelvis に合わせる）:
+      pos = R^T (p_door' − p_pelvis)、rot = R^T R_door。R は pelvis の向き（yaw は推定・傾きは本当の値）
+    """
+    door_yaw = yaw_of_xyzw(door_quat_xyzw)
+    q_rel_true = quat_mul_xyzw(quat_conj_xyzw(quat_z(door_yaw)), root_quat_xyzw)  # 扉の座標での pelvis の向き
+    tilt = quat_mul_xyzw(quat_conj_xyzw(quat_z(yaw_of_xyzw(q_rel_true))), q_rel_true)  # yaw を除いた傾き
+    q_est = quat_mul_xyzw(quat_z(pose[:, 2]), tilt)  # 扉の座標での pelvis の向き（推定）
+    offset = torch.stack([-pose[:, 0], -pose[:, 1], torch.zeros_like(pose[:, 0])], dim=-1)
+    pos = quat_rotate_xyzw(quat_conj_xyzw(q_est), offset)
+    rot = quat_conj_xyzw(q_est)  # 扉の座標で R_door は単位
+    return pos, rot
+
+
+def rgb_to_gray_u8(rgb: torch.Tensor) -> torch.Tensor:
+    """[N, H, W, 3 か 4] の uint8 か 0〜255 の float → [N, H, W] uint8（ITU-R BT.601）"""
+    x = rgb[..., :3].float()
+    g = 0.299 * x[..., 0] + 0.587 * x[..., 1] + 0.114 * x[..., 2]
+    return g.clamp(0, 255).round().to(torch.uint8)
+
+
+class DoorVisionEstimator:
+    """TorchScript の推定のモデル（door_vision_train.py が書く）を読み、画像と関節の値から [x, y, yaw, angle] を出す"""
+
+    def __init__(self, path: str, device) -> None:
+        self.model = torch.jit.load(path, map_location=device).eval()
+        self.device = device
+
+    @torch.no_grad()
+    def __call__(self, gray_u8: torch.Tensor, proprio: torch.Tensor) -> torch.Tensor:
+        return self.model(gray_u8.to(self.device), proprio.to(self.device).float())
+
+
+def angle_deg(x: torch.Tensor) -> torch.Tensor:
+    return x * (180.0 / math.pi)
