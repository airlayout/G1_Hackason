@@ -46,6 +46,7 @@ from gr00t.rl.envs.door.reset_from_dataset import ResetFromDataset
 from gr00t.rl.envs.door.walk_away import walk_away_amount
 from gr00t.rl.envs.door.waist_yaw_comp import comp_offset, rotate_rel_yaw, waist_yaw_comp_config, wrap_angle, yaw_from_xyzw
 from gr00t.rl.envs.door.wall_gap import arm_points, gap_cost, gap_to_walls, lagrange_step, to_door_frame, wall_gap_config
