+# G1_Hackason: BehaviorScript（USD の prim に付ける Python のスクリプト）の基底クラスを、Kit の版によらず返す。
+#
+# Kit 110（Isaac Sim 6.0）で拡張 omni.kit.scripting は omni.behavior.scripting.core に改名された（中身の API と
+# prim の属性 omni:scripting:scripts は同じ）。無い拡張を有効にしようとすると、レジストリを見に行って固まる
+# （registryEnabled=false でも。10-07 実測）ので、手元にある方だけを有効にする。
+
+_CANDIDATES = ("omni.kit.scripting", "omni.behavior.scripting.core")  # 5.1 の名前を先に
+
+
+def get_behavior_script_base():
+    """拡張を有効にしてから BehaviorScript を返す。SimulationApp の起動後に呼ぶこと。"""
+    import importlib
+
+    import omni.kit.app
+
+    manager = omni.kit.app.get_app().get_extension_manager()
+    local = {ext["name"] for ext in manager.get_extensions()}
+    for name in _CANDIDATES:
+        if name not in local:
+            continue
+        if not manager.is_extension_enabled(name):
+            manager.set_extension_enabled_immediate(name, True)
+        return importlib.import_module(name).BehaviorScript
+    raise RuntimeError(f"BehaviorScript の拡張が見つからない（探した名前: {_CANDIDATES}）")
