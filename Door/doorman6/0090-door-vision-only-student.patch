--- /dev/null
+++ b/gr00t/rl/scripts/door_vision_pretrain.py
@@ -0,0 +1,226 @@
+# G1_Hackason（11-04、画像だけの生徒 V2）: collect_vis_1104.sh で集めた画像と答えから、画像の網（DoorVisionEncoder）と扉の頭
+# （DoorHead）を学ぶ。シミュレータを使わない（GPU だけ）。学習に無い扉（記録の束ごとに台の 1 割）で外れを測る。
+#
+# 使い方: python door_vision_pretrain.py --data <束1>/frames <束2>/frames ... --out <出力.pt> [--epochs 8] [--batch 256]
+# 出力: {"encoder": 画像の網, "head": 扉の頭（out_mean・out_std 込み）, "metrics": 外れの表}
+# 外れの表: 項目ごとの平均の絶対誤差（角度は度・長さは cm）を、全体と段階ごと（区間 0〜5）に出す
+from __future__ import annotations
+
+import argparse
+import glob
+import json
+import math
+import os
+import time
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from gr00t.rl.envs.door.door_vision_feat import (
+    DOOR_TRUTH_DIM,
+    DOOR_TRUTH_NAMES,
+    DOOR_TRUTH_TOL,
+    DoorHead,
+    DoorVisionEncoder,
+)
+
+
+def load_frames(dirs: list[str]) -> dict[str, np.ndarray]:
+    """束（frames/）ごとの shard_*.npz を読み、扉の番号（束の番号 × 100000 ＋ 台の番号）を付けて 1 つにする。
+    画像は大きい（10 万枚で約 6 GB）ので、先に枚数を数えて 1 つの配列を用意し、束を 1 つずつ書き込む（つなぐと RAM が 2 倍要る）"""
+    files = [(bi, f) for bi, d in enumerate(dirs) for f in sorted(glob.glob(os.path.join(d, "shard_*.npz")))]
+    counts = []
+    for _, f in files:
+        with np.load(f) as z:
+            counts.append(len(z["env_id"]))
+    n = int(sum(counts))
+    out: dict[str, np.ndarray] = {}
+    i = 0
+    for (bi, f), c in zip(files, counts):
+        with np.load(f) as z:
+            for k in z.files:
+                a = z[k]
+                if k not in out:
+                    out[k] = np.empty((n,) + a.shape[1:], dtype=a.dtype)
+                out[k][i : i + c] = a
+        out.setdefault("door_id", np.empty(n, dtype=np.int64))[i : i + c] = bi * 100000 + out["env_id"][i : i + c].astype(np.int64)
+        i += c
+    for d in dirs:
+        print(f"[pretrain] {d}: {sum(1 for bi, f in files if f.startswith(d))} 束", flush=True)
+    return out
+
+
+def split_by_door(door_id: np.ndarray, val_frac: float, seed: int) -> tuple[np.ndarray, np.ndarray]:
+    doors = np.unique(door_id)
+    rng = np.random.default_rng(seed)
+    val_doors = rng.choice(doors, size=max(1, int(round(len(doors) * val_frac))), replace=False)
+    is_val = np.isin(door_id, val_doors)
+    return np.nonzero(~is_val)[0], np.nonzero(is_val)[0]
+
+
+def augment(x: torch.Tensor, gen: torch.Generator) -> torch.Tensor:
+    """x: [B, 3, H, W]（0〜1）。明るさ・コントラスト・彩度・白の釣り合い・ぼけ・雑音・まれに白黒。形（幾何）は変えない
+    （画像の中の位置が扉の位置の手掛かりなので、ずらし・切り抜きはしない）"""
+    b = x.shape[0]
+    dev = x.device
+
+    def u(lo, hi, *shape):
+        return torch.rand(*shape, device=dev, generator=gen) * (hi - lo) + lo
+
+    x = x * u(0.6, 1.5, b, 1, 1, 1)
+    mean = x.mean(dim=(1, 2, 3), keepdim=True)
+    x = (x - mean) * u(0.6, 1.4, b, 1, 1, 1) + mean
+    gray = x.mean(dim=1, keepdim=True)
+    x = (x - gray) * u(0.5, 1.5, b, 1, 1, 1) + gray
+    x = x * u(0.85, 1.15, b, 3, 1, 1)
+    blur = torch.rand(b, device=dev, generator=gen) < 0.3
+    if blur.any():
+        k = torch.tensor([1.0, 2.0, 1.0], device=dev)
+        k = (k[:, None] * k[None, :]) / 16.0
+        xb = F.conv2d(x[blur].reshape(-1, 1, *x.shape[2:]), k[None, None], padding=1).reshape(-1, 3, *x.shape[2:])
+        x = x.clone()
+        x[blur] = xb
+    x = x + torch.randn(x.shape, device=dev, generator=gen) * u(0.0, 0.04, b, 1, 1, 1)
+    g = torch.rand(b, device=dev, generator=gen) < 0.05
+    if g.any():
+        x[g] = x[g].mean(dim=1, keepdim=True).expand(-1, 3, -1, -1)
+    return x.clamp(0.0, 1.0)
+
+
+def aux_noise(aux: torch.Tensor, gen: torch.Generator) -> torch.Tensor:
+    """手掛かり [頭の重力 3, 胴の重力 3, 腰 3] に、学習の観測と同じくらいの揺れ（頭の重力は片寄りも）を足す"""
+    n = torch.randn(aux.shape, device=aux.device, generator=gen)
+    out = aux.clone()
+    hg = aux[:, :3] + n[:, :3] * 0.02 + torch.randn(aux.shape[0], 3, device=aux.device, generator=gen) * 0.015
+    out[:, :3] = hg / hg.norm(dim=-1, keepdim=True).clamp_min(1e-6)
+    out[:, 6:9] = aux[:, 6:9] + n[:, 6:9] * 0.01
+    return out
+
+
+def evaluate(enc, head, data, idx, device, tol, batch=512) -> dict:
+    enc.eval()
+    head.eval()
+    errs, stages = [], []
+    with torch.no_grad(), torch.autocast(device.type, dtype=torch.bfloat16, enabled=device.type == "cuda"):
+        for i in range(0, len(idx), batch):
+            j = idx[i : i + batch]
+            rgb = torch.from_numpy(data["rgb"][j]).to(device)
+            aux = torch.from_numpy(data["aux"][j]).float().to(device)
+            y = torch.from_numpy(data["truth"][j]).float().to(device)
+            pred = head(enc(rgb).float(), aux).float()
+            errs.append((pred - y).abs().cpu())
+            stages.append(torch.from_numpy(data["stage"][j]))
+    err = torch.cat(errs)
+    stage = torch.cat(stages).long()
+    unit = torch.tensor([180.0 / math.pi] + [100.0] * 3 + [1.0] * 6 + [100.0] * 4 + [1.0] * 3)  # 度・cm・そのまま
+    res = {"all": dict(zip(DOOR_TRUTH_NAMES, (err.mean(0) * unit).tolist())), "n": int(len(idx))}
+    for s in range(6):
+        m = stage == s
+        if m.sum() > 0:
+            res[f"stage{s}"] = dict(zip(DOOR_TRUTH_NAMES, (err[m].mean(0) * unit).tolist()))
+            res[f"stage{s}"]["n"] = int(m.sum())
+    res["loss_tol"] = float(((err / tol.cpu()) ** 2).mean())
+    return res
+
+
+def fmt(res: dict) -> str:
+    a = res["all"]
+    return (f"角度 {a['angle']:.2f}° 位置 {a['pos_x']:.1f}/{a['pos_y']:.1f}/{a['pos_z']:.1f} cm 向き {a['rot6d_0']:.3f} "
+            f"幅 {a['width']:.1f} 高さ {a['height']:.1f} レバー高 {a['handle_height']:.1f} バックセット {a['backset']:.1f} cm "
+            f"(n={res['n']}, 損失 {res['loss_tol']:.2f})")
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--data", nargs="+", required=True)
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--epochs", type=int, default=8)
+    ap.add_argument("--batch", type=int, default=256)
+    ap.add_argument("--lr", type=float, default=3e-4)
+    ap.add_argument("--val_frac", type=float, default=0.1)
+    ap.add_argument("--feat_dim", type=int, default=128)
+    ap.add_argument("--init", default=None, help="続きから学ぶ重み（この台本の出力）")
+    ap.add_argument("--seed", type=int, default=0)
+    ap.add_argument("--device", default="cuda")
+    ap.add_argument("--eval_batch", type=int, default=512)
+    ap.add_argument("--max_steps", type=int, default=0, help="1 エポックの歩数の上限（試しの確かめ用。0 は全部）")
+    args = ap.parse_args()
+
+    device = torch.device(args.device)
+    t0 = time.time()
+    data = load_frames(args.data)
+    n = len(data["truth"])
+    tr, va = split_by_door(data["door_id"], args.val_frac, args.seed)
+    print(f"[pretrain] 画像 {n} 枚・扉 {len(np.unique(data['door_id']))} 枚（学習 {len(tr)}・確かめ {len(va)}）・"
+          f"読み込み {time.time() - t0:.0f} 秒", flush=True)
+
+    enc = DoorVisionEncoder(args.feat_dim, pretrained=args.init is None).to(device)
+    head = DoorHead(args.feat_dim).to(device)
+    y_tr = torch.from_numpy(data["truth"][tr]).float()
+    head.out_mean.copy_(y_tr.mean(0))
+    head.out_std.copy_(y_tr.std(0).clamp_min(1e-3))
+    if args.init:
+        ck = torch.load(args.init, map_location="cpu", weights_only=False)
+        enc.load_state_dict(ck["encoder"])
+        head.load_state_dict(ck["head"])
+        print(f"[pretrain] 続きから: {args.init}", flush=True)
+    tol = torch.tensor(DOOR_TRUTH_TOL, device=device)
+    params = [{"params": enc.parameters(), "lr": args.lr}, {"params": head.parameters(), "lr": args.lr}]
+    opt = torch.optim.AdamW(params, weight_decay=1e-4)
+    steps_per_epoch = max(1, len(tr) // args.batch)
+    if args.max_steps:
+        steps_per_epoch = min(steps_per_epoch, args.max_steps)
+    total = steps_per_epoch * args.epochs
+    sched = torch.optim.lr_scheduler.OneCycleLR(opt, max_lr=args.lr, total_steps=total, pct_start=0.05)
+    gen = torch.Generator(device=device)
+    gen.manual_seed(args.seed)
+    rng = np.random.default_rng(args.seed)
+    best = None
+    history = []
+    for ep in range(args.epochs):
+        enc.train()
+        head.train()
+        perm = rng.permutation(tr)
+        t1 = time.time()
+        run = 0.0
+        for s in range(steps_per_epoch):
+            j = np.sort(perm[s * args.batch : (s + 1) * args.batch])
+            rgb = torch.from_numpy(data["rgb"][j]).to(device, non_blocking=True)
+            aux = torch.from_numpy(data["aux"][j]).float().to(device)
+            y = torch.from_numpy(data["truth"][j]).float().to(device)
+            x = augment(rgb[..., :3].permute(0, 3, 1, 2).float() / 255.0, gen)
+            x = (x - enc.img_mean) / enc.img_std
+            with torch.autocast(device.type, dtype=torch.bfloat16, enabled=device.type == "cuda"):
+                feat = enc.forward_normalized(x)
+                pred = head(feat.float(), aux_noise(aux, gen))
+            loss = (((pred.float() - y) / tol) ** 2).mean()
+            opt.zero_grad(set_to_none=True)
+            loss.backward()
+            torch.nn.utils.clip_grad_norm_(list(enc.parameters()) + list(head.parameters()), 1.0)
+            opt.step()
+            sched.step()
+            run += loss.item()
+            if (s + 1) % 200 == 0 or args.max_steps:
+                print(f"[pretrain] ep {ep} {s + 1}/{steps_per_epoch} 損失 {run / (1 if args.max_steps else 200):.3f} "
+                      f"({(s + 1) * args.batch / (time.time() - t1):.0f} 枚/秒)", flush=True)
+                run = 0.0
+        res = evaluate(enc, head, data, va, device, tol, args.eval_batch)
+        res_tr = evaluate(enc, head, data, tr[:: max(1, len(tr) // 4000)], device, tol, args.eval_batch)
+        history.append({"epoch": ep, "val": res, "train_sub": res_tr})
+        print(f"[pretrain] ep {ep} 確かめ（学習に無い扉）: {fmt(res)}", flush=True)
+        print(f"[pretrain] ep {ep} 学習の扉（一部）    : {fmt(res_tr)}", flush=True)
+        if best is None or res["loss_tol"] < best:
+            best = res["loss_tol"]
+            torch.save({"encoder": enc.state_dict(), "head": head.state_dict(), "metrics": res,
+                        "args": vars(args), "epoch": ep}, args.out)
+            print(f"[pretrain] 保存 {args.out}（ep {ep}）", flush=True)
+    with open(os.path.splitext(args.out)[0] + "_history.json", "w") as f:
+        json.dump(history, f, indent=1, ensure_ascii=False)
+    print(f"[pretrain] 終わり {time.time() - t0:.0f} 秒", flush=True)
+
+
+assert DOOR_TRUTH_DIM == len(DOOR_TRUTH_NAMES)
+
+if __name__ == "__main__":
+    main()
