diff --git a/tests_g1/test_vision_door_student.py b/tests_g1/test_vision_door_student.py
new file mode 100644
--- /dev/null
+++ b/tests_g1/test_vision_door_student.py
@@ -0,0 +1,139 @@
+# G1_Hackason（11-04）: 画像だけの生徒（vision_door_student.VisionDoorStudent）の確かめ。Isaac Sim なしで動く。
+#   1. 扉の頭が「本当の扉の値」を出せば、生徒の行動は f3sc（教師）の行動と一致する（LSTM の足した入力の重みは 0 から）
+#   2. 教師の並び（teacher_obs）の組み立てが、扉の 3 項目の位置に当てた値を差し込み、ほかは生徒の観測から取る
+#   3. 学習の段（[軌跡, 長さ, d]＋masks）と 1 歩ずつの回しが同じ行動を出す
+# 使い方（OMEN）: cd VIRAL6_vis && PYTHONPATH=. python -m pytest -q tests_g1/test_vision_door_student.py
+#   教師の重みは F3SC（既定 ~/work_inoue/doorman/ckpt/start_1103_0807/last.pt）。無ければ飛ばす
+import os
+
+import pytest
+import torch
+import yaml
+from omegaconf import OmegaConf
+
+F3SC = os.environ.get("F3SC", os.path.expanduser("~/work_inoue/doorman/ckpt/start_1103_0807/last.pt"))
+OBS_YAML = "gr00t/rl/config/obs/wbmanip/door_open_homie_29dof_vision_f3.yaml"
+pytestmark = pytest.mark.skipif(not os.path.exists(F3SC), reason="f3sc の重みが無い")
+
+
+def _env_config():
+    obs = yaml.safe_load(open(OBS_YAML))["obs"]
+    dims = {}
+    for d in obs["obs_dims"]:
+        (k, v), = d.items()
+        if isinstance(v, str):
+            v = {"${robot.dof_obs_size}": 29, "${robot.actions_dim}": 29}.get(v, None)
+            if v is None:
+                continue
+        dims[k] = v
+    dims["delta_actions"] = 17
+    algo = {}
+    for g in ("actor_obs", "teacher_obs"):
+        algo[g] = sum(dims[t] for t in obs["obs_dict"][g])
+    return OmegaConf.create({
+        "obs": {"obs_dims": dims, "obs_dict": {g: obs["obs_dict"][g] for g in ("actor_obs", "teacher_obs")}},
+        "robot": {"algo_obs_dim_dict": algo, "actions_dim": 29},
+    })
+
+
+def _student():
+    from gr00t.rl.trl.modules.vision_door_student import VisionDoorStudent
+
+    env_config = _env_config()
+    algo_config = OmegaConf.create({"init_noise_std": 0.001, "freeze_noise_std": True, "clamp_noise_std": True,
+                                    "max_noise_std": 0.001})
+    backbone = OmegaConf.create({"mlp_module": {
+        "_target_": "gr00t.rl.agents.modules.modules.BaseModule", "process_output_dim": True,
+        "module_config_dict": {"input_dim": ["actor_obs"], "output_dim": [17],
+                               "layer_config": {"type": "MLP", "hidden_dims": [512, 256, 128], "activation": "SiLU"}}}})
+    return VisionDoorStudent(env_config, algo_config, backbone, rnn_num_layers=2, init_from=F3SC), env_config
+
+
+def _teacher_step(sd, t_obs, hc):
+    """f3sc の 1 歩（正規化 → LSTM 2 層 → MLP SiLU）を重みから直接計算する"""
+    x = torch.clamp((t_obs - sd["running_mean_std.running_mean"]) / torch.sqrt(sd["running_mean_std.running_var"] + 1e-5), -5, 5)
+    lstm = torch.nn.LSTM(x.shape[-1], 256, 2)
+    lstm.load_state_dict({k[len("memory.rnn."):]: v for k, v in sd.items() if k.startswith("memory.rnn.")})
+    out, hc = lstm(x[None], hc)
+    h = out[0]
+    for i in (0, 2, 4):
+        h = torch.nn.functional.silu(h @ sd[f"actor_module.module.{i}.weight"].T + sd[f"actor_module.module.{i}.bias"])
+    return h @ sd["actor_module.module.6.weight"].T + sd["actor_module.module.6.bias"], hc
+
+
+def _make_obs(stu, env_config, n, gen):
+    """生徒の観測と、同じ体の感覚と扉の値から作った教師の観測を返す"""
+    from gr00t.rl.trl.modules.vision_door_student import _term_slices
+
+    dims = env_config.obs.obs_dims
+    s = _term_slices(dims, list(env_config.obs.obs_dict["actor_obs"]))
+    t = _term_slices(dims, list(env_config.obs.obs_dict["teacher_obs"]))
+    s_obs = torch.randn(n, stu.student_dim, generator=gen) * 0.3
+    door17 = torch.randn(n, 17, generator=gen) * 0.3
+    t_obs = torch.zeros(n, stu.teacher_dim)
+    for name, (a, b) in t.items():
+        if name == "door_angle_lidar":
+            t_obs[:, a:b] = torch.stack([door17[:, 0], torch.ones(n), torch.full((n,), stu.angle_age)], dim=1)
+        elif name == "door_frame_loc":
+            t_obs[:, a:b] = door17[:, 1:10]
+        elif name == "door_geometry":
+            t_obs[:, a:b] = door17[:, 10:17]
+        else:
+            t_obs[:, a:b] = s_obs[:, s[name][0]:s[name][1]]
+    return s_obs, t_obs, door17
+
+
+def test_student_matches_teacher_when_door_values_are_true():
+    stu, env_config = _student()
+    stu.eval()
+    sd = torch.load(F3SC, map_location="cpu", weights_only=False)["policy_state_dict"]
+    gen = torch.Generator().manual_seed(0)
+    n = 8
+    hc = None
+    for step in range(5):
+        s_obs, t_obs, door17 = _make_obs(stu, env_config, n, gen)
+        stu.door_values = lambda obs, d=door17: d  # 扉の頭の代わりに本当の値を出す
+        with torch.no_grad():
+            a_s, _ = stu._rollout_mean({"actor_obs": s_obs})
+            a_t, hc = _teacher_step(sd, t_obs, hc)
+        assert torch.allclose(a_s, a_t, atol=1e-4), (step, (a_s - a_t).abs().max())
+
+
+def test_batch_forward_matches_rollout():
+    stu, env_config = _student()
+    stu.eval()
+    gen = torch.Generator().manual_seed(1)
