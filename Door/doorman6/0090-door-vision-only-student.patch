+# @package _global_
+# G1_Hackason（11-04、画像だけの生徒）: 頭のカラーの画像だけで扉の値を読む生徒の DAgger（教師 f3sc 27 回目）の観測。
+# f3sc の観測（door_open_homie_29dof_state_ppo.yaml）からの違い:
+#   actor_obs（生徒）: f3sc の actor_obs から扉の 3 項目（door_angle_lidar・door_frame_loc・door_geometry）を外し、
+#     vis_feat（頭のカラーの特徴 128。環境の中の固めた画像の網が 10 Hz で作る）と vis_head_gravity（頭から見た重力 3）を足した
+#   teacher_obs: f3sc の actor_obs そのまま（並び・倍率・雑音も同じ。教師の重みに合わせる）
+#   gt_obj_pos: door_truth（扉の本当の値 17。生徒の扉の頭の補助の答え。door_vision_feat.DOOR_TRUTH_NAMES）
+#   critic_obs・homie_obs: f3sc と同じ（V4 の PPO で f3sc の評価係をそのまま使う）
+# 生徒の網（vision_door_student.py）は項目名の辞書順の並びから位置を数えるので、項目の名前を変えるときは網も確かめる
+
+# Be careful when using _raw, history
+obs:
+  obs_dict:
+    actor_obs: [
+      base_ang_vel,
+      projected_gravity,
+      dof_pos,
+      dof_vel,
+      actions,
+      delta_actions,
+
+      b_homie_commands,
+      complete,
+
+      arm_dof_torque,
+      vis_feat,
+      vis_head_gravity
+    ]
+
+    teacher_obs: [
+      base_ang_vel,
+      projected_gravity,
+      dof_pos,
+      dof_vel,
+      actions,
+      delta_actions,
+
+      b_homie_commands,
+      complete,
+
+      door_angle_lidar,
+      door_frame_loc,
+      door_geometry,
+      arm_dof_torque
+    ]
+
+    gt_obj_pos: [
+      door_truth,
+    ]
+
+    critic_obs: [
+      dof_pos,
+      relative_to_door,
+      dof_vel,
+      actions,
+      projected_gravity,
+      door_dof_pos,
+      base_lin_vel,
+      base_ang_vel,
+      hand_force,
+      stage,
+      privileged_door_info,
+      delta_actions,
+      hand_handle_transform,
+      unwarped_actions,
+
+      transition,
+      complete,
+
+      time_in_stage,
+      actual_time_in_stage,
+      total_time,
+
+      b_homie_commands
+    ]
+
+    homie_obs: [
+      a_history_homie,
+      b_homie_commands,
+      c_homie_base_ang_vel,
+      d_homie_projected_gravity,
+      # homie_torso_ang_vel,
+      # homie_torso_projected_gravity,
+      e_homie_dof_pos,
+      f_homie_dof_vel,
+      g_homie_body_actions,
+      # homie_clock_inputs,
+    ]
+
+  # define those coumpounds in obs_dict, for example, you can define different long/short history with different length
+  obs_auxiliary: 
+    history_long: {
+      dof_pos: 20,
+      relative_to_door: 20,
+      dof_vel: 2,
+      actions: 15,
+      projected_gravity: 15,
+      door_dof_pos: 15,
+      base_lin_vel: 15,
+      base_ang_vel: 15,
+      hand_force: 15,
+      stage: 15,
+      privileged_door_info: 15,
+      delta_actions: 15,
+      hand_handle_transform: 15,
+
+      transition: 15,
+      complete: 15,
+
+      time_in_stage: 15,
+      actual_time_in_stage: 15,
+    }
+
+    a_history_homie: {
+      b_homie_commands: 5,
+      c_homie_base_ang_vel: 5,
+      d_homie_projected_gravity: 5,
+      # homie_torso_ang_vel: 5,
+      # homie_torso_projected_gravity: 5,
+      e_homie_dof_pos: 5,
+      f_homie_dof_vel: 5,
+      g_homie_body_actions: 5,
+      # homie_clock_inputs: 5,
+    }
+
+    history_short: {
+      dof_pos: 3,
+      relative_to_door: 3,
+      dof_vel: 2,
+      actions: 1,
+      projected_gravity: 1,
+      door_dof_pos: 2,
+      base_lin_vel: 2,
+      base_ang_vel: 2,
+      hand_force: 2,
+      stage: 2,
