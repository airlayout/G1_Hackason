new file mode 100644
--- /dev/null
+++ b/gr00t/rl/envs/door/door_vision_feat.py
@@ -0,0 +1,181 @@
+# G1_Hackason（11-04、画像だけで扉を開ける生徒）: 画像の側の部品。torch と torchvision だけで動く（Isaac Sim なしで試験できる）。
+#
+# 生徒の作り（計画書 docs/plan/2026-11-04-g1-door-vision-rl.md の 3 章）:
+#   画像の網（DoorVisionEncoder）は環境の側に置いて固める。頭のカラーを 10 Hz（制御 5 歩に 1 回）で描き、特徴 128 個を作って
+#   間の 4 歩は同じ特徴を持ち回す。学習係には特徴だけが流れる（画像を溜めない）
+#   扉の頭（DoorHead）は生徒の側に置く。特徴＋頭と胴の重力の向き＋腰の角度から、扉の値 17 個（DOOR_TRUTH の並び）を当てる
+#   生徒は当てた値を f3sc（状態入力の方策）の扉の値 19 個の位置に差し込み、f3sc の LSTM と MLP をそのまま使う
+#
+# 扉の値の並び（door_truth、17 個。どれも鏡写しの後＝方策が見る向き）:
+#   [扉の開いた角度 rad, 枠の位置 xyz m（pelvis の座標）, 枠の向き tan・norm 6 個, 幅・高さ・レバーの高さ・バックセット m, lr, 1 − lr, io]
+from __future__ import annotations
+
+import math
+import os
+import time
+
+import numpy as np
+import torch
+import torch.nn as nn
+
+DOOR_TRUTH_DIM = 17
+AUX_IN_DIM = 9  # 頭の重力 3・胴の重力 3（projected_gravity）・腰の角度 3（yaw・roll・pitch）
+# 損失の重み＝1 / 許す誤差²。角度 2°・位置 3 cm・向き 0.03・長さ 2 cm・向きの札 0.1
+DOOR_TRUTH_TOL = [math.radians(2.0)] + [0.03] * 3 + [0.03] * 6 + [0.02] * 4 + [0.1] * 3
+DOOR_TRUTH_NAMES = (
+    ["angle", "pos_x", "pos_y", "pos_z"]
+    + [f"rot6d_{i}" for i in range(6)]
+    + ["width", "height", "handle_height", "backset", "lr", "one_minus_lr", "io"]
+)
+IMAGENET_MEAN = (0.485, 0.456, 0.406)
+IMAGENET_STD = (0.229, 0.224, 0.225)
+
+
+class DoorVisionEncoder(nn.Module):
+    """uint8 の RGB 画像 [N, H, W, 3] → 特徴 [N, feat_dim]。ResNet18（ImageNet で学習済み）の平均プーリングの後に線形＋LayerNorm"""
+
+    def __init__(self, feat_dim: int = 128, pretrained: bool = True):
+        super().__init__()
+        import torchvision
+
+        weights = torchvision.models.ResNet18_Weights.IMAGENET1K_V1 if pretrained else None
+        r = torchvision.models.resnet18(weights=weights)
+        self.trunk = nn.Sequential(*list(r.children())[:-1])  # → [N, 512, 1, 1]
+        self.proj = nn.Linear(512, feat_dim)
+        self.norm = nn.LayerNorm(feat_dim)
+        self.feat_dim = feat_dim
+        self.register_buffer("img_mean", torch.tensor(IMAGENET_MEAN).view(1, 3, 1, 1))
+        self.register_buffer("img_std", torch.tensor(IMAGENET_STD).view(1, 3, 1, 1))
+
+    def preprocess(self, rgb_u8: torch.Tensor) -> torch.Tensor:
+        x = rgb_u8[..., :3].permute(0, 3, 1, 2).float() / 255.0
+        return (x - self.img_mean) / self.img_std
+
+    def forward_normalized(self, x: torch.Tensor) -> torch.Tensor:
+        return self.norm(self.proj(self.trunk(x).flatten(1)))
+
+    def forward(self, rgb_u8: torch.Tensor) -> torch.Tensor:
+        return self.forward_normalized(self.preprocess(rgb_u8))
+
+
+class DoorHead(nn.Module):
+    """特徴 [.., feat_dim] と手掛かり [.., AUX_IN_DIM] → 扉の値 [.., 17]（物理の単位）。
+    網は正規化した値を出し、out_mean・out_std（学習用の記録から求めた値）で物理の単位に戻す"""
+
+    def __init__(self, feat_dim: int = 128, hidden: tuple[int, ...] = (256, 128)):
+        super().__init__()
+        layers: list[nn.Module] = []
+        d = feat_dim + AUX_IN_DIM
+        for h in hidden:
+            layers += [nn.Linear(d, h), nn.SiLU()]
+            d = h
+        layers.append(nn.Linear(d, DOOR_TRUTH_DIM))
+        self.net = nn.Sequential(*layers)
+        self.register_buffer("out_mean", torch.zeros(DOOR_TRUTH_DIM))
+        self.register_buffer("out_std", torch.ones(DOOR_TRUTH_DIM))
+
+    def forward_normalized(self, feat: torch.Tensor, aux: torch.Tensor) -> torch.Tensor:
+        return self.net(torch.cat([feat, aux], dim=-1))
+
+    def forward(self, feat: torch.Tensor, aux: torch.Tensor) -> torch.Tensor:
+        return self.forward_normalized(feat, aux) * self.out_std + self.out_mean
+
+
+def door_truth_weight(device=None) -> torch.Tensor:
+    """扉の値の損失の重み（1 / 許す誤差²）"""
+    tol = torch.tensor(DOOR_TRUTH_TOL, dtype=torch.float32, device=device)
+    return 1.0 / tol**2
+
+
+def quat_mul_xyzw(a: torch.Tensor, b: torch.Tensor) -> torch.Tensor:
+    ax, ay, az, aw = a.unbind(-1)
+    bx, by, bz, bw = b.unbind(-1)
+    return torch.stack(
+        [
+            aw * bx + ax * bw + ay * bz - az * by,
+            aw * by - ax * bz + ay * bw + az * bx,
+            aw * bz + ax * by - ay * bx + az * bw,
+            aw * bw - ax * bx - ay * by - az * bz,
+        ],
+        dim=-1,
+    )
+
+
+def quat_rotate_inverse_xyzw(q: torch.Tensor, v: torch.Tensor) -> torch.Tensor:
+    """q（xyzw）の逆回転で v を回す（世界の向き → q の座標）"""
+    xyz, w = q[..., :3], q[..., 3:4]
+    t = 2.0 * torch.cross(xyz, v, dim=-1)
+    return v - w * t + torch.cross(xyz, t, dim=-1)
+
+
+def head_gravity(torso_quat_xyzw: torch.Tensor, pitch_rad: torch.Tensor) -> torch.Tensor:
+    """頭（カメラの体の座標。前 +x・上 +z。torso_link の y 軸まわりに pitch_rad 下を向く）から見た重力の向き [N, 3]"""
+    half = 0.5 * pitch_rad
+    zero = torch.zeros_like(half)
+    q_pitch = torch.stack([zero, torch.sin(half), zero, torch.cos(half)], dim=-1)
+    q_head = quat_mul_xyzw(torso_quat_xyzw, q_pitch)
+    g = torch.zeros_like(q_head[..., :3])
+    g[..., 2] = -1.0
+    return quat_rotate_inverse_xyzw(q_head, g)
+
+
+def load_encoder(path: str | None, feat_dim: int, device) -> DoorVisionEncoder:
+    """学習済みの画像の網を読む（path が無ければ ImageNet のままの網。速さを測る・記録を集めるとき）"""
+    enc = DoorVisionEncoder(feat_dim=feat_dim, pretrained=path is None)
+    if path:
+        sd = torch.load(path, map_location="cpu", weights_only=False)
+        sd = sd.get("encoder", sd)
+        enc.load_state_dict(sd)
+        print(f"[G1_Hackason] 画像の網を読んだ: {path}")
+    enc.to(device).eval()
+    for p in enc.parameters():
+        p.requires_grad = False
+    return enc
+
+
+class VisionDumper:
+    """V2 の学習用の記録。画像（uint8）・手掛かり・扉の値・段階などを shard_XXXXX.npz に溜めて書く。
+    1 回に全部の台でなく keep_frac の割合の台だけ残す（同じ扉の似た画像ばかりにしない）"""
+
+    def __init__(self, out_dir: str, shard_size: int = 2048, keep_frac: float = 0.25, max_frames: int = 0, seed: int = 0):
+        self.out_dir = out_dir
+        os.makedirs(out_dir, exist_ok=True)
+        self.shard_size = int(shard_size)
+        self.keep_frac = float(keep_frac)
+        self.max_frames = int(max_frames)
+        self.gen = torch.Generator()
+        self.gen.manual_seed(int(seed))
+        self.buf: dict[str, list[np.ndarray]] = {}
+        self.n_buf = 0
+        self.n_written = 0
+        self.shard_idx = len([f for f in os.listdir(out_dir) if f.startswith("shard_")])
+        self.t0 = time.time()
+
+    @property
+    def full(self) -> bool:
+        return self.max_frames > 0 and self.n_written + self.n_buf >= self.max_frames
+
+    def add(self, items: dict[str, torch.Tensor]) -> None:
+        if self.full:
+            return
+        n = next(iter(items.values())).shape[0]
+        keep = (torch.rand(n, generator=self.gen) < self.keep_frac).nonzero(as_tuple=False).flatten()
+        if len(keep) == 0:
+            return
+        for k, v in items.items():
+            self.buf.setdefault(k, []).append(v.detach()[keep.to(v.device)].cpu().numpy())
+        self.n_buf += len(keep)
+        if self.n_buf >= self.shard_size:
+            self.flush()
+
+    def flush(self) -> None:
+        if self.n_buf == 0:
+            return
+        arrs = {k: np.concatenate(v, axis=0) for k, v in self.buf.items()}
+        path = os.path.join(self.out_dir, f"shard_{self.shard_idx:05d}.npz")
+        np.savez(path, **arrs)
+        self.shard_idx += 1
+        self.n_written += self.n_buf
+        print(f"[G1_Hackason] 記録 {path}（{self.n_buf} 枚・計 {self.n_written} 枚・{time.time() - self.t0:.0f} 秒）", flush=True)
+        self.buf = {}
+        self.n_buf = 0
