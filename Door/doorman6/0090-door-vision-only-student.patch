new file mode 100644
--- /dev/null
+++ b/gr00t/rl/trl/modules/vision_door_student.py
@@ -0,0 +1,223 @@
+# G1_Hackason（11-04、画像だけで扉を開ける生徒）: f3sc（状態入力の方策・扉の値 19 個を入力）の LSTM と MLP をそのまま使い、
+# 扉の値 19 個だけを「頭のカラーの特徴から当てた値」に差し替える生徒。
+#
+#   生徒の actor_obs（項目名の辞書順）: f3sc の項目から扉の 3 項目を除いたもの（体の感覚）＋ vis_feat（画像の特徴）＋ vis_head_gravity
+#   扉の頭（DoorHead）: 特徴＋[頭の重力・胴の重力・腰の角度] → 扉の値 17 個（door_vision_feat.DOOR_TRUTH_NAMES）
+#   扉の値 19 個 = door_angle_lidar [角度, 測れた 1.0, 古さ angle_age] ＋ door_frame_loc 9 ＋ door_geometry 7
+#   f3sc の入力（teacher_obs と同じ並び・151 個）に組み直し、f3sc の正規化（固定）を掛け、[特徴・頭の重力] を足して LSTM へ。
+#   LSTM の足した入力の重みは 0 から始める＝始めは「扉の値が当たっていれば f3sc と同じ」動き
+#
+# 学習係（distill_trainer_obj_pred_homie_api）からは StateRecurrentActorObjPred と同じに見える。obj_pred は扉の頭の 17 個で、
+# 損失の重み obj_pred_weight（1 / 許す誤差²）は学習係が読む（distill_trainer_obj_pred.py）
+# V4（PPO で磨く、ppo_mode=True）: PPO の学習係（ppo_trainer_homie_api）は、学習の段の出力を回の区切りで詰めた並びから
+# 台×歩の並びに戻して使う（RecurrentActor と同じ）。freeze_door_head=True で扉の頭を固める（補助の答えの損失が無いので、
+# 当てた値の意味を保つ）
+from __future__ import annotations
+
+import torch
+import torch.nn as nn
+from hydra.utils import instantiate
+from torch.distributions import Normal
+
+from gr00t.rl.envs.door.door_vision_feat import AUX_IN_DIM, DOOR_TRUTH_DIM, DoorHead, door_truth_weight
+from gr00t.rl.trl.modules.memory import Memory
+from gr00t.rl.trl.modules.state_actor_obj_pred_recurrent import StateRecurrentActorObjPred
+
+DOOR_TERMS = {"door_angle_lidar": 3, "door_frame_loc": 9, "door_geometry": 7}
+
+
+def _term_slices(obs_dims, terms) -> dict[str, tuple[int, int]]:
+    """観測の組（項目の並び）の中で、各項目が占める位置。組は項目名の辞書順に並ぶ（legged_robot_base._post_config_observation_callback）"""
+    out, i = {}, 0
+    for t in sorted(terms):
+        t = t[:-4] if t.endswith("_raw") else t
+        d = int(obs_dims[t])
+        out[t] = (i, i + d)
+        i += d
+    return out
+
+
+class VisionDoorStudent(StateRecurrentActorObjPred):
+    is_recurrent = True
+
+    def __init__(
+        self,
+        env_config,
+        algo_config,
+        backbone,
+        module_dim_dict={},
+        running_mean_std=False,
+        max_rollout_history=1,
+        input_key="actor_obs",
+        rnn_type="lstm",
+        rnn_hidden_dim=256,
+        rnn_num_layers=2,
+        teacher_key="teacher_obs",
+        feat_key="vis_feat",
+        head_gravity_key="vis_head_gravity",
+        angle_age=0.15,
+        init_from=None,
+        door_head_path=None,
+        door_head_hidden=(256, 128),
+        ppo_mode=False,
+        freeze_door_head=False,
+    ):
+        nn.Module.__init__(self)
+        self.input_key = input_key
+        self.max_rollout_history = max_rollout_history
+        obs = env_config.obs
+        dims = obs.obs_dims
+        s = _term_slices(dims, list(obs.obs_dict[input_key]))
+        t = _term_slices(dims, list(obs.obs_dict[teacher_key]))
+        self.student_dim = env_config.robot.algo_obs_dim_dict[input_key]
+        self.teacher_dim = env_config.robot.algo_obs_dim_dict[teacher_key]
+        assert set(DOOR_TERMS) <= set(t), f"教師の観測に扉の 3 項目が無い: {sorted(t)}"
+        assert not (set(DOOR_TERMS) & set(s)), "生徒の観測に扉の項目が入っている"
+        # 教師の並びの各項目を、生徒の観測（"s"）か当てた扉の値（"d"）のどこから取るか
+        door_off = {"door_angle_lidar": 0, "door_frame_loc": 3, "door_geometry": 12}
+        self._assemble = []
+        for name, (a, b) in sorted(t.items(), key=lambda kv: kv[1][0]):
+            if name in DOOR_TERMS:
+                o = door_off[name]
+                self._assemble.append(("d", o, o + (b - a)))
+            else:
+                assert name in s, f"教師の項目 {name} が生徒の観測に無い"
+                assert s[name][1] - s[name][0] == b - a
+                self._assemble.append(("s", *s[name]))
+        self.feat_slice = s[feat_key]
+        self.hg_slice = s[head_gravity_key]
+        self.pg_slice = s["projected_gravity"]
+        self.waist_slice = (s["dof_pos"][0] + 12, s["dof_pos"][0] + 15)
+        feat_dim = self.feat_slice[1] - self.feat_slice[0]
+        self.extra_dim = feat_dim + 3
+        self.angle_age = float(angle_age)
+
+        self.memory = Memory(
+            input_size=self.teacher_dim + self.extra_dim, type=rnn_type, num_layers=rnn_num_layers, hidden_size=rnn_hidden_dim
+        )
+        module_dim_dict_recurrent = dict(module_dim_dict)
+        module_dim_dict_recurrent[self.input_key] = rnn_hidden_dim
+        module_dim_dict_recurrent["rnn_hidden_dim"] = rnn_hidden_dim
+        self.mlp_module = instantiate(
+            backbone.mlp_module,
+            env_config=env_config,
+            algo_config=algo_config,
+            obs_dim_dict={self.input_key: rnn_hidden_dim},
+            module_dim_dict=module_dim_dict_recurrent,
+            _recursive_=False,
+        )
+        self.door_head = DoorHead(feat_dim, tuple(door_head_hidden))
+        self.obj_pred_mlp = self.door_head  # 学習係・to_cpu が名前で探すので同じ物を指す
+        # f3sc の観測の正規化（固定。学習で動かさない）
+        self.register_buffer("t_mean", torch.zeros(self.teacher_dim))
+        self.register_buffer("t_var", torch.ones(self.teacher_dim))
+        self.register_buffer("obj_pred_weight", door_truth_weight())
+        self.running_mean_std = None
+
+        self.num_actions = self.mlp_module.output_dim
+        self.std = nn.Parameter(algo_config.init_noise_std * torch.ones(self.num_actions))
+        if algo_config.get("freeze_noise_std", False):
+            self.std.requires_grad = False
+        self.clamp_noise_std = algo_config.get("clamp_noise_std", False)
+        if self.clamp_noise_std:
+            self.max_noise_std = algo_config.get("max_noise_std", 1.0)
+        self.distribution = None
+        Normal.set_default_validate_args(False)
+        self.obs_dict_buffer = {}
+        self.dones_buffer = None
+        self.steps = 0
+        self.is_eval_mode = False
+
+        if init_from:
+            self._init_from_teacher(init_from)
+        if door_head_path:
+            sd = torch.load(door_head_path, map_location="cpu", weights_only=False)
+            self.door_head.load_state_dict(sd.get("head", sd))
+            print(f"[G1_Hackason] 扉の頭を読んだ: {door_head_path}")
+        self.ppo_mode = bool(ppo_mode)
+        if freeze_door_head:
+            for p in self.door_head.parameters():
+                p.requires_grad = False
+        print(f"VisionDoorStudent: 生徒 {self.student_dim} → 教師の並び {self.teacher_dim}＋足す {self.extra_dim}・"
+              f"組み立て {self._assemble}・特徴 {self.feat_slice}・頭の重力 {self.hg_slice}")
+
+    @torch.no_grad()
+    def _init_from_teacher(self, path: str) -> None:
+        """f3sc の重み（PPO の last.pt の policy_state_dict）を写す。LSTM の 1 層目の足した入力の列は 0"""
+        ck = torch.load(path, map_location="cpu", weights_only=False)
+        sd = ck.get("policy_state_dict", ck)
+        self.t_mean.copy_(sd["running_mean_std.running_mean"])
+        self.t_var.copy_(sd["running_mean_std.running_var"])
+        rnn = self.memory.rnn
+        for name, p in rnn.named_parameters():
+            src = sd[f"memory.rnn.{name}"]
+            if name == "weight_ih_l0":
+                p.zero_()
+                p[:, : src.shape[1]] = src
+            else:
+                p.copy_(src)
+        mlp = {k[len("actor_module."):]: v for k, v in sd.items() if k.startswith("actor_module.")}
+        self.mlp_module.load_state_dict(mlp)
+        print(f"[G1_Hackason] 生徒の LSTM・MLP・正規化を教師から写した: {path}")
+
+    def door_values(self, obs: torch.Tensor) -> torch.Tensor:
+        """生徒の観測 [..., d] → 当てた扉の値 [..., 17]"""
+        feat = obs[..., self.feat_slice[0] : self.feat_slice[1]]
+        aux = torch.cat(
+            [
+                obs[..., self.hg_slice[0] : self.hg_slice[1]],
+                obs[..., self.pg_slice[0] : self.pg_slice[1]],
+                obs[..., self.waist_slice[0] : self.waist_slice[1]],
+            ],
+            dim=-1,
+        )
+        return self.door_head(feat, aux)
+
+    def _lstm_input(self, obs: torch.Tensor, door17: torch.Tensor) -> torch.Tensor:
+        ones = torch.ones_like(door17[..., :1])
+        door19 = torch.cat([door17[..., :1], ones, ones * self.angle_age, door17[..., 1:]], dim=-1)
+        parts = [obs[..., a:b] if src == "s" else door19[..., a:b] for src, a, b in self._assemble]
+        t = torch.cat(parts, dim=-1)
+        t = torch.clamp((t - self.t_mean) / torch.sqrt(self.t_var + 1e-5), -5.0, 5.0)
+        extra = torch.cat(
+            [obs[..., self.feat_slice[0] : self.feat_slice[1]], obs[..., self.hg_slice[0] : self.hg_slice[1]]], dim=-1
+        )
+        return torch.cat([t, extra], dim=-1)
+
+    def forward(self, obs_dict, masks=None, hidden_states=None, episode_attnmask=None, **kwargs):
+        obs = obs_dict[self.input_key]
+        door17 = self.door_values(obs)
+        x = self._lstm_input(obs, door17)
+        if x.dim() == 2:
+            memory_out = self._memory_step(x)
+        else:
+            memory_out = self.memory(x.transpose(0, 1), masks=masks, hidden_states=hidden_states)
+        return {"actions": self.mlp_module(memory_out), "obj_pred": door17}
+
+    def update_distribution(self, obs_dict, episode_attnmask=None, last_step_only=False, masks=None,
+                            hidden_states=None, original_dones=None, **kwargs):
+        mean = self.forward(obs_dict, masks=masks, hidden_states=hidden_states,
+                            episode_attnmask=episode_attnmask)["actions"]
+        if self.ppo_mode and masks is not None and original_dones is not None:
+            from gr00t.rl.trl.utils.rl import unsplit_trajectories
+
+            mean = unsplit_trajectories(mean, masks, original_dones)
+        if last_step_only:
+            mean = mean[:, -1]
+        self._set_distribution(mean)
+
+    def _rollout_mean(self, obs_dict, episode_attnmask=None, cur_dones=None):
+        self._update_obs_buffer(obs_dict, episode_attnmask, cur_dones)
+        obs = obs_dict[self.input_key]
+        door17 = self.door_values(obs)
+        memory_out = self._memory_step(self._lstm_input(obs, door17))
+        self.steps += 1
+        return self.mlp_module(memory_out), door17
+
+    def to_cpu(self):
+        super().to_cpu()
+        for b in ("t_mean", "t_var", "obj_pred_weight"):
+            setattr(self, b, getattr(self, b).to("cpu"))
+
+
+assert DOOR_TRUTH_DIM == 17 and AUX_IN_DIM == 9
