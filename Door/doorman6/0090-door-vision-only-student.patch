+"""G1_Hackason（11-04、画像だけの生徒 V4）: DAgger で作った画像だけの生徒を PPO で磨く出発の重みを組み立てる
+（make_state_ppo_ckpt.py と同じ考え）。
+
+  actor  = 生徒（VisionDoorStudent）の重みそのまま。std だけ f3sc が最後に学んだ値 × --std-scale（探索の揺らぎ）
+  critic = f3sc の評価係（critic_obs は f3sc と同じなので、そのまま使える）
+  env の状態（打ち切りの線など）と学習の状態は f3sc のものを使う。最適化の状態は入れない（学習率は exp の値で始まる）
+
+使い方（OMEN の ~/work_inoue/doorman6/VIRAL6_vis で）:
+  python gr00t/rl/scripts/make_vis_ppo_ckpt.py <生徒の last.pt> <f3sc の last.pt> <出力の .pt> [--std-scale 0.5]
+出力の隣に生徒の config.yaml を写さない（PPO の exp で起動して ++checkpoint で渡す）
+"""
+
+import argparse
+
+import torch
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("student")
+    ap.add_argument("teacher")
+    ap.add_argument("out")
+    ap.add_argument("--std-scale", type=float, default=0.5)
+    args = ap.parse_args()
+
+    student = torch.load(args.student, map_location="cpu", weights_only=False)
+    teacher = torch.load(args.teacher, map_location="cpu", weights_only=False)
+    sp = student["policy_state_dict"]
+    assert "door_head.net.0.weight" in sp, "画像だけの生徒の重みではない"
+    policy = {k: v.clone() for k, v in sp.items()}
+    policy["std"] = teacher["policy_state_dict"]["std"].clone() * args.std_scale
+    out = {
+        "policy_state_dict": policy,
+        "value_state_dict": teacher["value_state_dict"],
+        "optimizer_state_dict": None,
+        "lr_scheduler_state_dict": None,
+        "state": teacher["state"],
+        "env_state_dict": teacher.get("env_state_dict", {}),
+    }
+    torch.save(out, args.out)
+    print(f"書いた: {args.out}（actor＝{args.student} の反復 {student['state'].global_step}、critic・env＝f3sc、"
+          f"std＝f3sc × {args.std_scale}: {[round(v, 3) for v in policy['std'][:5].tolist()]}…）")
+
+
+if __name__ == "__main__":
+    main()
