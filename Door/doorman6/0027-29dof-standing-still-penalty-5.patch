From 3031e591d2b1804634aba988d99ccd17e44c932b Mon Sep 17 00:00:00 2001
From: g1 <g1@local>
Date: Thu, 8 Oct 2026 04:03:33 +0900
Subject: [PATCH] 29dof: penalty_standing_still -1 -> -5 (walk after the door
 opens)

---
 gr00t/rl/config/exp/wbmanip/door_open_homie_29dof_lstm.yaml | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/gr00t/rl/config/exp/wbmanip/door_open_homie_29dof_lstm.yaml b/gr00t/rl/config/exp/wbmanip/door_open_homie_29dof_lstm.yaml
index dda24cf..4d92977 100644
--- a/gr00t/rl/config/exp/wbmanip/door_open_homie_29dof_lstm.yaml
+++ b/gr00t/rl/config/exp/wbmanip/door_open_homie_29dof_lstm.yaml
@@ -122,6 +122,9 @@ rewards:
     press_door_handle_down: 1.0  # 4.0 で押し下げを見つけた後、押し付けるだけで満点になる行き止まりになったので 1.0 に（10-07 22:05）
     # G1_Hackason 段 2-2: レバーが 30° 以上下がっている間（ラッチが縁まで引っ込んだ後）に前へ押す力（0〜1、20 N で頭打ち）。区間 3 だけ
     push_door_unlatched: 6.0
+    # G1_Hackason 段 2-2: 区間 4（扉が 10° 開いた後）で止まっている罰を -1 → -5。区間 1〜3 の「動くと罰」（-15）の癖で、
+    # 扉 約 20° のまま歩かなかった（10-08 03:59 の評価、区間 4 で前へ 6 mm）
+    penalty_standing_still: -5.0
 
 env:
   config:
