+                prim_path="/World/envs/env_.*/Robot/(" + "|".join(self.arm_body_contact_names) + ")",
+                filter_prim_paths_expr=["/World/envs/env_.*/Robot/" + n for n in others],
+                history_length=int(self.simulator_config.sim.control_decimation),
+                update_period=0.0,
+            )
+            self.arm_body_contact_sensor = ContactSensor(arm_body_contact_config)
+            self.scene.sensors["arm_body_contact_sensor"] = self.arm_body_contact_sensor
         if hasattr(self.simulator_config, "heightmap"):
             if self.simulator_config.heightmap.enable_heightmap:
                 self._height_scanner = RayCaster(height_scanner_config)
@@ -2184,6 +2264,18 @@ class IsaacSim(BaseSimulator):
                         print(f"Error accessing shader at {valid_shader_path}: {str(e)}")
                         continue
 
+    @property
+    def applied_dof_torque(self):
+        """G1_Hackason（直し 3）: PhysX の中の PD の力の見積もり（力の上限で切った値）[N, 関節]（設定の関節の順）"""
+        return _t(self._robot.data.applied_torque)[:, self.dof_ids]
+
+    def arm_body_contact_force(self):
+        """G1_Hackason（直し C）: 腕の部品ごとの、体からの接触の力の大きさ [N, 腕の部品]（直近の物理 1 回）。測り具が無ければ None"""
+        if self.arm_body_contact_sensor is None:
+            return None
+        m = _t(self.arm_body_contact_sensor.data.force_matrix_w)  # [N, 腕の部品, 相手, 3]
+        return m.norm(dim=-1).amax(dim=-1)
+
     def simulate_at_each_physics_step(self):
         self._sim_step_counter += 1
         is_rendering = self.sim.is_rendering  # G1_Hackason: 3.0 で has_gui はプロパティ、has_rtx_sensors は無い
