diff --git a/gr00t/rl/envs/base_task/substep_monitor.py b/gr00t/rl/envs/base_task/substep_monitor.py
new file mode 100644
index 0000000..9e84e5a
--- /dev/null
+++ b/gr00t/rl/envs/base_task/substep_monitor.py
@@ -0,0 +1,34 @@
+# G1_Hackason（直し 3・C、10-26）: 物理 1 回（200 Hz）ごとに、腕の力の張り付きと、腕と体の当たりを数える。
+#
+# 制御の 1 ステップ（物理 4 回）の終わりの写しだけを読むと、間の山を見落とす（10-19 のレバーの当たりと同じ。0057）。
+# - 力の張り付き（直し 3）: PhysX の中の PD の力の見積もり（Isaac Lab の robot.data.applied_torque。力の上限で切った値）が
+#   上限の saturation_ratio 倍以上だった物理の回の割合を、腕の関節ごとに出す。self.torques は Isaac Sim では計算されず
+#   常に 0（FingerPrimitiveBase が _apply_force_in_physics_step を上書きしている）ので使わない。生徒の観測 arm_dof_torque も
+#   0 のまま（実機も 0 を入れる）
+# - 腕と体の当たり（直し C）: 前腕・手首・手（左右）と、胴・骨盤・脚の間の接触の力の最大 [N]（相手を絞った測り具）
+import torch
+
+
+class SubstepMonitor:
+    def __init__(self, num_envs: int, num_arm: int, num_contact_bodies: int, device, saturation_ratio: float = 0.9):
+        self.ratio = float(saturation_ratio)
+        self.sat_count = torch.zeros(num_envs, num_arm, device=device)
+        self.contact_peak = torch.zeros(num_envs, max(num_contact_bodies, 0), device=device)
+        self.n = 0
+
+    def begin(self) -> None:
+        """制御の 1 ステップの始め（物理 1 回目の前）に数え直す"""
+        self.sat_count.zero_()
+        self.contact_peak.zero_()
+        self.n = 0
+
+    def after_substep(self, arm_torque: torch.Tensor, arm_limit: torch.Tensor, contact_force=None) -> None:
+        """物理 1 回の後。arm_torque [N, 腕]・arm_limit [腕]・contact_force [N, 部品]（無ければ None）"""
+        self.sat_count += (arm_torque.abs() >= self.ratio * arm_limit).float()
+        if contact_force is not None and self.contact_peak.shape[1] > 0:
+            self.contact_peak = torch.maximum(self.contact_peak, contact_force)
+        self.n += 1
+
+    def saturated_fraction(self) -> torch.Tensor:
+        """[N, 腕] 張り付いていた物理の回の割合（0〜1）"""
+        return self.sat_count / max(self.n, 1)
