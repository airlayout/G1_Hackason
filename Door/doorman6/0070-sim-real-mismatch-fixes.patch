@@ -624,10 +624,62 @@ class LeggedRobotBase(BaseTask):
 
     def _physics_step(self):
         self.render()
+        self._substep_monitor_begin()
         for sim_sub_t in range(self.config.simulator.config.sim.control_decimation):
             self._update_meta_pd_scale(sim_sub_t)
             self._apply_force_in_physics_step()
             self.simulator.simulate_at_each_physics_step()
+            self._after_physics_substep()
+
+    # G1_Hackason（直し 3・C、10-26）: 物理 1 回ごとに腕の力の張り付きと腕と体の当たりを数える（substep_monitor.py）。
+    # substep_monitor=True のときだけ。罰は penalty_arm_torque_saturation・penalty_arm_body_contact、記録は log_dict
+    def _substep_monitor_begin(self):
+        if not self.config.get("substep_monitor", False):
+            return
+        if getattr(self, "_substep_monitor", None) is None:
+            from gr00t.rl.envs.base_task.substep_monitor import SubstepMonitor
+
+            names = list(self.config.robot.dof_names)
+            self._monitor_arm_idx = torch.tensor(
+                [i for i, n in enumerate(names) if any(k in n for k in ("shoulder", "elbow", "wrist"))],
+                device=self.device,
+            )
+            n_parts = len(getattr(self.simulator, "arm_body_contact_names", []) or [])
+            self._substep_monitor = SubstepMonitor(
+                self.num_envs,
+                len(self._monitor_arm_idx),
+                n_parts,
+                self.device,
+                float(self.config.get("arm_torque_saturation_ratio", 0.9)),
+            )
+        self._substep_monitor.begin()
+
+    def _after_physics_substep(self):
+        mon = getattr(self, "_substep_monitor", None)
+        if mon is None:
+            return
+        tau = self.simulator.applied_dof_torque[:, self._monitor_arm_idx]
+        lim = self.simulator.torque_limits[self._monitor_arm_idx]
+        mon.after_substep(tau, lim, self.simulator.arm_body_contact_force())
+
+    def _reward_penalty_arm_torque_saturation(self):
+        """腕の関節のうち、力が上限の 9 割以上だった物理の回の割合の和（0〜14）"""
+        mon = getattr(self, "_substep_monitor", None)
+        if mon is None:
+            return torch.zeros(self.num_envs, device=self.device)
+        frac = mon.saturated_fraction()
+        self.log_dict["arm_torque_sat_frac"] = frac.mean()
+        return frac.sum(dim=-1)
+
+    def _reward_penalty_arm_body_contact(self):
+        """前腕・手首・手のうち、体（胴・骨盤・脚）と 1 N を越えて当たった部品の数"""
+        mon = getattr(self, "_substep_monitor", None)
+        if mon is None or mon.contact_peak.shape[1] == 0:
+            return torch.zeros(self.num_envs, device=self.device)
+        hit = mon.contact_peak > float(self.config.get("arm_body_contact_threshold", 1.0))
+        self.log_dict["arm_body_contact_frac"] = hit.any(dim=-1).float().mean()
+        self.log_dict["arm_body_contact_peak"] = mon.contact_peak.max()
+        return hit.float().sum(dim=-1)
 
     def _compute_perturbation_forces(self):
         """
@@ -833,8 +885,9 @@ class LeggedRobotBase(BaseTask):
