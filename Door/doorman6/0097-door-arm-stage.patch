 from gr00t.rl.envs.door.reset_from_dataset import ResetFromDataset
@@ -157,6 +164,14 @@ class DoorPregrasp(
         self.door_closer_params["backcheck_angle"] *= torch.pi / 180.0
         self.any_door_closer_shaped = bool(self.door_closer_shaped.any())
 
+        # G1_Hackason（パッチ 0097、11-09）: 段 2 レバーを腕だけで学ぶ口（arm_stage.py）。構えの位置から段 1 で始め、脚は毎歩
+        # 立つ HOMIE、complete_stage に入ったら完了。既定は切で、元と同じ
+        self._arm_stage = arm_stage_config(self.config.get("arm_stage", None))
+        if self._arm_stage is not None:
+            self._lever_pivot_y = lever_pivot_y(self.door_width, self.door_handle_width, self.door_open_lr)
+            self._arm_stage_latched = torch.ones(self.num_envs, dtype=torch.bool, device=self.device)
+            print(f"[arm_stage] 腕だけの段 {self._arm_stage}・脚は毎歩 立つ HOMIE（歩く指令の積み上げを 0）")
+
         # G1_Hackason: どちらの手で把手を取りに行くか。元の DoorMan は把手と反対の手（door_open_lr < 0 で左手。
         # このとき把手は機体の右）で、体の前を横切って取りに行く。lever_side_hand: True なら把手と同じ側の手を使う
         # （指の無い 29 関節版では左手が把手に届かず、区間 1→2 で止まった。2026-10-07 の評価で 0/121）
@@ -1293,6 +1308,8 @@ class DoorPregrasp(
         # G1_Hackason（G2、10-29）: 止まるはずの場面（構える・つかむ・レバーの間）は、実機でも測れる 2 つの値で決める:
         # 胴（腰）と把手の水平距離・扉の開いた角度。段階（stage_buf）は実機に無いので使わない。実機の door_core.py と同じ関数。
         # シミュレータは本当の値を渡す（実機はライダーの値。誤差は角度 σ0.07〜0.18°・位置 数 cm で、線 10°・0.3/0.5 m より十分小さい）
+        if getattr(self, "_arm_stage", None) is not None:  # 0097: 腕だけの段は毎歩止める（実機の段 2 は歩きの指令 0）
+            return self._arm_stage_latched
         if not self.config.get("stand_latch", False):
             return None
         dist = torch.norm(self.simulator.robot_root_states[:, :2] - self._compute_grasp_target()[:, :2], dim=-1)
@@ -1391,6 +1408,21 @@ class DoorPregrasp(
             w0 * torch.pi / 180.0, w1 * torch.pi / 180.0, (len(env_ids), 1), device=str(self.device)
         )[:, 0]
         self.target_robot_root_states[env_ids, 3:7] = quat_from_euler_xyz(r, p, random_yaw)
+        arm = getattr(self, "_arm_stage", None)
+        if arm is not None:  # G1_Hackason（0097）: 腕だけの段は、構えの位置（扉の面とレバーの付け根から）に立たせる
+            self._reset_root_states_arm_stage(env_ids, r, p, arm)
+
+    def _reset_root_states_arm_stage(self, env_ids, roll, pitch, arm: dict):
+        n = len(env_ids)
+        x, y, yaw = sample_stance(
+            self._lever_pivot_y[env_ids], self.door_open_lr[env_ids], arm["start_range"],
+            torch.rand(n, 3, device=self.device),
+        )
+        self.target_robot_root_states[env_ids, 0] = x + self.env_origins[env_ids, 0]
+        self.target_robot_root_states[env_ids, 1] = y + self.env_origins[env_ids, 1]
+        self.target_robot_root_states[env_ids, 3:7] = quat_from_euler_xyz(roll, pitch, yaw)
+        v = arm["start_vel"]  # 元の ±0.5 m/s・rad/s は歩いて近づく前提。扉の前で立ったまま始めるので小さくする
+        self.target_robot_root_states[env_ids, 7:13] = v * (2.0 * torch.rand(n, 6, device=self.device) - 1.0)
 
     @override
     def _reset_dofs(self, env_ids, target_state=None):
@@ -1419,6 +1451,14 @@ class DoorPregrasp(
         # set velocities to 0
         self.target_robot_dof_state[env_ids, :, 1] = 0.0
 
+    @override
+    def set_to_stage(self, env_ids, stage):
+        # G1_Hackason（0097）: 腕だけの段は、段 0 から始める回を start_stage（構える）から始める。途中の段から始める回はそのまま
+        arm = getattr(self, "_arm_stage", None)
+        if arm is not None:
+            stage = start_stages(stage, arm["start_stage"])
+        super().set_to_stage(env_ids, stage)
+
     def _reset_door_states(self, env_ids):
         randomize_door_init_state = self.config.get("randomize_door_init_state", False)
         self.door_dof_state_buf[:] = 0.0
@@ -1749,6 +1789,9 @@ class DoorPregrasp(
         return self._stage_4_to_5_advance_condition()
 
     def _stage_5_to_complete_condition(self):
+        arm = getattr(self, "_arm_stage", None)
+        if arm is not None:  # G1_Hackason（0097）: 腕だけの段は complete_stage（既定 4＝扉 10°）に入ったら完了
