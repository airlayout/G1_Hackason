From 0bc41cea495717e871b181728b7ec02a876926ea Mon Sep 17 00:00:00 2001
From: g1-door <g1-door@local>
Date: Fri, 9 Oct 2026 09:08:09 +0900
Subject: [PATCH] state recorder: record hand-lever force and door panel
 contact force per step (how hard the robot pushes)

---
 gr00t/rl/utils/state_recorder.py | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/gr00t/rl/utils/state_recorder.py b/gr00t/rl/utils/state_recorder.py
index 8bb3d22..9408936 100644
--- a/gr00t/rl/utils/state_recorder.py
+++ b/gr00t/rl/utils/state_recorder.py
@@ -95,6 +95,8 @@ class StateRecorder:
             "door_body_pos": (_t(env.simulator.scene.articulations["door"].data.body_pos_w)[:k]
                               - env.env_origins[:k, None]).cpu().numpy(),
         }
+        # G1_Hackason（段 2-3）: 使う手がレバーから受ける力 [N]（[:, 0]＝前へ押す・[:, 2]＝上下）。押す力の報酬と同じ量で、頭打ちの前の値
+        row.update(self._hand_lever_force(env, k))
         if self.pregrasp_diag:
             row.update(self._pregrasp_diag(env, k))
         for key, value in row.items():
@@ -105,6 +107,22 @@ class StateRecorder:
         if len(self.buf["step"]) >= self.chunk_steps:
             self.flush()
 
+    @staticmethod
+    def _hand_lever_force(env, k: int) -> dict:
+        if not hasattr(env, "right_hand_indices_tgt_ct_sensor"):
+            return {}
+        forces = env.simulator.object_to_hand_contact_forces[:k, 0]
+        left = forces[:, env.left_hand_indices_tgt_ct_sensor, :].sum(dim=-2)
+        right = forces[:, env.right_hand_indices_tgt_ct_sensor, :].sum(dim=-2)
+        net = torch.where(env.use_left_hand[:k, None], left, right)
+        out = {"hand_lever_force": net.cpu().numpy()}
+        # 扉の板が受ける接触の力の合計 [N]（ワールド座標）。閉じている間は枠からの押し返しも入る。開いていれば機体が板を押す力
+        sensors = env.simulator.scene.sensors
+        if "door_panel_unwanted_contact_sensor" in sensors:
+            panel = _t(sensors["door_panel_unwanted_contact_sensor"].data.net_forces_w)[:k]
+            out["door_panel_contact_force"] = panel.reshape(k, -1, 3).sum(dim=1).cpu().numpy()
+        return out
+
     @staticmethod
     def _pregrasp_diag(env, k: int) -> dict:
         """区間 1→2（手を構える）の条件の各項目。手なしの機体でどれが満たせないかを見る（door_open_homie.py の
-- 
