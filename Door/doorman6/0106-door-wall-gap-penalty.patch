+        body = self.simulator._rigid_body_pos
+        palm = torch.stack([self._palm_pos("left"), self._palm_pos("right")], dim=1)
+        pts = arm_points(body[:, self._wg_wrist_idx], palm, body[:, self._wg_elbow_idx], self._wg["tip_m"])
+        door = self.simulator.get_task_root_state("door")  # [pos, wxyz, …]
+        d = gap_to_walls(to_door_frame(pts, door[:, :3], door[:, 3:7]), self._wg_edge, self.door_cover_front_x,
+                         self.door_wall_front_x, self.door_cover_width)
+        dmin = d.amin(dim=-1)
+        self._wg_min = torch.minimum(self._wg_min, dmin)
+        self._wg_steps = self._wg_steps + 1
+        lam = self._wg_state["lambda"]
+        self.log_dict["wall_gap_lambda"] = torch.tensor(lam, device=self.device)
+        self.log_dict["wall_gap_rate"] = torch.tensor(self._wg_state["rate"], device=self.device)
+        self.log_dict["wall_gap_in_frac"] = (dmin < self._wg["x_m"]).float().mean()
+        return -lam * gap_cost(d, self._wg["x_m"])
+
+    def _wg_episode_end(self, env_ids):
+        """0106: 回の終わり（リセット）に、回の中で一度でも X 以内に入ったかを数えて λ を進め、回の最小距離を戻す。
+        評価の間・1 歩も進んでいない回（始めのリセット）は数えない。λ は state_path に残す（区切りをまたいで続ける）"""
+        valid = self._wg_steps[env_ids] > 0
+        if not getattr(self, "is_evaluating", False) and bool(valid.any()):
+            viol = (self._wg_min[env_ids][valid] < self._wg["x_m"]).float()
+            st = self._wg_state
+            before = st["events"]
+            st["lambda"], st["rate"] = lagrange_step(st["lambda"], st["rate"], viol, self._wg)
+            st["events"] += int(viol.numel())
+            st["violations"] += int(viol.sum())
+            path, every = self._wg["state_path"], self._wg["save_every_events"]
+            if path and st["events"] // every != before // every:
+                with open(path, "w") as fp:
+                    json.dump({**st, "step": int(self.common_step_counter)}, fp)
+        self._wg_min[env_ids] = float("inf")
+        self._wg_steps[env_ids] = 0
