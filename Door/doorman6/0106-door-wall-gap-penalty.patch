+"""枠と壁へのすき間の罰（G1_Hackason 計画 docs/plan/2026-11-11-g1-door-stage2-decision.md 5 節 3、パッチ 0106、2026-11-11）。
+
+11-11 の実機は、段 2 の腕の振り出しで手が把手の側の枠・壁に当たった（1 回目・3 回目。手の外力 28〜35 N・肩 roll 6〜8 N·m）。
+その時、順運動学の模型の点（指先＝手のひら＋10 cm・手のひら・手首・前腕の中ほど・肘）は面から 3.3〜4.5 cm 離れて見えていた
+（模型と実際の手の形の差・揃えの残り）。段 0 を点群で直した後の残り約 1 cm を足して X = 6 cm（ユーザー 11-11「案 2」）。
+今までの当たりの罰（penalty_door_frame_contact）は触れた時だけで相手も絞っていないので、近くを通るだけなら罰にならなかった。
+
+罰: 左右の腕の模型の点 10 個の、上から見た枠・壁の箱までの距離 d から、費用 = Σ max(0, X − d) / X（触れると 1 点あたり 1）。
+  枠: 開口の縁（y = ±(幅/2 − すき間)）から枠の幅、前の面は扉の customData の coverFrontX。壁: その外、前の面は wallFrontX
+  縁の内でも枠の横の面に近ければ数える（付け根の近くを押す手も入る）
+重みの自動調整（10-20 のレバーの当たりの罰と同じ双対上昇）: 回の中で一度でも X 以内に入った回を違反とし、その割合（回ごとの
+  指数移動平均）が target_rate より多い間は λ を上げ、少なければ下げる（0〜lambda_max）。報酬は −λ·費用（重み 1.0 で使う）。
+  λ は state_path の JSON に残して区切りをまたいで続ける。評価の間は更新しない
+
+env.config.wall_gap（無い・enabled=False なら元のまま）:
+  enabled・x_m（0.06）・tip_m（0.10）・lambda_init（2.0）・lambda_max（50）・lr（0.002）・target_rate（0.1）・rate_init（1.0）・
+  rate_ema（0.002）・state_path（無し）・save_every_events（200）
+rewards.reward_scales.wall_gap_lagrange: 1.0
+
+ここは torch の関数だけ（Isaac Sim なしで試験できる）。環境（door_open_homie.py）が呼ぶ。
+"""
+
+from __future__ import annotations
+
+import torch
+
+DEFAULTS = {"x_m": 0.06, "tip_m": 0.10, "lambda_init": 2.0, "lambda_max": 50.0, "lr": 0.002, "target_rate": 0.1,
+            "rate_init": 1.0, "rate_ema": 0.002, "save_every_events": 200}
+DEPTH_M = 0.30  # 箱の奥行き（前の面から奥へ）。距離の計算に使うだけ
+FAR_M = 5.0  # 壁の箱の外への広がり
+
+
+def wall_gap_config(cfg) -> dict | None:
+    """env.config.wall_gap を読んで確かめる。無い・enabled=False なら None"""
+    if cfg is None or not bool(cfg.get("enabled", False)):
+        return None
+    out = {k: float(cfg.get(k, v)) for k, v in DEFAULTS.items()}
+    out["save_every_events"] = int(out["save_every_events"])
+    assert out["x_m"] > 0.0 and out["tip_m"] >= 0.0, f"wall_gap.x_m は正・tip_m は 0 以上: {out}"
+    assert 0.0 <= out["target_rate"] <= 1.0 and 0.0 < out["rate_ema"] <= 1.0, f"wall_gap.target_rate・rate_ema: {out}"
+    assert 0.0 <= out["lambda_init"] <= out["lambda_max"], f"wall_gap は 0 <= lambda_init <= lambda_max: {out}"
+    out["state_path"] = cfg.get("state_path", None)
+    return out
+
+
+def box_dist_2d(px: torch.Tensor, py: torch.Tensor, x0, x1, y0, y1) -> torch.Tensor:
+    """上から見た長方形 [x0,x1]×[y0,y1] までの符号つき距離（外は正・中は負）。境はテンソルでも数でもよい"""
+    dx = torch.maximum(x0 - px, px - x1)
+    dy = torch.maximum(y0 - py, py - y1)
+    outside = torch.hypot(dx.clamp(min=0.0), dy.clamp(min=0.0))
+    inside = torch.maximum(dx, dy).clamp(max=0.0)
+    return outside + inside
+
+
+def gap_to_walls(P: torch.Tensor, edge: torch.Tensor, frame_x: torch.Tensor, wall_x: torch.Tensor,
+                 cover_w: torch.Tensor) -> torch.Tensor:
+    """P [n, k, 3]（扉の座標）→ 両側の枠・壁の箱までの距離の最小 [n, k]。edge・frame_x・wall_x・cover_w は [n]"""
+    px = P[..., 0]
+    e, fx, wx, cw = (v[:, None] for v in (edge, frame_x, wall_x, cover_w))
+    ds = []
+    for s in (1.0, -1.0):
+        py = s * P[..., 1]
+        ds.append(box_dist_2d(px, py, fx, fx + DEPTH_M, e, e + cw))
+        ds.append(box_dist_2d(px, py, wx, wx + DEPTH_M, e + cw, e + FAR_M))
+    return torch.stack(ds).amin(dim=0)
+
+
+def arm_points(wrist: torch.Tensor, palm: torch.Tensor, elbow: torch.Tensor, tip_m: float) -> torch.Tensor:
+    """[n, 2, 3]（左・右）の手首・手のひら・肘 → [n, 10, 3]（左の指先・手のひら・手首・前腕の中ほど・肘、右の同じ順）"""
+    d = palm - wrist
+    tip = palm + tip_m * d / (torch.linalg.norm(d, dim=-1, keepdim=True) + 1e-9)
+    fore = (wrist + elbow) / 2
+    pts = torch.stack([tip, palm, wrist, fore, elbow], dim=2)  # [n, 2, 5, 3]
+    return pts.reshape(pts.shape[0], 10, 3)
+
+
+def gap_cost(d: torch.Tensor, x_m: float) -> torch.Tensor:
+    """距離 [n, k] → 費用 [n] = Σ max(0, X − d) / X"""
+    return ((x_m - d).clamp(min=0.0) / x_m).sum(dim=-1)
+
+
+def to_door_frame(P: torch.Tensor, door_pos: torch.Tensor, door_wxyz: torch.Tensor) -> torch.Tensor:
+    """世界の点 [n, k, 3] を扉の座標へ（扉の root の位置 [n, 3]・向き wxyz [n, 4] の逆を掛ける）"""
+    w, x, y, z = (door_wxyz[:, i, None] for i in range(4))
+    v = P - door_pos[:, None, :]
+    # q の逆（共役）で回す: v' = v + 2 q̄v × (q̄v × v + w v)、q̄v = −(x, y, z)
+    qv = -torch.stack([x, y, z], dim=-1).expand_as(v)
+    t = 2.0 * torch.cross(qv, v, dim=-1)
+    return v + w[..., None] * t + torch.cross(qv, t, dim=-1)
+
+
+def lagrange_step(lam: float, rate: float, viol: torch.Tensor, cfg: dict) -> tuple[float, float]:
+    """回の終わりの違反（0/1 [m]）で、割合の指数移動平均と λ を進める。(λ, 割合) を返す"""
+    n = int(viol.numel())
+    if n == 0:
+        return lam, rate
+    keep = (1.0 - cfg["rate_ema"]) ** n
+    rate = rate * keep + float(viol.float().mean()) * (1.0 - keep)
+    lam = lam + cfg["lr"] * (rate - cfg["target_rate"]) * n
+    return min(max(lam, 0.0), cfg["lambda_max"]), rate
