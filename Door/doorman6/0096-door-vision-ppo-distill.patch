+    fr, mb = _loss_inputs()
+    ret = tr._compute_loss(fr, mb)
+    assert float(ret["loss"]) == pytest.approx(0.5 * 8.0)
+    assert ret["bc_anchor_coef"] == 0.0
+    assert float(ret["bc_anchor_loss"]) > 0 and float(ret["obj_pred_loss"]) > 0  # 記録には出す
