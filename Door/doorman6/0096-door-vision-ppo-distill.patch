+def test_count_success_passed_ignores_stage():
+    spec = importlib.util.spec_from_file_location("count_success", COUNT_SUCCESS)
+    cs = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(cs)
+    steps = 6
