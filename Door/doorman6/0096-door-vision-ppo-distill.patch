+def test_kl_learning_rate_frozen_during_warmup():
+    opt = torch.optim.Adam([torch.nn.Parameter(torch.zeros(1))], lr=1e-4)
+    tr = _bare_trainer(global_step=71_600, rl_start_step=71_600)
