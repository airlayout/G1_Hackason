+def build(student: dict, teacher: dict, std_scale: float) -> dict:
+    sp = student["policy_state_dict"]
+    assert "door_head.net.0.weight" in sp, "画像だけの生徒の重みではない"
+    policy = {k: v.clone() for k, v in sp.items()}
+    std = teacher["policy_state_dict"]["std"]
+    assert std.shape == policy["std"].shape, f"行動の数が合わない: 生徒 {tuple(policy['std'].shape)}・教師 {tuple(std.shape)}"
+    policy["std"] = std.clone() * std_scale
+    state = copy.copy(teacher["state"])
+    state.rl_start_step = int(state.global_step)
+    return {
+        "policy_state_dict": policy,
+        "value_state_dict": teacher["value_state_dict"],
+        "optimizer_state_dict": None,
+        "lr_scheduler_state_dict": None,
+        "state": state,
+        "env_state_dict": teacher.get("env_state_dict", {}),
+    }
+
+
+def env_state_diff(a: dict, b: dict) -> list[str]:
+    """env の状態の違い（項目名と両方の値）"""
+    out = []
+    for k in sorted(set(a) | set(b)):
+        va, vb = a.get(k), b.get(k)
+        same = (torch.equal(va, vb) if isinstance(va, torch.Tensor) and isinstance(vb, torch.Tensor)
+                and va.shape == vb.shape else va == vb)
+        if not same:
+            out.append(f"{k}: 生徒 {va} ・教師 {vb}")
+    return out
+
+
