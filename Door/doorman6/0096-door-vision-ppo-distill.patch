--- a/gr00t/rl/trl/trainer/ppo_distill_trainer_homie_api.py
+++ b/gr00t/rl/trl/trainer/ppo_distill_trainer_homie_api.py
@@ -0,0 +1,173 @@
+# G1_Hackason（11-08、パッチ 0096・計画書 docs/plan/2026-11-06-g1-door-depth-rl.md 8 章の案 A）: 画像だけの生徒を、自分の報酬で磨く。
+#   DAgger（模倣学習）だけの生徒は教師が上限で、教師が生徒に見えない値に頼る所では教師の行動を平均でしか写せない。そこで
+#   PPO（強化学習）で生徒自身の報酬から学ばせ、教師への真似は錨として少しずつ弱める（Kickstarting・TWIST・Distillation-PPO の形）。
+#
+#   損失 = PPO（評価係は教師の評価係から始める）
+#          ＋ λ(t) × 教師の行動の平均との差の 2 乗（真似の錨）
+#          ＋ obj_pred_loss_coef × 追う段の当て直した扉の値の誤差（DAgger と同じ補助の損失。11-05 の qc1 は追う段を固めて外れを直せなかった）
+#   教師の答えは DAgger（distill_trainer_obj_pred_homie_api）と同じく、生徒が自分で走った各歩で教師に答えさせる（teacher_obs。
+#   教師の LSTM は回の切れ目で戻す）。教師に運転させる台は作らない（他人の行動が混ざると PPO の更新が壊れる）
+#   λ(t): 慣らしの後 bc_anchor_decay_iters 反復で bc_anchor_coef_start から bc_anchor_coef_end へ直線に下げる
+#   評価係の慣らし: 最初の critic_warmup_iters 反復は評価係の損失だけで更新する（教師の評価係は教師の回の値しか知らない）。
+#     その間は actor が動かず KL が 0 に近いので、KL での学習率の調整もしない（調整すると 1.5 倍ずつ上がり続ける）
+#   反復は強化学習を始めた所（state.rl_start_step）から数える。学習の状態は重みに保存されるので、30 分の区切りで起こし直しても続きから数える
+from copy import deepcopy
+
+import torch
+
+from gr00t.rl.trl.trainer.ppo_trainer_homie_api import TRLPPOTrainer
+
+
+def bc_anchor_coef(rl_iters: int, warmup: int, start: float, end: float, decay_iters: int) -> float:
+    """真似の錨の重み λ。慣らしの間は 0（損失に足さない）。慣らしの後 decay_iters 反復で start から end へ直線に下げ、その後は end"""
+    if rl_iters < warmup:
+        return 0.0
+    if decay_iters <= 0:
+        return float(end)
+    frac = min(1.0, (rl_iters - warmup) / decay_iters)
+    return float(start + (end - start) * frac)
+
+
+def anchor_losses(mu, teacher_mu, obj_pred, gt_obj, obj_weight):
+    """真似の錨（教師の行動の平均との差の 2 乗の平均）と、追う段の補助の損失（扉の値の項目ごとに 1/許す誤差² を掛けた 2 乗の平均。
+    distill_trainer_obj_pred._compute_obj_pred_loss と同じ式）。並びはどちらも [台, 歩, 項目]"""
+    bc = torch.mean(torch.square(mu - teacher_mu))
+    gt = gt_obj[..., : obj_pred.shape[-1]].to(obj_pred.dtype)
+    obj = (torch.square(obj_pred - gt) * obj_weight.to(obj_pred.device)).mean()
+    return bc, obj
+
+
+class TRLPPODistillTrainerHomieAPI(TRLPPOTrainer):
+    _tag_names = ["trl", "humanoid_ppo_distill"]
+
+    def _init_trl(self, *args, **kwargs):
+        super()._init_trl(*args, **kwargs)
+        if self.ref_model is None:
+            raise ValueError("教師が無い。exp に algo.config.use_dagger: True と teacher_actor を書く")
+        self.bc_anchor_coef_start = float(self.config.get("bc_anchor_coef_start", 1.0))
+        self.bc_anchor_coef_end = float(self.config.get("bc_anchor_coef_end", 0.1))
+        self.bc_anchor_decay_iters = int(self.config.get("bc_anchor_decay_iters", 2000))
+        self.critic_warmup_iters = int(self.config.get("critic_warmup_iters", 50))
+        self.obj_pred_loss_coef = float(self.config.get("obj_pred_loss_coef", 0.2))
+        self._load_teacher_actor()
+
+    def _load_teacher_actor(self):
+        """distill_trainer.load_teacher_actor と同じ（教師の重みを読み、正規化の統計を動かさないように eval にする）"""
+        path = self.config.network_load_dict.teacher_actor.path
+        ck = torch.load(path, map_location=self.accelerator.device, weights_only=False)
+        key = "actor_model_state_dict" if "actor_model_state_dict" in ck else "policy_state_dict"
+        self.ref_model.load_state_dict(ck[key])
+        self.ref_model.eval()
+        for p in self.ref_model.parameters():
+            p.requires_grad = False
+        print(f"[G1_Hackason] 真似の錨の教師を読んだ: {path}")
+
+    def _setup_storage(self):
+        super()._setup_storage()
+        self.storage.register_key("teacher_actions", shape=(self.policy_model.num_actions,), dtype=torch.float)
+
+    def train(self):
+        if getattr(self.state, "rl_start_step", None) is None:
+            self.state.rl_start_step = int(self.state.global_step)
+        print(f"[G1_Hackason] 強化学習の反復 {self._rl_iters()} から（始めた所 {self.state.rl_start_step}・"
+              f"慣らし {self.critic_warmup_iters}・真似の錨 {self.bc_anchor_coef_start}→{self.bc_anchor_coef_end} を "
+              f"{self.bc_anchor_decay_iters} 反復で・追う段の補助 {self.obj_pred_loss_coef}）")
+        return super().train()
+
+    def _rl_iters(self) -> int:
+        return int(self.state.global_step) - int(getattr(self.state, "rl_start_step", self.state.global_step))
+
+    def _in_warmup(self) -> bool:
+        return self._rl_iters() < self.critic_warmup_iters
+
+    # --- 走らせる間: 生徒の各歩で教師に答えさせる ---
+
+    def policy_step(self, policy_model, homie_walk_model, homie_stand_model, obs_dict, cur_dones=None,
+                    store_hidden_states=True):
+        out = super().policy_step(policy_model, homie_walk_model, homie_stand_model, obs_dict,
+                                  cur_dones=cur_dones, store_hidden_states=store_hidden_states)
+        with torch.no_grad():
+            teacher = self.ref_model.act_inference(obs_dict=deepcopy(obs_dict), input_key="teacher_obs")
+        out["teacher_actions"] = teacher[..., : self.policy_model.num_actions]
+        return out
+
+    def _rollout_step(self, model, obs_dict):
+        self.ref_model.init_rollout()
+        obs_dict = super()._rollout_step(model, obs_dict)
+        # 教師は act_inference だけを使い distribution を作らない。Actor.clear_rollout は del self.distribution で 2 回目の
+        # 反復から落ちる（11-08 r1 の区切り 0。DAgger の学習係は try/except で黙って飛ばしていた）。空の値を置いてから呼び、
+        # 観測の溜めの片付けと隠れ状態の切り離しまで通す
+        self.ref_model.distribution = None
+        self.ref_model.clear_rollout()
+        return obs_dict
+
+    def _process_env_step(self, rewards, dones, infos):
+        super()._process_env_step(rewards, dones, infos)
+        self.ref_model.reset(dones)
+
+    # --- 学ぶ間: 教師の答えと扉の値の正解を [台, 歩] の並びで渡す（PPO の学習の段の出力と同じ並び） ---
+
+    def _get_rollout_data(self, obs_keys):
+        data = super()._get_rollout_data(obs_keys)
+        data["teacher_actions"] = self.storage.teacher_actions.transpose(0, 1).to(self.accelerator.device)
+        return data
+
+    def _get_mb_rollout_data(self, rollout_data, micro_batch_inds):
+        mb = super()._get_mb_rollout_data(rollout_data, micro_batch_inds)
+        mb["mb_teacher_actions"] = rollout_data["teacher_actions"][micro_batch_inds]
+        mb["mb_gt_obj_pos"] = rollout_data["all_obs_dict"]["gt_obj_pos"][micro_batch_inds]
+        return mb
+
+    def _forward_model(self, model, mb_rollout_data):
+        out = super()._forward_model(model, mb_rollout_data)
+        # 生徒（VisionDoorStudent）は学習の段の act で当て直した扉の値を last_obj_pred に残す（並びは action_mean と同じ）
+        out["obj_pred"] = self.accelerator.unwrap_model(model).policy.last_obj_pred
+        return out
+
+    def _compute_loss(self, forward_results, mb_rollout_data):
+        ret = super()._compute_loss(forward_results, mb_rollout_data)
+        warm = self._in_warmup()
+        mu = forward_results["policy_results"]["action_mean"][..., : self.policy_model.num_actions]
+        with torch.set_grad_enabled(not warm):
+            bc, obj = anchor_losses(mu, mb_rollout_data["mb_teacher_actions"].to(mu.dtype), forward_results["obj_pred"],
+                                    mb_rollout_data["mb_gt_obj_pos"], self.policy_model.obj_pred_weight)
+        lam = bc_anchor_coef(self._rl_iters(), self.critic_warmup_iters, self.bc_anchor_coef_start,
+                             self.bc_anchor_coef_end, self.bc_anchor_decay_iters)
+        if warm:
+            ret["loss"] = self.args.vf_coef * ret["ppo_loss_dict"]["vf_loss"]
+        else:
+            ret["loss"] = ret["loss"] + lam * bc + self.obj_pred_loss_coef * obj
+        ret.update(bc_anchor_loss=bc.detach(), obj_pred_loss=obj.detach(), bc_anchor_coef=lam)
+        return ret
+
+    def _adjust_learning_rate_based_on_kl(self, kl_mean, optimizer):
+        if self._in_warmup():
+            return
+        super()._adjust_learning_rate_based_on_kl(kl_mean, optimizer)
+
+    # --- 記録 ---
+
+    def _register_stats_buffer(self):
+        super()._register_stats_buffer()
+        shape = self.approxkl_stats.shape
+        self.bc_anchor_stats = torch.zeros(shape, device=self.accelerator.device)
+        self.obj_pred_stats = torch.zeros(shape, device=self.accelerator.device)
+
+    def _update_stats_buffer(self, ppo_epoch_idx, minibatch_idx, microbatch_idx, loss_dict, forward_results,
+                             mb_rollout_data):
+        super()._update_stats_buffer(ppo_epoch_idx, minibatch_idx, microbatch_idx, loss_dict, forward_results,
+                                     mb_rollout_data)
+        self.bc_anchor_stats[ppo_epoch_idx, minibatch_idx, microbatch_idx] = loss_dict["bc_anchor_loss"]
+        self.obj_pred_stats[ppo_epoch_idx, minibatch_idx, microbatch_idx] = loss_dict["obj_pred_loss"]
+
+    def _get_train_metrics(self):
+        metrics = super()._get_train_metrics()
+        lam = bc_anchor_coef(self._rl_iters(), self.critic_warmup_iters, self.bc_anchor_coef_start,
+                             self.bc_anchor_coef_end, self.bc_anchor_decay_iters)
+        metrics["loss/bc_anchor"] = self.accelerator.gather_for_metrics(self.bc_anchor_stats).mean().item()
+        metrics["loss/weighted_bc_anchor"] = lam * metrics["loss/bc_anchor"]
+        metrics["loss/obj_pred_loss"] = self.accelerator.gather_for_metrics(self.obj_pred_stats).mean().item()
+        metrics["rl/bc_anchor_coef"] = lam
+        metrics["rl/iters"] = self._rl_iters()
+        metrics["rl/critic_warmup"] = float(self._in_warmup())
+        return metrics
