+    assert opt.param_groups[0]["lr"] == pytest.approx(1e-4)
+    tr.state.global_step = 71_600 + 50
+    tr._adjust_learning_rate_based_on_kl(torch.tensor(1e-6), opt)
+    assert opt.param_groups[0]["lr"] == pytest.approx(1.5e-4)
