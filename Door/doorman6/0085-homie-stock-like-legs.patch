From 549999606e1972b4c76d09c389d747d8af1f6696 Mon Sep 17 00:00:00 2001
From: g1-door <g1-door@local>
Date: Fri, 30 Oct 2026 19:20:01 +0900
Subject: [PATCH] homie: stock-like legs options for the switch to the Unitree
 locomotion (delay the walking command that reaches HOMIE by a per-episode
 number of steps, env.config.loco_cmd_delay_steps_range; scale it per episode
 and axis, env.config.loco_cmd_gain_range; only the HOMIE observation and its
 history see the delayed command, the student and the critic keep their own;
 env.config.actor_obs_mask_lower_body zeroes the 15 HOMIE-driven joints in the
 student's dof_pos, dof_vel and actions; all off by default = unchanged)
 (10-30)

---
 gr00t/rl/envs/base_task/homie_base.py | 78 +++++++++++++++++++++++++++
 1 file changed, 78 insertions(+)

diff --git a/gr00t/rl/envs/base_task/homie_base.py b/gr00t/rl/envs/base_task/homie_base.py
index 1a9ba8d..fc80456 100644
--- a/gr00t/rl/envs/base_task/homie_base.py
+++ b/gr00t/rl/envs/base_task/homie_base.py
@@ -91,11 +91,13 @@ class HomieBase(LeggedRobotBase):
             self._clip_upper_actions_threshold = self.config.get(
                 "clip_upper_actions_threshold", 0.5
             )
+        self._init_stock_legs()  # G1_Hackason（0085）: 純正に似せた脚。既定は切
 
     @override
     def _reset_buffers_callback(self, env_ids, target_buf):
         super()._reset_buffers_callback(env_ids, target_buf)
         self._homie_actions[env_ids, :] = 0.0
+        self._reset_stock_legs(env_ids)
 
     @override
     def step(self, actor_state):
@@ -123,6 +125,7 @@ class HomieBase(LeggedRobotBase):
             self._homie_commands = torch.clamp(
                 self._homie_commands, self._homie_command_low_thres, self._homie_command_high_thres
             )
+        self._update_stock_legs()  # G1_Hackason（0085）: 脚に届く指令（遅れ・倍率）
 
         self._homie_actions = actions[:, -self._num_lower_dof :]
 
@@ -200,6 +203,81 @@ class HomieBase(LeggedRobotBase):
         commands[commands[:, :3].norm(dim=-1) < 0.1, :3] = 0.0
         return commands
 
+    def _get_obs_b_homie_commands_legs(self):
+        # G1_Hackason（0085）: 脚（HOMIE）に届く指令を、_get_obs_b_homie_commands と同じ尺度・止まりの帯で返す
+        commands = self._homie_commands_legs.clone()
+        commands[:, :2] *= 2.0
+        commands[:, 2] *= 0.5
+        commands[commands[:, :3].norm(dim=-1) < 0.1, :3] = 0.0
+        return commands
+
+    # ---- G1_Hackason（パッチ 0085、10-30）: 純正に似せた脚 ----
+    # 実機の脚を純正（Unitree の歩行）に替えるため、シミュレータの脚（HOMIE）の受け方を純正に寄せる。既定はどれも切で、元と同じ。
+    #   env.config.loco_cmd_delay_steps_range=[a,b]: 脚に届く歩きの指令（前後・横・旋回）を、回ごとに a〜b 歩（1 歩 0.02 秒）遅らせる。
+    #     実機の純正の遅れは 前後 0.2・横 0.1・旋回 0.0 秒（10-29 の遠隔操作の記録の相互相関）
+    #   env.config.loco_cmd_gain_range=[a,b]: 脚に届く歩きの指令に、回ごと・軸ごとに a〜b 倍を掛ける（指令どおりに進む割合の違い）
+    #   遅れと倍率は脚の観測（homie_obs の b_homie_commands とその履歴）にだけ入る。生徒と critic は自分が出した指令を見る
+    #   env.config.actor_obs_mask_lower_body=True: 生徒の観測の dof_pos・dof_vel・actions の脚と腰（HOMIE が動かす先頭
+    #     lower_body_actions_dim 個）を 0 にする。実機で純正が動かす脚の値はシムの HOMIE と違うので見せない（critic と HOMIE はそのまま）
+    #   歩くと立つの切り替え（学習器の algo.config.homie_switch_threshold、既定 0.5）は設定で変える（純正は小さな指令でも歩く）
+    def _init_stock_legs(self):
+        lo, hi = (int(v) for v in self.config.get("loco_cmd_delay_steps_range", [0, 0]))
+        glo, ghi = (float(v) for v in self.config.get("loco_cmd_gain_range", [1.0, 1.0]))
+        assert 0 <= lo <= hi, f"loco_cmd_delay_steps_range は 0 <= a <= b にする: [{lo}, {hi}]"
+        assert 0.0 < glo <= ghi, f"loco_cmd_gain_range は 0 < a <= b にする: [{glo}, {ghi}]"
+        self._loco_delay_range = (lo, hi)
+        self._loco_gain_range = (glo, ghi)
+        self._stock_legs_on = hi > 0 or (glo, ghi) != (1.0, 1.0)
+        self._mask_lower_obs = bool(self.config.get("actor_obs_mask_lower_body", False))
+        self._homie_commands_legs = self._homie_commands.clone()
+        self._loco_cmd_buf = torch.zeros(self.num_envs, hi + 1, 3, device=self.device)
+        self._loco_cmd_ptr = 0
+        self._loco_cmd_delay = torch.full((self.num_envs,), lo, dtype=torch.long, device=self.device)
+        self._loco_cmd_gain = torch.ones(self.num_envs, 3, device=self.device)
+        self._reset_stock_legs(torch.arange(self.num_envs, device=self.device))
+
+    def _reset_stock_legs(self, env_ids):
+        if not getattr(self, "_stock_legs_on", False) or len(env_ids) == 0:
+            return
+        lo, hi = self._loco_delay_range
+        glo, ghi = self._loco_gain_range
+        n = len(env_ids)
+        self._loco_cmd_delay[env_ids] = torch.randint(lo, hi + 1, (n,), device=self.device)
+        self._loco_cmd_gain[env_ids] = glo + (ghi - glo) * torch.rand(n, 3, device=self.device)
+        self._loco_cmd_buf[env_ids] = 0.0
+        self._homie_commands_legs[env_ids, :3] = 0.0
+
+    def _update_stock_legs(self):
+        if not getattr(self, "_stock_legs_on", False):
+            return
+        n_slot = self._loco_cmd_buf.shape[1]
+        self._loco_cmd_ptr = (self._loco_cmd_ptr + 1) % n_slot
+        self._loco_cmd_buf[:, self._loco_cmd_ptr] = self._homie_commands[:, :3]
+        idx = (self._loco_cmd_ptr - self._loco_cmd_delay) % n_slot
+        legs = self._homie_commands.clone()
+        legs[:, :3] = self._loco_cmd_buf[torch.arange(self.num_envs, device=self.device), idx] * self._loco_cmd_gain
+        self._homie_commands_legs = legs
+
+    def _apply_stock_legs_obs(self):
+        raw = self.obs_buf_dict_raw
+        if getattr(self, "_stock_legs_on", False) and "homie_obs" in raw.keys():
+            if "b_homie_commands" in raw["homie_obs"].keys():
+                legs = self._get_obs_b_homie_commands_legs() * self.config.obs.obs_scales["b_homie_commands"]
+                raw["homie_obs"]["b_homie_commands"] = legs
+                if "b_homie_commands" in self.hist_obs_dict.keys():
+                    self.hist_obs_dict["b_homie_commands"] = legs  # HOMIE の履歴（a_history_homie）も脚に届いた指令にする
+        if getattr(self, "_mask_lower_obs", False) and "actor_obs" in raw.keys():
+            for key in ("dof_pos", "dof_vel", "actions"):
+                if key in raw["actor_obs"].keys():
+                    masked = raw["actor_obs"][key].clone()  # 写しを作る（履歴と critic の値は元のまま）
+                    masked[:, : self._num_lower_dof] = 0.0
+                    raw["actor_obs"][key] = masked
+
+    @override
+    def _post_config_observation_callback(self):
+        self._apply_stock_legs_obs()
+        super()._post_config_observation_callback()
+
     def _get_obs_e_homie_dof_pos(self):
         return (
             self.simulator.dof_pos[:, : self._num_body_dof]
