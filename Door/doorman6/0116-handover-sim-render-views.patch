+# ---------------------------------------------------------------------------------------------------- 描画（0116）
+# G1_Hackason（パッチ 0116、11-18）: 技術報告の動画と機体の絵のため、扉の評価の VIDEO=1 と同じ描画の口（render_results・
+# 0015・0089）を E2 と views で使う。run_probe.sh の RENDER=1 が ++simulator.config.render_results=True などを渡す。
+# 描画は物理の刻みを変えない（カメラは観るだけ）。既定（render_results が無い）では何もしない＝元のまま
+
+
+def _render_on(env):
+    return bool(env.config.simulator.config.get("render_results", False))
+
+
+def _render(env):
+    """描画が有効なら、今の姿をこま 1 枚として動画に書く（env.step の前に呼ぶ。こまと記録の行は 1 対 1）"""
+    if _render_on(env):
+        env.render_results()
+
+
+def _robot_pose(env, i=0):
+    """台 i の機体の位置（env の原点から [m]）とヨー [rad]"""
+    pos = (_t(env.simulator.robot_root_states)[i, :3] - env.env_origins[i]).detach().cpu().numpy().astype(float)
+    x, y, z, w = (float(v) for v in _t(env.simulator.base_quat)[i].detach().cpu().numpy())
+    return pos, math.atan2(2 * (w * z + x * y), 1 - 2 * (y * y + z * z))
+
+
+def _camera_from_robot(env, eye_rel, target_rel, i=0, yaw_deg=None):
+    """機体の今の位置とヨー（yaw_deg を渡せばその向き [°]）から見た [前, 左, 上] [m]（上は床から）を、
+    env の原点からの位置 [x, y, z] に直す"""
+    pos, yaw = _robot_pose(env, i)
+    if yaw_deg is not None:
+        yaw = math.radians(float(yaw_deg))
+    c, s = math.cos(yaw), math.sin(yaw)
+
+    def world(rel):
+        fx, ly, up = (float(v) for v in rel)
+        return [float(pos[0] + c * fx - s * ly), float(pos[1] + s * fx + c * ly), up]
+
+    return world(eye_rel), world(target_rel)
+
+
+def _place_render_camera(env, eye_rel, target_rel, i=0, yaw_deg=None):
+    """render_results のカメラ（render_eye・render_target）を、台 i の機体から見た位置に固定する。
+    全部の台に同じずらし（env の原点から）で当たるので、正しく写るのは台 i だけ（動画は render_env_ids で台 i だけ書く）"""
+    from omegaconf import open_dict
+
+    eye, target = _camera_from_robot(env, eye_rel, target_rel, i, yaw_deg)
+    sim_cfg = env.config.simulator.config
+    with open_dict(sim_cfg):
+        sim_cfg.render_eye = eye
+        sim_cfg.render_target = target
+    return eye, target
+
+
+def _hide_scene(env, keep=("Robot", "eval_camera"), world_too=False, focus_env=None, root_extra=()):
+    """台の下の prim のうち keep 以外（扉・壁など）を描画から消す（visibility だけ。物理と当たりはそのまま）。
+    focus_env があれば、ほかの台は機体も消す（カメラだけ残す。遠くの台の機体が背景に写らないように）。
+    world_too=True なら /World の直下の envs と照明以外（床など）と、ステージの根の World・Render・Omni*・照明以外も消す
+    （機体の絵の背景を無地にする）。root_extra は根の直下で消す名前（印の玉など）。消した名前を返す（台 0・focus の分）"""
+    import omni.usd
+    from pxr import UsdGeom, UsdLux
+
+    stage = omni.usd.get_context().get_stage()
+    hidden = set()
+    show_env = 0 if focus_env is None else int(focus_env)
+
+    def hide(prim):
+        img = UsdGeom.Imageable(prim)
+        if img:
+            img.MakeInvisible()
+            hidden.add(str(prim.GetPath()).replace(f"/World/envs/env_{show_env}/", "env/"))
+        else:  # 型の無い prim（/World/ground・/Visuals など）は visibility を持たないので、子をたどって消す
+            for c in prim.GetChildren():
+                hide(c)
+
+    def is_light(prim):
+        return prim.HasAPI(UsdLux.LightAPI) or "Light" in prim.GetTypeName()
+
+    print("[handover_sim] ステージの根: " + ", ".join(f"{c.GetName()}({c.GetTypeName()})" for c in stage.GetPseudoRoot().GetChildren())
+          + " ／ /World: " + ", ".join(f"{c.GetName()}({c.GetTypeName()})" for c in stage.GetPrimAtPath("/World").GetChildren()),
+          flush=True)
+    for i in range(env.num_envs):
+        root = stage.GetPrimAtPath(f"/World/envs/env_{i}")
+        others = focus_env is not None and i != show_env
+        for child in root.GetChildren() if root.IsValid() else []:
+            if child.GetName() == "eval_camera" or (not others and child.GetName() in keep):
+                continue
+            hide(child)
+    for child in stage.GetPseudoRoot().GetChildren():
+        name = child.GetName()
+        if name in root_extra or (world_too and name not in ("World", "Render") and not name.startswith("Omni")
+                                  and not is_light(child)):
+            hide(child)
+    if world_too:
+        for child in stage.GetPrimAtPath("/World").GetChildren():
+            if child.GetName() != "envs" and not is_light(child):
+                hide(child)
+    return sorted(h for h in hidden if not h.startswith("/World/envs/env_"))
+
+
+def _keep_after_termination(env):
+    """回の終わりの判定は控えるが、台を置き直さない（倒れた後も物理のまま写すため。置き直すと立った姿へ瞬間移動する）。
+    控えた判定は env._handover_would_reset・_handover_would_timeout（reset_buf・time_out_buf と同じ形）"""
+    import torch
+
+    orig = env._check_termination
+    env._handover_would_reset = torch.zeros(env.num_envs, dtype=torch.bool, device=env.device)
+    env._handover_would_timeout = torch.zeros(env.num_envs, dtype=torch.bool, device=env.device)
+
+    def check():
+        orig()
+        env._handover_would_reset = env.reset_buf.bool().clone()
+        env._handover_would_timeout = env.time_out_buf.bool().clone()
+        env.reset_buf[:] = 0
+        env.time_out_buf[:] = 0
+
+    env._check_termination = check
+
+
 # ---------------------------------------------------------------------------------------------------- E1
 
 
