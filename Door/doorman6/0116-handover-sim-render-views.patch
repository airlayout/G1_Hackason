 def probe_e2(env, out, shares=(0.0, 0.2, 0.4, 0.6, 0.85), offsets=(0.0, 0.03, 0.06), extra=(), hold_s=3.0,
-             stand_rope_s=30.0, release_s=2.0, stand_free_s=30.0, delay_steps=0):
+             stand_rope_s=30.0, release_s=2.0, stand_free_s=30.0, delay_steps=0,
+             render_eye_rel=None, render_target_rel=(0.0, 0.0, 0.6), hide_scene=False, no_reset=False, cam_env=0,
+             cam_yaw_deg=None, hide_root=()):
     """E2: 綱の条件の格子で HOLD → STAND（綱そのまま 30 秒）→ 綱を 2 秒で緩める → さらに 30 秒。転倒・揺れを数える。
-    extra: [(share, offset_y), ...] を格子の後に足す（10-23 の再現の条件など）"""
+    extra: [(share, offset_y), ...] を格子の後に足す（10-23 の再現の条件など）
+    0116（描画。render_results が有効な時だけ効く）: render_eye_rel・render_target_rel は台 cam_env の機体の置き直した直後の
+    位置とヨー（cam_yaw_deg を渡せばその向き。台の向きは乱択で HOLD の間にも回るので、渡す瞬間の向きを E2 の記録から渡す）
+    から見た [前, 左, 上] [m] にカメラを固定する（無ければ render_eye・render_target のまま。動画は
+    render_env_ids=[cam_env] で台 cam_env だけ書く）。hide_scene は扉・壁とほかの台の機体を描画から消す（物理はそのまま）。
+    hide_root はステージの根の直下で消す名前。no_reset は倒れの判定を控えるだけで置き直さない（fell_t は元と同じ数え方）。
+    台の初めの向きは乱択なので、E2 の表の回をそのまま描くときは E2 と同じ台数・同じ種で回す"""
     import torch
 
     _, dfl = door_real()
@@ -266,6 +391,16 @@ def probe_e2(env, out, shares=(0.0, 0.2, 0.4, 0.6, 0.85), offsets=(0.0, 0.03, 0.
     s += [s[-1]] * (env.num_envs - n_cond)
     o += [o[-1]] * (env.num_envs - n_cond)
     env.reset_all()
+    cam = None
+    if _render_on(env):
+        if render_eye_rel is not None:
+            cam = _place_render_camera(env, render_eye_rel, render_target_rel, int(cam_env), cam_yaw_deg)
+        hidden = _hide_scene(env, focus_env=int(cam_env), root_extra=tuple(hide_root)) if hide_scene else []
+        pos0, yaw0 = _robot_pose(env, int(cam_env))
+        print(f"[handover_sim] 描画: 機体 {pos0.round(3).tolist()}・ヨー {math.degrees(yaw0):.1f}°・カメラ {cam}・消した {hidden}",
+              flush=True)
+    if no_reset:
+        _keep_after_termination(env)
     rope = Rope(env, s, o)
     share0 = rope.share.clone()
     _hook_substep(env, rope.apply)
@@ -279,6 +414,7 @@ def probe_e2(env, out, shares=(0.0, 0.2, 0.4, 0.6, 0.85), offsets=(0.0, 0.03, 0.
     total = hold_s + stand_rope_s + release_s + stand_free_s
     while t < total:
         q, dq, tau, quat, gyro, grav = _state_np(env)
+        _render(env)  # 0116: この行の記録と同じ時点のこま
         if t < hold_s:
             phase = 2  # HOLD
             reset = _hold_step(env)
@@ -296,7 +432,11 @@ def probe_e2(env, out, shares=(0.0, 0.2, 0.4, 0.6, 0.85), offsets=(0.0, 0.03, 0.
             env._delta_actions[:] = 0.0
             act = torch.cat([torch.zeros(env.num_envs, 17, device=env.device), leg], dim=-1)
             _, _, reset, _ = env.step({"actions": act})
-        r = _t(reset).detach().cpu().numpy().astype(bool) & ~_t(env.time_out_buf).detach().cpu().numpy().astype(bool)
+        if no_reset:  # 0116: 置き直さない回は、控えた判定で数える（元の reset と同じ時刻に立つ）
+            reset, time_out = env._handover_would_reset, env._handover_would_timeout
+        else:
+            time_out = env.time_out_buf
+        r = _t(reset).detach().cpu().numpy().astype(bool) & ~_t(time_out).detach().cpu().numpy().astype(bool)
         new = r & ~fell
         fell_t[new] = t
         fell |= r
@@ -304,8 +444,12 @@ def probe_e2(env, out, shares=(0.0, 0.2, 0.4, 0.6, 0.85), offsets=(0.0, 0.03, 0.
                        ("fz_true", truth.fz()), ("rope", _t(rope.last_force).cpu().numpy())):
             rec[key].append(v)
         t += DT
+    if _render_on(env):
+        env.end_render_results()
     arr = {k: np.asarray(v) for k, v in rec.items()}
-    np.savez_compressed(out / "e2.npz", share=np.array(s), offset=np.array(o), fell=fell, fell_t=fell_t, **arr)
+    weight_n = _t(rope.mass).cpu().numpy() * G  # 0116: 台ごとの体重 [N]（足の力を体重の % にするため）
+    np.savez_compressed(out / "e2.npz", share=np.array(s), offset=np.array(o), fell=fell, fell_t=fell_t, weight_n=weight_n,
+                        no_reset=np.array(bool(no_reset)), **arr)
     hl = np.mean(hold_load, 0) if hold_load else np.full((env.num_envs, 2), np.nan)
     t_arr = arr["t"]
     leg = np.abs(arr["dq"][:, :, :12])  # [時刻, 台, 12]
@@ -338,7 +482,95 @@ def probe_e2(env, out, shares=(0.0, 0.2, 0.4, 0.6, 0.85), offsets=(0.0, 0.03, 0.
             "collapsed": bool(fell[i] or (rope_free is not None and rope_free > 0.2) or (tilt_free is not None and tilt_free > 25.0)),
         })
     return {"rows": rows, "delay_steps": delay_steps, "falls": int(fell[:n_cond].sum()), "conditions": n_cond,
-            "collapsed": int(sum(r["collapsed"] for r in rows))}
+            "collapsed": int(sum(r["collapsed"] for r in rows)), "no_reset": bool(no_reset), "render_camera": cam,
+            "cam_env": int(cam_env)}
+
