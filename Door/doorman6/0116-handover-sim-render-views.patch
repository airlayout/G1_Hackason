+# ---------------------------------------------------------------------------------------------------- views（0116）
+
+
+def probe_views(env, out, views=None, share=0.5, offset_y=0.0, hold_s=3.0, stand_rope_s=3.0, release_s=2.0,
+                stand_free_s=5.0, settle_steps=4, hide_scene=True, plain=True, hide_root=("Visuals",)):
+    """0116: 吊って HOMIE に渡し、綱を緩めて自分の足で立った G1 を、views の向きから PNG に 1 枚ずつ撮る（扉・壁は描画から消す）。
+    views: {名前: [eye_rel, target_rel]}（撮る時の台 0 の機体の位置とヨーから見た [前, 左, 上] [m]、上は床から）。
+    stand_rope_s・release_s・stand_free_s が全部 0 なら HOLD のまま撮る（動画のカメラの位置決めに使う）。
+    plain=True なら床なども描画から消してもう一巡撮る（<名前>_plain.png。背景が無地）。hide_root は根の直下で初めから消す
+    名前（既定 Visuals＝床の上の印の玉）。
+    カメラの位置・内部の値と機体の位置・関節の角度を views_camera.json に残す（関節の地図を後で重ねるため。views.json は simfix_probe の結果のまとめ）"""
+    import json
+
+    import imageio.v2 as imageio
+    import torch
+
+    assert _render_on(env), "views は ++simulator.config.render_results=True（run_probe.sh の RENDER=1）が要る"
+    views = dict(views or {"side_right": [[0.0, -3.0, 0.25], [0.0, 0.0, 0.6]]})
+    env.reset_all()
+    hidden = _hide_scene(env, root_extra=tuple(hide_root)) if hide_scene else []
+    rope = Rope(env, share, offset_y)
+    share0 = rope.share.clone()
+    _hook_substep(env, rope.apply)
+    loop = CoreLoop(env, os.environ["DOOR_POLICY"], 0)
+    stand_total = stand_rope_s + release_s + stand_free_s
+    zeros17 = torch.zeros(env.num_envs, 17, device=env.device)
+    clock = {"t": 0.0}
+
+    def step():
+        t = clock["t"]
+        if t < hold_s or stand_total <= 0:
+            _hold_step(env)
+        else:
+            ts = t - hold_s
+            if stand_rope_s <= ts < stand_rope_s + release_s:
+                rope.share = share0 * (1.0 - (ts - stand_rope_s) / release_s)
+            elif ts >= stand_rope_s + release_s:
+                rope.share = share0 * 0.0
+            leg = loop.step(ts)
+            env._delta_actions[:] = 0.0
+            env.step({"actions": torch.cat([zeros17, leg], dim=-1)})
+        clock["t"] = t + DT
+
+    while clock["t"] < hold_s + stand_total:
+        step()
+    cam = env.simulator.eval_camera
+    names = list(env.config.robot.dof_names)
+    shots = []
+
+    def shoot(suffix):
+        for name, (eye_rel, target_rel) in views.items():
+            eye, target = _camera_from_robot(env, eye_rel, target_rel)
+            dev, dt_ = env.env_origins.device, env.env_origins.dtype
+            cam.set_world_poses_from_view(env.env_origins + torch.tensor(eye, device=dev, dtype=dt_),
+                                          env.env_origins + torch.tensor(target, device=dev, dtype=dt_))
+            for _ in range(int(settle_steps)):  # 置いたカメラの画が出るまで数こま進める（機体は立ったまま）
+                step()
+            img = _t(cam.data.output["rgb"])[0].detach().cpu().numpy()[..., :3]
+            path = out / f"{name}{suffix}.png"
+            imageio.imwrite(path, img)
+            q, _, _, quat, _, grav = _state_np(env)
+            pos, yaw = _robot_pose(env)
+            shots.append({
+                "file": path.name, "eye_rel": list(eye_rel), "target_rel": list(target_rel),
+                "eye_env": eye, "target_env": target, "t_s": clock["t"],
+                "robot_pos_env": pos.round(4).tolist(), "robot_yaw_deg": math.degrees(yaw),
+                "robot_quat_wxyz": quat[0].round(5).tolist(), "tilt_deg": float(_tilt_deg(grav)[0]),
+                "q": dict(zip(names, q[0].round(5).tolist())),
+                "intrinsic": _t(cam.data.intrinsic_matrices)[0].detach().cpu().numpy().round(3).tolist(),
+                "image_hw": list(img.shape[:2]), "rope_share": float(rope.share[0]),
+            })
+            print(f"[handover_sim] views: {path.name} カメラ {eye}→{target}・傾き {shots[-1]['tilt_deg']:.1f}°", flush=True)
+
+    shoot("")
+    hidden_plain = []
+    if plain:
+        hidden_plain = _hide_scene(env, world_too=True)
+        shoot("_plain")
+    meta = {"share": share, "offset_y": offset_y, "hold_s": hold_s, "stand_rope_s": stand_rope_s, "release_s": release_s,
+            "stand_free_s": stand_free_s, "hidden": hidden, "hidden_plain": hidden_plain,
+            "focal_length": float(env.config.simulator.config.get("render_focal_length", 5.0)), "horizontal_aperture": 5.0,
+            "camera_convention": "set_world_poses_from_view（Z が上の look-at）", "shots": shots}
+    (out / "views_camera.json").write_text(json.dumps(meta, ensure_ascii=False, indent=1))
+    return {"shots": [s["file"] for s in shots], "hidden": hidden, "hidden_plain": hidden_plain,
+            "tilt_deg": [round(s["tilt_deg"], 2) for s in shots]}
 
 
