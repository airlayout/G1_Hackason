+class FeatDelay:
+    """11-05 夜: 撮った特徴を台ごとに k 歩遅らせて方策に渡す（k は撮るたびに [lo, hi] から引く）。
+    実機（PC2）は撮ってから方策が使うまで中央 108〜115 ms（10〜90% で 67〜159 ms。10 Hz の持ち回しを含む）、
+    シミュレータは描いたその歩から 0〜80 ms（中央 40 ms）＝約 3 歩の差。[2, 4] で 40〜160 ms（中央 100 ms ほど）になる。
+    hi は撮る間隔（every_n）より小さくする（待っている特徴を次に撮った特徴で上書きしないため）"""
+
+    def __init__(self, num_envs: int, feat_dim: int, lo: int, hi: int, device):
+        if not 0 <= lo <= hi:
+            raise ValueError(f"遅れの歩の範囲が逆か負: [{lo}, {hi}]")
+        self.lo, self.hi = int(lo), int(hi)
+        self.pending = torch.zeros(num_envs, feat_dim, device=device)
+        self.left = torch.full((num_envs,), -1, dtype=torch.long, device=device)  # 渡すまでの残りの歩（−1 は待ちなし）
+
+    def capture(self, cur: torch.Tensor, new: torch.Tensor) -> torch.Tensor:
+        """撮った歩: 遅れ 0 を引いた台にはすぐ new、ほかは待たせる → この歩に方策が見る特徴"""
+        k = torch.randint(self.lo, self.hi + 1, (new.shape[0],), device=new.device)
+        now = k == 0
+        self.pending = new.clone()
+        self.left = torch.where(now, torch.full_like(k, -1), k)
+        return torch.where(now[:, None], new, cur)
+
+    def tick(self, cur: torch.Tensor) -> torch.Tensor:
+        """撮らない歩: 待ちを 1 歩進め、残りが 0 になった台に待っていた特徴を渡す"""
+        waiting = self.left > 0
+        left = torch.where(waiting, self.left - 1, self.left)
+        due = waiting & (left == 0)
+        self.left = torch.where(due, torch.full_like(left, -1), left)
+        return torch.where(due[:, None], self.pending, cur)
+
+    def cancel(self, env_ids: torch.Tensor) -> None:
+        """回の始め: 前の回に撮った特徴を新しい回に持ち込まない"""
+        self.left[env_ids] = -1
+
+
 def load_encoder(path: str | None, feat_dim: int, device) -> DoorVisionEncoder:
     """学習済みの画像の網を読む（path が無ければ ImageNet のままの網。速さを測る・記録を集めるとき）"""
     enc = DoorVisionEncoder(feat_dim=feat_dim, pretrained=path is None)
