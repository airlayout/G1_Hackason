+"""11-05 夜: door_vision_feat.FeatDelay（撮った特徴を台ごとに k 歩遅らせて渡す）の試験。Isaac Sim なしで回る"""
+import pytest
+import torch
+
+from gr00t.rl.envs.door.door_vision_feat import FeatDelay
+
+EVERY = 5
+
+
+def _run(delay: FeatDelay, steps: int, n: int = 4, dim: int = 2):
+    """環境の _update_vision と同じ順に回し、歩ごとに方策が見る特徴（撮った回の番号）を返す"""
+    cur = torch.full((n, dim), -1.0)
+    seen = []
+    for k in range(steps):
+        if k % EVERY == 0:
+            cur = delay.capture(cur, torch.full((n, dim), float(k // EVERY)))
+        else:
+            cur = delay.tick(cur)
+        seen.append(cur[:, 0].clone())
+    return torch.stack(seen)  # [steps, n]
+
+
+def test_zero_delay_is_same_as_before() -> None:
+    seen = _run(FeatDelay(4, 2, 0, 0, "cpu"), 15)
+    want = torch.tensor([k // EVERY for k in range(15)], dtype=torch.float32)
+    assert torch.equal(seen, want[:, None].expand(15, 4))
+
+
+@pytest.mark.parametrize("d", [1, 2, 4])
+def test_fixed_delay_shifts_by_d_steps(d: int) -> None:
+    seen = _run(FeatDelay(3, 2, d, d, "cpu"), 20, n=3)
+    for k in range(20):
+        # 撮った歩から d 歩後に切り替わる。最初の d 歩は撮る前の値（−1）
+        want = (k - d) // EVERY if k >= d else -1
+        assert torch.all(seen[k] == want), (k, seen[k])
+
+
+def test_random_delay_within_range_and_per_env() -> None:
+    torch.manual_seed(0)
+    n = 512
+    delay = FeatDelay(n, 1, 2, 4, "cpu")
+    seen = _run(delay, EVERY * 4, n=n, dim=1)
+    # 2 回目に撮った特徴（番号 1、歩 5）が見え始めた歩 − 5 が遅れ
+    first = (seen == 1).float().argmax(dim=0) - EVERY
+    assert int(first.min()) == 2 and int(first.max()) == 4
+    assert len(torch.unique(first)) == 3  # 台ごとに引いている
+
+
+def test_cancel_drops_pending_feature() -> None:
+    delay = FeatDelay(2, 1, 3, 3, "cpu")
+    cur = delay.capture(torch.zeros(2, 1), torch.ones(2, 1))
+    delay.cancel(torch.tensor([1]))
+    for _ in range(3):
+        cur = delay.tick(cur)
+    assert cur[:, 0].tolist() == [1.0, 0.0]
+
+
+def test_bad_range_raises() -> None:
+    with pytest.raises(ValueError):
+        FeatDelay(2, 1, 3, 1, "cpu")
