diff --git a/gr00t/rl/config/exp/wbmanip/door_open_homie_29dof_state_ppo_plr-lstm.yaml b/gr00t/rl/config/exp/wbmanip/door_open_homie_29dof_state_ppo_plr-lstm.yaml
