 # レバーに掛け続ける力 [N·m]（元の DoorMan の「tension the door handle」。角度の 15° を rad にした値をそのまま力に使っている）
 DOOR_HANDLE_TENSION = 15 * torch.pi / 180.0
 # G1_Hackason（段 2-4）: closer_torque の引数 ← 扉の customData のキー（door.py の _sample_shaped_closer）。backcheck_angle は deg で入る
+# G1_Hackason（0112・11-14）: レバーと掛け金の台ごとの値 ← 扉の customData のキー（記録と扉だけの試しが使う。無い扉は NaN）
+DOOR_LEVER_METADATA_KEYS = {
+    "spring_k": "handleSpringK",
+    "spring_tau0": "handleSpringTau0",
+    "spring_damping": "handleSpringDamping",
+    "friction": "handleFriction",
+    "max_deg": "handleMaxAngleDeg",
+    "drive_max_force": "handleDriveMaxForce",
+    "latch_release_deg": "latchReleaseAngleDeg",
+    "latch_throw": "latchThrow",
+}
 DOOR_CLOSER_METADATA_KEYS = {
     "m0": "closerM0",
     "ratio_90": "closerRatio90",
@@ -152,6 +163,9 @@ class DoorPregrasp(
         self.door_wall_front_x = torch.full((self.num_envs,), -0.07, device=self.device)
         self.door_gap_width = torch.full((self.num_envs,), 0.002, device=self.device)
 
+        self.door_lever_params = {  # 0112
+            name: torch.full((self.num_envs,), float("nan"), device=self.device) for name in DOOR_LEVER_METADATA_KEYS
+        }
