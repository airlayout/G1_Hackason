+            add_collider(stage, latch_geom_prim_path)
 
         latch_joint_prim_path = os.path.join(panel_prim_path, "latch_joint")
         latch_joint = UsdPhysics.PrismaticJoint.Define(stage, latch_joint_prim_path)
