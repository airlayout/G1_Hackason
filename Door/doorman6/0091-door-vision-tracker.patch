+def _tracked_pair(tmp_path):
+    """追う段なしの生徒（d2 の代わり。扉の頭は乱数）と、その重みを init_student_from で読んだ追う段つきの生徒"""
+    base, env_config = _student()
+    path = tmp_path / "d2.pt"
+    torch.save({"policy_state_dict": base.state_dict()}, path)
+    trk, _ = _student(door_tracker_hidden=32, init_student_from=str(path))
+    return base.eval(), trk.eval(), env_config
+
+
+def test_tracker_starts_as_d2(tmp_path):
+    """直しの出口は 0 から＝追う段つきでも始めは d2 と同じ扉の値・同じ動き"""
+    base, trk, env_config = _tracked_pair(tmp_path)
+    gen = torch.Generator().manual_seed(3)
+    for _ in range(4):
+        s_obs = _make_obs(base, env_config, 5, gen)[0]
+        with torch.no_grad():
+            a0, d0 = base._rollout_mean({"actor_obs": s_obs})
+            a1, d1 = trk._rollout_mean({"actor_obs": s_obs})
+        assert torch.allclose(a0, a1, atol=1e-6) and torch.allclose(d0, d1, atol=1e-6)
+
+
+def test_tracker_batch_from_saved_hidden_matches_rollout(tmp_path):
+    """回したときの隠れ状態（get_hidden_states の 4 つ組）から学習の段を始めると、1 歩ずつ回した扉の値・行動と一致する"""
+    _, trk, env_config = _tracked_pair(tmp_path)
+    with torch.no_grad():
+        trk.tracker_out.weight.normal_(0.0, 0.3)
+    gen = torch.Generator().manual_seed(4)
+    n, k, length = 3, 3, 7
+    seq = [_make_obs(trk, env_config, n, gen)[0] for _ in range(length)]
+    acts, doors, saved = [], [], None
+    with torch.no_grad():
+        for t, o in enumerate(seq):
+            if t == k:
+                saved = tuple(h.clone() for h in trk.get_hidden_states())
+            a, d = trk._rollout_mean({"actor_obs": o})
+            acts.append(a)
+            doors.append(d)
+        assert len(saved) == 4 and saved[2].shape == (1, n, 32)
+        out = trk.forward({"actor_obs": torch.stack(seq[k:], dim=1)}, masks=torch.ones(length - k, n, dtype=torch.bool),
+                          hidden_states=saved)
+    roll_a = torch.stack(acts[k:], dim=1)
+    roll_d = torch.stack(doors[k:], dim=1)
+    assert torch.allclose(out["obj_pred"], roll_d, atol=1e-4), (out["obj_pred"] - roll_d).abs().max()
+    assert torch.allclose(out["actions"], roll_a, atol=1e-4), (out["actions"] - roll_a).abs().max()
+    # 隠れ状態 0 から始めると扉の値が変わる＝追う段は本当に覚えたことを使っている
+    with torch.no_grad():
