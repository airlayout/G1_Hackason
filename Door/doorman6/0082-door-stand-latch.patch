+            self._stand_latched,
+            self._door_opened_once,
+            dist,
+            door_deg,
+            enter_m=float(self.config.get("stand_latch_enter_m", 0.3)),
+            exit_m=float(self.config.get("stand_latch_exit_m", 0.5)),
+            door_deg_max=float(self.config.get("stand_latch_door_deg", 10.0)),
+            once_opened=bool(self.config.get("stand_latch_once_opened", True)),
+        )
+        self.log_dict["stand_latch_frac"] = self._stand_latched.float().mean()
+        return self._stand_latched
+
     def _compute_grasp_target(self):
         grasp_target_pos_w = (
             self.simulator.scene.sensors["right_hand_frame_transformer"]
@@ -1312,6 +1338,9 @@ class DoorPregrasp(
