+++ b/gr00t/rl/simulator/isaacsim/isaacsim.py
@@ -1233,7 +1233,21 @@ class IsaacSim(BaseSimulator):
                 obj_cfg = obj_cfg.replace(prim_path=f"/World/envs/env_.*/{name}")
                 if isinstance(obj_cfg.spawn, sim_utils.MultiAssetSpawnerCfg):
                     n = self.scene.cfg.num_envs
-                    obj_cfg.spawn.assets_cfg = obj_cfg.spawn.assets_cfg[:n]
+                    # G1_Hackason（0066）: env.config.door_pool_size があれば、台 i に i % pool 番目の部品を置き、
+                    # 扉を作る関数にも pool を渡す（台 i ≥ pool は台 i % pool と同じ扉。door.py が乱数を再生する）
+                    pool = self.env_config.get("door_pool_size", None)
+                    if pool:
+                        pool = int(pool)
+                        base = obj_cfg.spawn.assets_cfg
+                        obj_cfg.spawn.assets_cfg = [
+                            base[i % pool].replace(door_pool_size=pool)
+                            if hasattr(base[i % pool], "door_pool_size")
+                            else base[i % pool]
+                            for i in range(n)
+                        ]
+                        print(f"[G1_Hackason] door_pool_size={pool}: {n} 台に {min(pool, n)} 種類の扉")
+                    else:
+                        obj_cfg.spawn.assets_cfg = obj_cfg.spawn.assets_cfg[:n]
                     # G1_Hackason: 3.0 の MultiAssetSpawnerCfg は env ごとに配らなくなった。置き場所を明示する
                     obj_cfg.spawn.spawn_paths = [f"/World/envs/env_{i}/{name}" for i in range(n)]
                 # import ipdb; ipdb.set_trace()
