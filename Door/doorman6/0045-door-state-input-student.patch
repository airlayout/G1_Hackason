diff --git a/gr00t/rl/envs/door/door_state_sensor.py b/gr00t/rl/envs/door/door_state_sensor.py
new file mode 100644
index 0000000..3cc13e8
--- /dev/null
+++ b/gr00t/rl/envs/door/door_state_sensor.py
@@ -0,0 +1,173 @@
+# G1_Hackason（段 2.5）: 状態入力の生徒に渡す「実機で取れる扉の値」を、シミュレータの真の値から作る。torch だけで動く。
+#
+# 実機での取り方（計画書 段 2.5）:
+#   扉の開いた角度  頭の LiDAR（MID-360・10 Hz）で扉の板の点に平面を当てはめ、地図の枠の向きと比べる
+#   扉の枠の位置    事前地図の枠を、測位（FAST_LIO＋事前地図）で機体から見た位置に直す
+#   扉の寸法        幅・高さ・レバーの高さ・バックセット・向きは巻き尺で 1 回測って渡す（重さは渡さない）
+# 教師が見ていてここに無いもの: レバーの角度・手の力・手とレバーの位置・扉の重さ・今の区間・体の速度。
+# 誤差の大きさは仮（段 0 の実機の計測で置き換える）。値は env.config.door_sensor で替えられる。
+# 乱数は専用の Generator で引く（教師だけの評価で、元の乱数の並びを変えないため）。
+import math
+
+import torch
+
+DEFAULTS = {
+    "rate_hz": 10.0,  # LiDAR の 1 周
+    "latency_s": 0.1,  # 点群が届いて平面を当てはめ終わるまで
+    "angle_noise_deg": 1.5,  # 1 回の当てはめの揺れ（σ）
+    "angle_bias_deg": 2.0,  # 回ごとに固定の片寄り（±一様）。頭の取付・当てはめの癖
+    "dropout": 0.05,  # 点が足りず当てはめに失敗する割合
+    "dropout_near_hand": 0.3,  # 手のひらが板の近くにあるとき（腕で板が隠れる）
+    "near_hand_m": 0.15,  # 手のひらと板の面の距離がこれ以下なら「近く」
+    "max_incidence_deg": 75.0,  # 板を斜めから見る角度の上限（これを超えると板に当たる点が足りない）
+    "min_range_m": 0.15,
+    "max_range_m": 8.0,
+    "max_age_s": 1.0,  # 測った値の古さの頭打ち（観測では 0〜1 に直す）
+    "loc_pos_bias_m": 0.03,  # 測位の位置の片寄り（回ごと・σ）
+    "loc_pos_noise_m": 0.01,  # 測位の位置の揺れ（ステップごと・σ）
+    "loc_yaw_bias_deg": 1.0,  # 測位の向きの片寄り（回ごと・σ）。扉の角度にも同じだけ乗る
+    "loc_yaw_noise_deg": 0.3,  # 測位の向きの揺れ（ステップごと・σ）
+    "geometry_noise_m": 0.01,  # 巻き尺の誤差（回ごと・σ）
+    "lidar_offset": [0.0, 0.0, 0.45],  # torso_link から見た LiDAR の位置 [m]（実機は床上 約 1.23 m）
+    "seed": 0,
+}
+DEG = math.pi / 180.0
+
+
+def quat_mul_xyzw(a: torch.Tensor, b: torch.Tensor) -> torch.Tensor:
+    """xyzw の四元数の積 a ⊗ b（[N, 4]）"""
+    ax, ay, az, aw = a.unbind(-1)
+    bx, by, bz, bw = b.unbind(-1)
+    return torch.stack(
+        [
+            aw * bx + ax * bw + ay * bz - az * by,
+            aw * by - ax * bz + ay * bw + az * bx,
+            aw * bz + ax * by - ay * bx + az * bw,
+            aw * bw - ax * bx - ay * by - az * bz,
+        ],
+        dim=-1,
+    )
+
+
+class DoorStateSensor:
+    """扉の角度（LiDAR）・枠の位置（地図と測位）・寸法（巻き尺）の、雑音・片寄り・遅れ・欠けを入れた値。
+
+    使い方（env の 1 制御ステップごと）:
+      reset(env_ids)                             回の始まりに片寄りを引き直す（次の step で今の値から初め直す）
+      step(true_angle, visible, near_hand)       1 ステップ進める（10 Hz ごとに 1 回測る）
+      step(true_angle, env_ids=ids)              リセット直後の観測用に、その台だけ今の値で初め直す
+      door_angle_obs()                           [測った角度 rad, 最後の測定が成功したか 0/1, 古さ 0〜1]
+      localize(rel_pos, rel_rot_xyzw)            機体から見た枠の位置・向き（真の値）に測位の誤差を足す
+      geometry(privileged_door_info)             寸法 7 つ（重さを外し、長さに巻き尺の誤差を足す）
+    """
+
+    def __init__(self, num_envs: int, device, dt: float, cfg: dict | None = None):
+        c = dict(DEFAULTS)
+        c.update({k: v for k, v in (cfg or {}).items() if v is not None})
+        self.cfg = c
+        self.num_envs = num_envs
+        self.device = device
+        self.dt = float(dt)
+        self.period = max(1, round(1.0 / (float(c["rate_hz"]) * self.dt)))  # 何ステップに 1 回測るか
+        self.lag = max(0, round(float(c["latency_s"]) / self.dt))  # 何ステップ前の板を測るか
+        self.gen = torch.Generator(device=device)
+        self.gen.manual_seed(int(c["seed"]))
+
+        z = lambda *s: torch.zeros(*s, device=device)  # noqa: E731
+        self.ring = z(num_envs, self.lag + 1)  # 真の角度の履歴。[:, 0] が今、[:, -1] が lag ステップ前
+        self.held = z(num_envs)  # 最後に測れた角度
+        self.valid = z(num_envs)  # 最後の測定が成功したか
+        self.age = z(num_envs)  # held を測った板の時刻からの経過 [s]
+        self.counter = torch.zeros(num_envs, dtype=torch.long, device=device)
+        self.phase = torch.zeros(num_envs, dtype=torch.long, device=device)
+        self.angle_bias = z(num_envs)
+        self.loc_pos_bias = z(num_envs, 2)
+        self.loc_yaw_bias = z(num_envs)
+        self.geometry_bias = z(num_envs, 4)
+        self.needs_init = torch.ones(num_envs, dtype=torch.bool, device=device)
+
+    def _randn(self, *shape) -> torch.Tensor:
+        return torch.randn(*shape, device=self.device, generator=self.gen)
+
+    def _rand(self, *shape) -> torch.Tensor:
+        return torch.rand(*shape, device=self.device, generator=self.gen)
+
+    def reset(self, env_ids: torch.Tensor) -> None:
+        k = len(env_ids)
+        if k == 0:
+            return
+        c = self.cfg
+        self.angle_bias[env_ids] = (2.0 * self._rand(k) - 1.0) * float(c["angle_bias_deg"]) * DEG
+        self.loc_pos_bias[env_ids] = self._randn(k, 2) * float(c["loc_pos_bias_m"])
+        self.loc_yaw_bias[env_ids] = self._randn(k) * float(c["loc_yaw_bias_deg"]) * DEG
+        self.geometry_bias[env_ids] = self._randn(k, 4) * float(c["geometry_noise_m"])
+        self.phase[env_ids] = torch.randint(
+            0, self.period, (k,), device=self.device, generator=self.gen
+        )
+        self.needs_init[env_ids] = True
+
+    def _init(self, ids: torch.Tensor, angle: torch.Tensor) -> None:
+        self.ring[ids] = angle[:, None]
+        self.held[ids] = angle + self.angle_bias[ids] + self.loc_yaw_bias[ids]
+        self.valid[ids] = 1.0
+        self.age[ids] = self.lag * self.dt
+        self.counter[ids] = 0
+
+    def step(
+        self,
+        true_angle: torch.Tensor,
+        visible: torch.Tensor | None = None,
+        near_hand: torch.Tensor | None = None,
+        env_ids: torch.Tensor | None = None,
+    ) -> None:
+        if env_ids is not None:
+            # リセット直後: 機体と扉の値はまだ物理に書き戻される前のことがあるので、needs_init は残して次の step でもう一度初め直す
+            self._init(env_ids, true_angle[env_ids])
+            return
+        c = self.cfg
+        n = self.num_envs
+        self.ring = torch.cat([true_angle[:, None], self.ring[:, :-1]], dim=1)
+        self.counter += 1
+        self.age = torch.clamp(self.age + self.dt, max=float(c["max_age_s"]))
+        scan = (self.counter + self.phase) % self.period == 0
+        p_drop = torch.where(
+            near_hand, torch.full((n,), float(c["dropout_near_hand"]), device=self.device),
+            torch.full((n,), float(c["dropout"]), device=self.device),
+        )
+        ok = visible & (self._rand(n) >= p_drop)
+        meas = (
+            self.ring[:, -1]
+            + self.angle_bias
+            + self.loc_yaw_bias
+            + self._randn(n) * float(c["angle_noise_deg"]) * DEG
+        )
+        got = scan & ok
+        self.held = torch.where(got, meas, self.held)
+        self.age = torch.where(got, torch.full_like(self.age, self.lag * self.dt), self.age)
+        self.valid = torch.where(scan, ok.float(), self.valid)
+        init = self.needs_init.nonzero(as_tuple=False).flatten()
+        if len(init) > 0:
+            self._init(init, true_angle[init])
+            self.needs_init[init] = False
+
+    def door_angle_obs(self) -> torch.Tensor:
+        return torch.stack([self.held, self.valid, self.age / float(self.cfg["max_age_s"])], dim=1)
+
+    def localize(self, rel_pos: torch.Tensor, rel_rot_xyzw: torch.Tensor):
+        """機体から見た扉の枠の位置 [N, 3] と向き（xyzw）[N, 4] に、測位の誤差（位置と向きのずれ）を足す"""
+        c = self.cfg
+        n = rel_pos.shape[0]
+        yaw = self.loc_yaw_bias + self._randn(n) * float(c["loc_yaw_noise_deg"]) * DEG
+        dp = self.loc_pos_bias + self._randn(n, 2) * float(c["loc_pos_noise_m"])
+        cy, sy = torch.cos(yaw), torch.sin(yaw)
+        x = cy * rel_pos[:, 0] - sy * rel_pos[:, 1] + dp[:, 0]
+        y = sy * rel_pos[:, 0] + cy * rel_pos[:, 1] + dp[:, 1]
+        pos = torch.stack([x, y, rel_pos[:, 2]], dim=1)
+        zero = torch.zeros_like(yaw)
+        qz = torch.stack([zero, zero, torch.sin(yaw / 2), torch.cos(yaw / 2)], dim=1)
+        return pos, quat_mul_xyzw(qz, rel_rot_xyzw)
+
+    def geometry(self, door_info: torch.Tensor) -> torch.Tensor:
+        """privileged_door_info [幅, 高さ, レバーの高さ, バックセット, 重さ/100, lr, 1 − lr, io] から
+        [幅, 高さ, レバーの高さ, バックセット, lr, 1 − lr, io] を作る（長さ 4 つに巻き尺の誤差）"""
+        return torch.cat([door_info[:, :4] + self.geometry_bias, door_info[:, 5:8]], dim=1)
diff --git a/gr00t/rl/trl/modules/state_actor_obj_pred_recurrent.py b/gr00t/rl/trl/modules/state_actor_obj_pred_recurrent.py
new file mode 100644
index 0000000..b2406b9
--- /dev/null
+++ b/gr00t/rl/trl/modules/state_actor_obj_pred_recurrent.py
@@ -0,0 +1,185 @@
+# G1_Hackason（段 2.5）: 映像を使わない「状態入力の生徒」（DAgger で教師を真似る）。
+# DoorMan の VisionRecurrentActorObjPred から映像の部分（ResNet）を外し、actor_obs だけを LSTM に通す。
+# 学習係（distill_trainer_obj_pred_homie_api）が呼ぶ口（rollout_with_obj_pred・action_mean_with_obj_pred・
+# act_with_obj_pred）と返す形は元と同じにしてあるので、学習係は書き換えない。
+# 物の位置の当て（obj_pred）は LSTM の出力から出す（obj_pred_loss_coef が 0 なら学習には効かない）。
+from __future__ import annotations
+
+import torch
+import torch.nn as nn
+from hydra.utils import instantiate
+from torch.distributions import Normal
+
+from gr00t.rl.trl.modules.memory import Memory
+from gr00t.rl.trl.modules.vision_actor_critic_modules_recurrent import VisionRecurrentActor
+from gr00t.rl.utils.running_mean_std import RunningMeanStd
+
+
+class StateRecurrentActorObjPred(VisionRecurrentActor):
+    is_recurrent = True
+
+    def __init__(
+        self,
+        env_config,
+        algo_config,
+        backbone,
+        module_dim_dict={},
+        running_mean_std=False,
+        max_rollout_history=1,
+        input_key="actor_obs",
+        rnn_type="lstm",
+        rnn_hidden_dim=256,
+        rnn_num_layers=1,
+    ):
+        nn.Module.__init__(self)  # VisionRecurrentActor.__init__ は映像の部品を作るので呼ばない
+
+        self.input_key = input_key
+        obs_dim_dict = env_config.robot.algo_obs_dim_dict
+        self.max_rollout_history = max_rollout_history
+
+        self.memory = Memory(
+            input_size=obs_dim_dict[self.input_key],
+            type=rnn_type,
+            num_layers=rnn_num_layers,
+            hidden_size=rnn_hidden_dim,
+        )
+        module_dim_dict_recurrent = dict(module_dim_dict)
+        module_dim_dict_recurrent[self.input_key] = rnn_hidden_dim
+        module_dim_dict_recurrent["rnn_hidden_dim"] = rnn_hidden_dim
+        self.mlp_module = instantiate(
+            backbone.mlp_module,
+            env_config=env_config,
+            algo_config=algo_config,
+            obs_dim_dict={self.input_key: rnn_hidden_dim},
+            module_dim_dict=module_dim_dict_recurrent,
+            _recursive_=False,
+        )
+        self.obj_pred_mlp = instantiate(
+            backbone.obj_pred_mlp,
+            env_config=env_config,
+            algo_config=algo_config,
+            obs_dim_dict={"rnn_hidden_dim": rnn_hidden_dim},
+            module_dim_dict=module_dim_dict_recurrent,
+            _recursive_=False,
+        )
+
+        self.running_mean_std = None
+        if running_mean_std:
+            self.running_mean_std = RunningMeanStd(
+                (obs_dim_dict[self.input_key],), per_channel=True
+            )
+
+        self.num_actions = self.mlp_module.output_dim
+        self.std = nn.Parameter(algo_config.init_noise_std * torch.ones(self.num_actions))
+        if algo_config.get("freeze_noise_std", False):
+            self.std.requires_grad = False
+        self.clamp_noise_std = algo_config.get("clamp_noise_std", False)
+        if self.clamp_noise_std:
+            self.max_noise_std = algo_config.get("max_noise_std", 1.0)
+
+        self.distribution = None
+        Normal.set_default_validate_args(False)
+        self.obs_dict_buffer = {}
+        self.dones_buffer = None
+        self.steps = 0
+        self.is_eval_mode = False
+
+        print(f"StateRecurrentActorObjPred RNN: {self.memory}")
+        print(f"StateRecurrentActorObjPred MLP: {self.mlp_module}")
+        print(f"StateRecurrentActorObjPred ObjPred MLP: {self.obj_pred_mlp}")
+
+    def _set_distribution(self, mean: torch.Tensor) -> None:
+        if self.clamp_noise_std:
+            with torch.no_grad():
+                self.std.clamp_(max=self.max_noise_std)
+        self.distribution = Normal(mean, mean * 0.0 + self.std)
+
+    def _memory_step(self, obs: torch.Tensor) -> torch.Tensor:
+        """1 ステップ分（[N, d]）を LSTM に通す。隠れ状態は memory が持ち越す"""
+        out = self.memory(obs)
+        return out.squeeze(0) if out.dim() == 3 else out
+
+    def forward(self, obs_dict, masks=None, hidden_states=None, episode_attnmask=None, **kwargs):
+        """学習（[軌跡, 長さ, d]＋masks）と 1 ステップ（[N, d]）の両方。VisionRecurrentActorObjPred.forward と同じ並びで返す"""
+        obs_dict = dict(obs_dict)
+        if self.running_mean_std is not None:
+            obs_dict[self.input_key] = self.running_mean_std(obs_dict[self.input_key])
+        obs = obs_dict[self.input_key]
+        if obs.dim() == 2:
+            memory_out = self._memory_step(obs)
+        else:
+            memory_out = self.memory(obs.transpose(0, 1), masks=masks, hidden_states=hidden_states)
+        return {"actions": self.mlp_module(memory_out), "obj_pred": self.obj_pred_mlp(memory_out)}
+
+    def update_distribution(self, obs_dict, episode_attnmask=None, last_step_only=False, masks=None,
+                            hidden_states=None, **kwargs):
+        mean = self.forward(obs_dict, masks=masks, hidden_states=hidden_states,
+                            episode_attnmask=episode_attnmask)["actions"]
+        if last_step_only:
+            mean = mean[:, -1]
+        self._set_distribution(mean)
+
+    def act_with_obj_pred(self, obs_dict, masks=None, hidden_states=None, episode_attnmask=None, **kwargs):
+        result = self.forward(obs_dict, masks=masks, hidden_states=hidden_states, episode_attnmask=episode_attnmask)
+        self._set_distribution(result["actions"])
+        return {
+            "actions": self.distribution.sample(),
+            "action_mean": self.action_mean,
+            "action_sigma": self.action_std,
+            "predicted_obj_pos": result["obj_pred"],
+        }
+
+    def action_mean_with_obj_pred(self, obs_dict, episode_attnmask=None, **kwargs):
+        result = self.forward(obs_dict, episode_attnmask=episode_attnmask, **kwargs)
+        self._set_distribution(result["actions"])
+        return {
+            "actions": self.action_mean,
+            "action_mean": self.action_mean,
+            "action_sigma": self.action_std,
+            "predicted_obj_pos": result["obj_pred"],
+        }
+
+    def predict_object_position(self, obs_dict, **kwargs):
+        return self.forward(obs_dict, **kwargs)["obj_pred"]
+
+    def _rollout_mean(self, obs_dict, episode_attnmask=None, cur_dones=None):
+        self._update_obs_buffer(obs_dict, episode_attnmask, cur_dones)
+        obs = obs_dict[self.input_key]
+        if self.running_mean_std is not None:
+            with torch.no_grad():
+                obs = self.running_mean_std(obs)
+        memory_out = self._memory_step(obs)
+        self.steps += 1
+        return self.mlp_module(memory_out), self.obj_pred_mlp(memory_out)
+
+    def rollout_with_obj_pred(self, obs_dict, episode_attnmask=None, cur_dones=None, **kwargs):
+        mean, obj_pred = self._rollout_mean(obs_dict, episode_attnmask, cur_dones)
+        self._set_distribution(mean)
+        return {
+            "actions": self.distribution.sample(),
+            "action_mean": self.action_mean,
+            "action_sigma": self.action_std,
+            "predicted_obj_pos": obj_pred,
+        }
+
+    def rollout(self, obs_dict, episode_attnmask=None, cur_dones=None, **kwargs):
+        out = self.rollout_with_obj_pred(obs_dict, episode_attnmask, cur_dones)
+        out.pop("predicted_obj_pos")
+        return out
+
+    def act_inference(self, obs_dict, episode_attnmask=None, cur_dones=None, **kwargs):
+        mean, _ = self._rollout_mean(obs_dict, episode_attnmask, cur_dones)
+        return mean
+
+    def clear_rollout(self):
+        """回し終えたら隠れ状態を切り離す（RecurrentActor と同じ。TBPTT）"""
+        super().clear_rollout()
+        self.memory.detach_hidden_states()
+
+    def to_cpu(self):
+        if self.running_mean_std is not None:
+            self.running_mean_std.to("cpu")
+        self.memory.to("cpu")
+        self.mlp_module.to("cpu")
+        self.obj_pred_mlp.to("cpu")
+        self.std.to("cpu")
diff --git a/tests/test_door_state_sensor.py b/tests/test_door_state_sensor.py
