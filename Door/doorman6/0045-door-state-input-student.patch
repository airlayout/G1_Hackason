index 0000000..ecd0936
--- /dev/null
+++ b/tests/test_door_state_sensor.py
@@ -0,0 +1,156 @@
+# G1_Hackason（段 2.5）: 状態入力の生徒に渡す扉の値（door_state_sensor.py）と、その鏡写しを確かめる。torch だけで動く。
+import math
+
+import torch
+
+from gr00t.rl.envs.door.door_mirror import DoorMirror
+from gr00t.rl.envs.door.door_state_sensor import DoorStateSensor, quat_mul_xyzw
+
+DT = 0.02  # 50 Hz（200 Hz の物理 × 4）
+QUIET = {  # 雑音・片寄り・欠けを全部 0 にした計測器
+    "angle_noise_deg": 0.0, "angle_bias_deg": 0.0, "dropout": 0.0, "dropout_near_hand": 0.0,
+    "loc_pos_bias_m": 0.0, "loc_pos_noise_m": 0.0, "loc_yaw_bias_deg": 0.0, "loc_yaw_noise_deg": 0.0,
+    "geometry_noise_m": 0.0,
+}
+
+
+def make(n=4, **cfg):
+    c = dict(QUIET)
+    c.update(cfg)
+    s = DoorStateSensor(n, "cpu", DT, c)
+    s.reset(torch.arange(n))
+    return s
+
+
+def run(s, angles, visible=True, near=False):
+    n = s.num_envs
+    vis = torch.full((n,), visible, dtype=torch.bool)
+    nh = torch.full((n,), near, dtype=torch.bool)
+    out = []
+    for a in angles:
+        s.step(torch.full((n,), float(a)), vis, nh)
+        out.append(s.door_angle_obs().clone())
+    return torch.stack(out)  # [T, N, 3]
+
+
+def test_rate_and_latency():
+    s = make()
+    assert s.period == 5 and s.lag == 5  # 10 Hz・0.1 s
+    angles = [0.01 * t for t in range(40)]
+    obs = run(s, angles)
+    held = obs[:, :, 0]
+    # 値が変わるのは 5 ステップに 1 回だけ（台ごとに位相は違う）
+    for e in range(s.num_envs):
+        changes = (held[6:, e] != held[5:-1, e]).sum().item()
+        assert 5 <= changes <= 7, changes
+    # 測った値は 5 ステップ前の真の角度（最初の 1 ステップは初め直し）
+    for t in range(6, 40):
+        for e in range(s.num_envs):
+            if t > 0 and held[t, e] != held[t - 1, e]:
+                assert math.isclose(held[t, e].item(), angles[t - 5], abs_tol=1e-6)
+
+
+def test_first_step_initialises_to_current_angle():
+    s = make(angle_bias_deg=0.0)
+    obs = run(s, [0.3])
+    assert torch.allclose(obs[0, :, 0], torch.full((4,), 0.3))
+    assert torch.all(obs[0, :, 1] == 1.0)
+
+
+def test_not_visible_keeps_old_value_and_ages():
+    s = make()
+    run(s, [0.2] * 10)
+    obs = run(s, [0.5] * 80, visible=False)
+    assert torch.allclose(obs[-1, :, 0], torch.full((4,), 0.2))
+    assert torch.all(obs[-1, :, 1] == 0.0)
+    assert torch.allclose(obs[-1, :, 2], torch.ones(4))  # 1 s で頭打ち
+    obs = run(s, [0.5] * 10)
+    assert torch.allclose(obs[-1, :, 0], torch.full((4,), 0.5))
+    assert torch.all(obs[-1, :, 1] == 1.0)
+    assert torch.allclose(obs[-1, :, 2], torch.full((4,), s.lag * DT / 1.0), atol=4 * DT)
+
+
+def test_dropout_near_hand_is_more_frequent():
+    n = 4000
+    s = make(n=n, dropout=0.05, dropout_near_hand=0.3)
+    far = run(s, [0.1] * 6)[-1, :, 1]  # 1 ステップ目は初め直し。その後の 5 ステップで全台がちょうど 1 回測る
+    s2 = make(n=n, dropout=0.05, dropout_near_hand=0.3)
+    near = run(s2, [0.1] * 6, near=True)[-1, :, 1]
+    assert abs((1 - far.mean().item()) - 0.05) < 0.02
+    assert abs((1 - near.mean().item()) - 0.3) < 0.03
+
+
+def test_bias_is_fixed_within_an_episode_and_resampled_on_reset():
+    s = make(n=2000, angle_bias_deg=2.0)
+    a = run(s, [0.0] * 12)[-1, :, 0]
+    b = run(s, [0.0] * 12)[-1, :, 0]
+    assert torch.allclose(a, b)  # 同じ回の中では変わらない
+    assert a.abs().max().item() <= math.radians(2.0) + 1e-6
+    assert a.std().item() > math.radians(0.8)  # ±2° の一様 → σ 約 1.15°
+    s.reset(torch.arange(2000))
+    c = run(s, [0.0] * 12)[-1, :, 0]
+    assert not torch.allclose(a, c)
+
+
+def test_reset_step_with_env_ids_only_touches_those_envs():
+    s = make()
+    run(s, [0.2] * 10)
+    s.reset(torch.tensor([1]))
+    s.step(torch.full((4,), 0.7), env_ids=torch.tensor([1]))
+    obs = s.door_angle_obs()
+    assert math.isclose(obs[1, 0].item(), 0.7, abs_tol=1e-6)
+    assert math.isclose(obs[0, 0].item(), 0.2, abs_tol=1e-6)
+    assert bool(s.needs_init[1])  # 次の step でもう一度初め直す
+
+
+def test_localize_without_noise_is_identity_and_yaw_bias_rotates():
+    s = make()
+    pos = torch.tensor([[1.0, 0.5, 0.0]] * 4)
+    rot = torch.tensor([[0.0, 0.0, 0.0, 1.0]] * 4)
+    p, q = s.localize(pos, rot)
+    assert torch.allclose(p, pos) and torch.allclose(q, rot)
+    s.loc_yaw_bias[:] = math.radians(90.0)
+    p, q = s.localize(pos, rot)
+    assert torch.allclose(p, torch.tensor([[-0.5, 1.0, 0.0]] * 4), atol=1e-6)
+    assert torch.allclose(q, torch.tensor([[0.0, 0.0, math.sin(math.pi / 4), math.cos(math.pi / 4)]] * 4), atol=1e-6)
+
+
+def test_quat_mul_matches_composition_of_yaws():
+    def qz(a):
+        return torch.tensor([[0.0, 0.0, math.sin(a / 2), math.cos(a / 2)]])
+    assert torch.allclose(quat_mul_xyzw(qz(0.3), qz(0.4)), qz(0.7), atol=1e-6)
+
+
+def test_geometry_drops_weight_and_keeps_direction():
+    s = make()
+    info = torch.tensor([[0.9, 2.0, 1.0, 0.064, 0.8, 1.0, 0.0, 1.0]] * 4)
+    g = s.geometry(info)
+    assert g.shape == (4, 7)
+    assert torch.allclose(g, torch.tensor([[0.9, 2.0, 1.0, 0.064, 1.0, 0.0, 1.0]] * 4))
+
+
+def test_sensor_does_not_touch_the_global_rng():
+    torch.manual_seed(123)
+    expected = torch.rand(3)
+    torch.manual_seed(123)
+    s = DoorStateSensor(8, "cpu", DT)
+    s.reset(torch.arange(8))
+    run(s, [0.1] * 20)
+    s.localize(torch.zeros(8, 3), torch.tensor([[0.0, 0.0, 0.0, 1.0]] * 8))
+    assert torch.allclose(torch.rand(3), expected)
+
+
+def test_new_terms_mirror():
+    from test_door_mirror import DOF_NAMES, LEFT_ARM, RIGHT_ARM
+
+    m = DoorMirror(DOF_NAMES, LEFT_ARM, RIGHT_ARM)
+    loc = torch.randn(4, 9)
+    assert torch.allclose(m.obs("door_frame_loc", m.obs("door_frame_loc", loc)), loc)
+    assert torch.allclose(m.obs("door_frame_loc", loc)[:, 1::3], -loc[:, 1::3])
+    geo = torch.tensor([[0.9, 2.0, 1.0, 0.064, 1.0, 0.0, 1.0], [1.0, 2.1, 0.9, 0.1, -1.0, 2.0, 1.0]])
+    mg = m.obs("door_geometry", geo)
+    assert torch.allclose(mg[:, :4], geo[:, :4]) and torch.allclose(mg[:, 6], geo[:, 6])
+    assert torch.allclose(mg[:, 4], -geo[:, 4]) and torch.allclose(mg[:, 5], 1.0 - mg[:, 4])
+    assert torch.allclose(m.obs("door_geometry", mg), geo)
+    ang = torch.randn(4, 3)
+    assert torch.equal(m.obs("door_angle_lidar", ang), ang)  # 左右の無い項目
