@@ -0,0 +1,302 @@
+# @package _global_
+# G1_Hackason 段 2.5: 指の無い G1 29 関節の「状態入力の生徒」（DAgger）の観測。映像は使わない。
+# door_open_homie_29dof_dagger.yaml（カメラ付きの生徒）から作った:
+#   - teacher_obs = 教師の actor_obs そのまま（並び・倍率・雑音も教師と同じ。教師のチェックポイントに合わせるため）
+#   - actor_obs（生徒）= 実機で取れる値だけ: 関節の角度と速度・IMU（傾き・角速度）・前回の行動・HOMIE への指令・終わったか
+#     ＋ door_angle_lidar（頭の LiDAR で測った扉の角度・測れたか・古さ）・door_frame_loc（地図と測位で求めた枠の位置）・
+#     door_geometry（巻き尺で測る扉の寸法と向き。重さは無い）。後の 3 つは door_state_sensor.py が雑音・遅れ・欠けを入れる
+#   - 関節は dof_pos・dof_vel（29 関節では dof_*_non_finger と同じ値）を使う。鏡写し（door_mirror.py）がこの名前で効くため
+#   - vision_obs（RGB）は外した
+
+# Be careful when using _raw, history
+obs:
+  obs_dict:
+    actor_obs: [
+      base_ang_vel,
+      projected_gravity,
+      dof_pos,
+      dof_vel,
+      actions,
+      delta_actions,
+
+      b_homie_commands,
+      complete,
+
+      door_angle_lidar,
+      door_frame_loc,
+      door_geometry
+    ]
+
+    gt_obj_pos: [
+      target_obj_pos,
+    ]
+
+    teacher_obs: [
+      dof_pos,
+      relative_to_door,
+      dof_vel,
+      actions,
+      projected_gravity,
+      door_dof_pos,
+      base_lin_vel,
+      base_ang_vel,
+      hand_force,
+      stage,
+      privileged_door_info,
+      delta_actions,
+      hand_handle_transform,
+      unwarped_actions,
+
+      b_homie_commands
+    ]
+
+    critic_obs: [
+      dof_pos,
+      relative_to_door,
+      dof_vel,
+      actions,
+      projected_gravity,
+      door_dof_pos,
+      base_lin_vel,
+      base_ang_vel,
+      hand_force,
+      stage,
+      privileged_door_info,
+      delta_actions,
+      hand_handle_transform,
+      unwarped_actions,
+
+      transition,
+      complete,
+
+      time_in_stage,
+      actual_time_in_stage,
+      total_time,
+
+      b_homie_commands
+    ]
+
+    homie_obs: [
+      a_history_homie,
+      b_homie_commands,
+      c_homie_base_ang_vel,
+      d_homie_projected_gravity,
+      # homie_torso_ang_vel,
+      # homie_torso_projected_gravity,
+      e_homie_dof_pos,
+      f_homie_dof_vel,
+      g_homie_body_actions,
+      # homie_clock_inputs,
+    ]
+
+  # define those coumpounds in obs_dict, for example, you can define different long/short history with different length
+  obs_auxiliary: 
+    history_long: {
+      dof_pos: 20,
+      relative_to_door: 20,
+      dof_vel: 2,
+      actions: 15,
+      projected_gravity: 15,
+      door_dof_pos: 15,
+      base_lin_vel: 15,
+      base_ang_vel: 15,
+      hand_force: 15,
+      stage: 15,
+      privileged_door_info: 15,
+      delta_actions: 15,
+      hand_handle_transform: 15,
+
+      transition: 15,
+      complete: 15,
+
+      time_in_stage: 15,
+      actual_time_in_stage: 15,
+    }
+
+    a_history_homie: {
+      b_homie_commands: 5,
+      c_homie_base_ang_vel: 5,
+      d_homie_projected_gravity: 5,
+      # homie_torso_ang_vel: 5,
+      # homie_torso_projected_gravity: 5,
+      e_homie_dof_pos: 5,
+      f_homie_dof_vel: 5,
+      g_homie_body_actions: 5,
+      # homie_clock_inputs: 5,
+    }
+
+    history_short: {
+      dof_pos: 3,
+      relative_to_door: 3,
+      dof_vel: 2,
+      actions: 1,
+      projected_gravity: 1,
+      door_dof_pos: 2,
+      base_lin_vel: 2,
+      base_ang_vel: 2,
+      hand_force: 2,
+      stage: 2,
+      privileged_door_info: 2,
+      delta_actions: 2,
+      hand_handle_transform: 2,
+
+      transition: 2,
+      complete: 2,
+
+      time_in_stage: 2,
+      actual_time_in_stage: 2,
+    }
+
+  homie_history_length: 5
+
+  obs_scales: {
+    dof_pos: 1.0,
+    relative_to_door: 1.0,
+    dof_vel: 0.05,
+    history: 1.0,
+    actions: 1.0,
+    projected_gravity: 1.0,
+    door_dof_pos: 1.0,
+    base_lin_vel: 1.0,
+    base_ang_vel: 0.5,
+    hand_force: 0.01,
+    stage: 1.0,
+    privileged_door_info: 1.0,
+    delta_actions: 1.0,
+    hand_handle_transform: 1.0,
+    unwarped_actions: 1.0,
+    door_angle_lidar: 1.0,
+    door_frame_loc: 1.0,
+    door_geometry: 1.0,
+    dof_vel_non_finger: 0.05,
+    dof_pos_non_finger: 1.0,
+    target_obj_pos: 1.0,
+
+    transition: 1.0,
+    complete: 1.0,
+
+    time_in_stage: 1.0,
+    actual_time_in_stage: 1.0,
+    total_time: 1.0,
+
+    b_homie_commands: 1.0,
+    e_homie_dof_pos: 1.0,
+    f_homie_dof_vel: 0.05,
+    c_homie_base_ang_vel: 0.5,
+    d_homie_projected_gravity: 1.0,
+    # homie_torso_ang_vel: 0.5,
+    # homie_torso_projected_gravity: 1.0,
+    g_homie_body_actions: 1.0,
+    # homie_clock_inputs: 1.0,
+    a_history_homie: 1.0
+  }
+
+  noise_scales: {
+    dof_pos: 0.01,
+    relative_to_door: 0.0,
+    dof_vel: 0.2,
+    history: 0.0,
+    actions: 0.0,
+    projected_gravity: 0.0,
+    door_dof_pos: 0.0,
+    base_lin_vel: 0.0,
+    base_ang_vel: 0.0,
+    hand_force: 0.0,
+    stage: 0.0,
+    privileged_door_info: 0.0,
+    delta_actions: 0.0,
+    hand_handle_transform: 0.0,
+    unwarped_actions: 0.0,
+    door_angle_lidar: 0.0,  # 雑音は door_state_sensor.py が入れる
+    door_frame_loc: 0.0,
