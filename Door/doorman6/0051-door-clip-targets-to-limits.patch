From af2b203de224b1c96db35d4868eb475641c9a16f Mon Sep 17 00:00:00 2001
From: g1-door <g1-door@local>
Date: Fri, 16 Oct 2026 13:46:55 +0900
Subject: [PATCH] door: optional clip of joint targets to the joint limits
 (stage 5)

---
 gr00t/rl/envs/base_task/finger_primitive_base.py | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/gr00t/rl/envs/base_task/finger_primitive_base.py b/gr00t/rl/envs/base_task/finger_primitive_base.py
index 077bd1c..9376ded 100644
--- a/gr00t/rl/envs/base_task/finger_primitive_base.py
+++ b/gr00t/rl/envs/base_task/finger_primitive_base.py
@@ -87,6 +87,16 @@ class FingerPrimitiveBase(LeggedRobotBase):
                 actions_scaled[:, : self._num_non_primitive_dof]
                 + self.default_dof_pos[:, : self._num_non_primitive_dof]
             )
+            # G1_Hackason（段 5）: 実機では関節の目標を可動域の内側に切る（端の止めに全力で押し付けないため）。
+            # 同じ切り方をシミュレータでも掛けて、成功率への効き目を測る。margin [rad] は可動域の端から内側への余裕。既定 None＝切らない
+            margin = self.config.get("clip_targets_to_limits_margin", None)
+            if margin is not None:
+                lim = self.simulator.hard_dof_pos_limits[: self._num_non_primitive_dof]
+                combined_target[:, : self._num_non_primitive_dof] = torch.clamp(
+                    combined_target[:, : self._num_non_primitive_dof],
+                    min=lim[:, 0] + float(margin),
+                    max=lim[:, 1] - float(margin),
+                )
             for i, primitive_cfg in enumerate(self._primitive_action_map):
                 inheritrange = primitive_cfg["inheritrange"]
                 p0 = primitive_cfg["pos_0"]
-- 
