 create mode 100644 gr00t/rl/data/tasks/door_en1154_g4g5_82/scenario_cfg/isaacsim.py

diff --git a/gr00t/rl/data/tasks/door_en1154_g4g5_82/scenario_cfg/isaacsim.py b/gr00t/rl/data/tasks/door_en1154_g4g5_82/scenario_cfg/isaacsim.py
