@@ -1538,11 +1548,60 @@ class DoorPregrasp(
             hinge_angle = self.simulator.scene.articulations["door"].data.joint_pos.torch[:, 0]
             self.reset_buf |= hinge_angle > hold_open_angle_deg * torch.pi / 180.0
 
