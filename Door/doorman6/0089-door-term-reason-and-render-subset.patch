+            self._note_term_reason(base_reset, dof_overspeed & not_just_resetted)
+
         # reset if the homie command is too large when grasping or opening the door
         # is_grasping_or_opening = (self.stage_buf == DoorPregrasp.STAGE_GRASP) | (self.stage_buf == DoorPregrasp.STAGE_OPEN)
         # homie_command_norm = torch.norm(self.get_physical_homie_commands()[:, :3], dim=1)
         # self.reset_buf |= (homie_command_norm > self.termination_level) & is_grasping_or_opening
 
+    # G1_Hackason（パッチ 0089）: 回が終わった理由のビット。1 つの回で複数立つことがある
+    TERM_OVERTIME = 1  # 段階の持ち時間切れ
+    TERM_TIMEOUT = 2  # 完了（reset_on_complete の遅れの後）か、回の長さの上限
+    TERM_BASE = 4  # 上の 2 つ以外の土台の打ち切り（この設定では胴が低すぎる＝倒れだけ）
+    TERM_FAR = 8  # 扉から 4 m より遠い
+    TERM_OVERSPEED = 16  # 上半身（指を除く）の関節の速さが termination_level × 20 rad/s を越えた
+    TERM_HOLD_OPEN = 32  # 扉が door_hold_open_angle_deg に届いた
+
+    def _note_term_reason(self, base_reset, overspeed):
+        """G1_Hackason（パッチ 0089、11-02）: この歩で回が終わった台に、理由のビット・段階・上半身の関節の速さの最大と
+        その関節の番号を残す。記録（state_recorder）は回が終わった歩を写さず、戻された後の姿を次の行に書くので、
+        次に終わるまで値を持ち越す。判定は変えない（_check_termination が記録するときだけ呼ぶ）
+
+        base_reset: 土台と段階の _check_termination が立てた打ち切り（扉の 3 つの条件の前）
+        overspeed: この歩の関節の速さの打ち切り（最初の 20 歩を除いた後）"""
+        ended = self.reset_buf.bool()  # 整数（0/1）の入れ物なので真偽にしてから台を選ぶ
+        if not bool(ended.any()):
+            return
+        # 段階の持ち時間切れは staged_task_base と同じ式（最後の段階で完了しているときは数えない）
+        is_last = self.stage_buf == self.num_stages - 1
+        is_complete = self.stage_complete_cond_func() & (self.episode_length_buf >= 2)
+        overtime = (self.time_in_stage_buf >= self.max_stage_time[self.stage_buf]) & ~(is_last & is_complete)
+        timeout = self.time_out_buf.bool()
+        base = base_reset & ~overtime & ~timeout
+        far = self.relative_door_pos_buf.norm(dim=-1) > 4.0
+        hold_open = torch.zeros_like(ended)
+        hold_open_angle_deg = self.config.get("door_hold_open_angle_deg", None)
+        if hold_open_angle_deg is not None:
+            hinge_angle = self.simulator.scene.articulations["door"].data.joint_pos.torch[:, 0]
+            hold_open = hinge_angle > hold_open_angle_deg * torch.pi / 180.0
+        bits = (
+            overtime.int() * self.TERM_OVERTIME
+            + timeout.int() * self.TERM_TIMEOUT
+            + base.int() * self.TERM_BASE
+            + far.int() * self.TERM_FAR
+            + overspeed.int() * self.TERM_OVERSPEED
+            + hold_open.int() * self.TERM_HOLD_OPEN
+        )
+        upper_idx = torch.tensor(self._upper_non_finger_dof_idx, device=self.device)
+        vel_max, arg = torch.abs(self.simulator.dof_vel[:, upper_idx]).max(dim=-1)
+        self.term_reason_buf[ended] = bits[ended].float()
+        self.term_stage_buf[ended] = self.stage_buf[ended].float()
+        self.term_upper_vel_buf[ended] = vel_max[ended]
+        self.term_upper_joint_buf[ended] = upper_idx[arg][ended].float()
+        self.term_count_buf[ended] += 1
+
     @property
     def ground_height(self):
         return 0.0
