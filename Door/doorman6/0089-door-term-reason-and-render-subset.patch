@@ -0,0 +1,14 @@
+# G1_Hackason（パッチ 0089、11-02）: 評価の動画を選んだ台だけ書く（simulator.config.render_env_ids）。
+# 256 台の評価のまま、失敗した台だけを Isaac Sim の画で見るため。Isaac Lab 3.0 のカメラは台の数だけ要るので、
+# 描くのは全部の台のままで、書く動画を絞る。動画の名前は台の番号のまま
+
+
+def render_view_env_ids(render_env_ids, num_envs: int) -> list[int]:
+    """動画を書く台の番号（小さい順・重なりなし）。render_env_ids が空なら全部の台（元のまま）"""
+    if not render_env_ids:
+        return list(range(num_envs))
+    ids = sorted({int(i) for i in render_env_ids})
+    bad = [i for i in ids if not 0 <= i < num_envs]
+    if bad:
+        raise ValueError(f"render_env_ids に台の数（{num_envs}）の外の番号がある: {bad}")
+    return ids
