+    def _load_prelude_policy(self):
+        """G1_Hackason（0109、11-12）: 前座の方策（prelude_policy_path。凍らせた腕だけの段の方策）。env.arm_handover_buf が立つまで
+        （arm_stage.handover_door_deg に扉が届くまで）の行動をこの方策の平均に替える。学ぶ方策（教師の続き）はその後だけを受け持つ。
+        学習でも評価でも同じ。無ければ None"""
+        if getattr(self, "_prelude_loaded", False):
+            return self._prelude
+        self._prelude_loaded = True
+        self._prelude = None
+        path = self.config.get("prelude_policy_path", None)
+        if not path:
+            return None
+        import copy
+
+        policy = copy.deepcopy(self.accelerator.unwrap_model(self.model).policy)
+        checkpoint = torch.load(path, map_location=self.accelerator.device, weights_only=False)
+        key = "actor_model_state_dict" if "actor_model_state_dict" in checkpoint else "policy_state_dict"
+        policy.load_state_dict(checkpoint[key])
+        policy.eval_mode()
+        policy.init_rollout()
+        for prm in policy.parameters():
+            prm.requires_grad_(False)
+        if not hasattr(self.env, "arm_handover_buf"):
+            raise RuntimeError("[prelude] env.arm_handover_buf が無い（arm_stage.enabled と handover_door_deg が要る）")
+        self._prelude = policy
+        self._prelude_steps = 0
+        self._prelude_pre = 0
+        print(f"[prelude] 前座の方策 {path}（arm_handover_buf が立つまでの行動を替える）")
+        return policy
+
+    def _prelude_swap(self, prelude, obs_dict, actions, cur_dones=None):
+        """前座の方策を 1 歩回し、まだ引き継いでいない台の行動（方策の列だけ）をその平均に替えた写しを返す"""
+        prelude.rollout(obs_dict=deepcopy(obs_dict), cur_dones=cur_dones)
+        pre = ~self.env.arm_handover_buf.to(actions.device)
+        mean = prelude.action_mean.detach()
+        n = mean.shape[-1]
+        out = actions.clone()
+        out[:, :n] = torch.where(pre[:, None], mean, out[:, :n])
+        self._prelude_steps += int(pre.numel())
+        self._prelude_pre += int(pre.sum())
+        if self._prelude_steps >= 5_000_000:  # たまに、前座が動かした歩の割合を出す
+            print(f"[prelude] 前座が動かした歩 {100.0 * self._prelude_pre / self._prelude_steps:.1f}%", flush=True)
+            self._prelude_steps = 0
+            self._prelude_pre = 0
+        return out
+
