+    def _cap_shoulder_roll_press(self, combined_target: torch.Tensor, max_nm: float) -> torch.Tensor:
+        """左右の肩 roll の目標を、今の角度から胴の側へ max_nm / kp までに切る（kp は設定の固さ。実機と同じく公称の値）"""
+        if not hasattr(self, "_roll_press_idx"):
+            names = list(self.config.robot.dof_names)
+            self._roll_press_idx = torch.tensor(
+                [names.index(LEFT_SHOULDER_ROLL), names.index(RIGHT_SHOULDER_ROLL)], device=self.device
+            )
+            self._roll_press_inward = torch.tensor(ROLL_INWARD, device=self.device)
+        idx = self._roll_press_idx
+        out = combined_target.clone()
+        out[:, idx] = cap_toward(
+            combined_target[:, idx], self.simulator.dof_pos[:, idx], self.p_gains[idx], self._roll_press_inward, max_nm
+        )
+        return out
+
     def _arm_rate_limit_mask(self) -> torch.Tensor:
