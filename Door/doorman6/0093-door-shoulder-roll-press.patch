@@ -686,6 +696,18 @@ class LeggedRobotBase(BaseTask):
         self.log_dict["arm_body_contact_peak"] = mon.contact_peak.max()
         return hit.float().sum(dim=-1)
 
+    def _reward_penalty_shoulder_roll_press(self):
+        """T1（11-06）: 肩 roll が胴の側へ出した力 [N·m] の 2 乗の和（左右）の、物理の回の平均。モーターの熱は力の 2 乗で増える
+        （実機の 11-04 の測り: 左肩 roll の温度の上がり ≒ 0.0197 × ∫τ²dt）。胴から離す側の力は数えない"""
+        mon = getattr(self, "_substep_monitor", None)
+        if mon is None:
+            return torch.zeros(self.num_envs, device=self.device)
+        sq = mon.roll_press_sq_mean()
+        self.log_dict["shoulder_roll_press_rms"] = (sq.mean() / 2.0).sqrt()
+        self.log_dict["shoulder_roll_press_peak"] = mon.roll_press_peak.max()
+        self.log_dict["shoulder_roll_press_over3_frac"] = (mon.roll_press_peak > 3.0).float().mean()
+        return sq
+
     def _compute_perturbation_forces(self):
         """
         Should be implemented in the child class if needed.
