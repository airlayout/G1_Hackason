diff --git a/gr00t/rl/envs/base_task/roll_press.py b/gr00t/rl/envs/base_task/roll_press.py
new file mode 100644
index 0000000..1a6e8b6
--- /dev/null
+++ b/gr00t/rl/envs/base_task/roll_press.py
@@ -0,0 +1,28 @@
+"""肩 roll の胴への押し当てを切る（G1_Hackason の T1、2026-11-06）。
+
+11-06 の実機で、方策は DOOR の 1.5 秒から左肩 roll を胴の中へ送り続け、腕は胴に当たって止まり、
+積み上げの範囲いっぱい（δ 0.2 rad × kp 100 = 20 N·m）で押し続けて 6 秒で 45 → 88 °C になった。
+実機は送る目標を切って胴へ押す力を 6 N·m までにした（G1_Hackason/Door/real/door_run_stock.cap_roll_press）。
+シミュレータにも同じ切り方を入れ、その条件で学び直す。numpy の配列と torch の tensor のどちらでも動く書き方だけを使う。
+"""
+
+LEFT_SHOULDER_ROLL = "left_shoulder_roll_joint"
+RIGHT_SHOULDER_ROLL = "right_shoulder_roll_joint"
+ROLL_INWARD = (-1.0, 1.0)  # 胴へ向かう向き: 左は負・右は正（door_run_stock.ARM_ROLL_INWARD と同じ）
+
+
+def cap_toward(target, q, kp, inward, max_nm):
+    """目標を、inward の向きへ押す力 kp·(目標 − 角度) が max_nm を越えない所まで戻した写し。
+
+    inward は要素ごとに ±1。反対の向き（胴から離す側）は切らない。入力は書き換えない。
+    target・q: [..., k]、kp・inward: [k]（後ろの次元で揃う形なら何でも）
+    """
+    lim = q + inward * max_nm / kp
+    st = inward * target
+    sl = inward * lim
+    return inward * (st - (st - sl).clip(0, None))  # inward·min(inward·目標, inward·限り)
+
+
+def press_toward(torque, inward):
+    """inward の向きへ出した力だけ（反対の向きは 0）"""
+    return (inward * torque).clip(0, None)
diff --git a/gr00t/rl/envs/base_task/substep_monitor.py b/gr00t/rl/envs/base_task/substep_monitor.py
index 9e84e5a..4cad0ce 100644
--- a/gr00t/rl/envs/base_task/substep_monitor.py
+++ b/gr00t/rl/envs/base_task/substep_monitor.py
@@ -14,14 +14,28 @@ class SubstepMonitor:
         self.ratio = float(saturation_ratio)
         self.sat_count = torch.zeros(num_envs, num_arm, device=device)
         self.contact_peak = torch.zeros(num_envs, max(num_contact_bodies, 0), device=device)
+        # T1（11-06）: 肩 roll が胴の側へ出した力の 2 乗の和（左右）と、その最大 [N·m]
+        self.roll_press_sq = torch.zeros(num_envs, device=device)
+        self.roll_press_peak = torch.zeros(num_envs, device=device)
         self.n = 0
 
     def begin(self) -> None:
         """制御の 1 ステップの始め（物理 1 回目の前）に数え直す"""
         self.sat_count.zero_()
         self.contact_peak.zero_()
+        self.roll_press_sq.zero_()
+        self.roll_press_peak.zero_()
         self.n = 0
 
+    def add_roll_press(self, press: torch.Tensor) -> None:
+        """物理 1 回の後（after_substep より前に呼ぶ）。press [N, 2] は胴の側へ出した力（反対の向きは 0）"""
+        self.roll_press_sq += (press**2).sum(dim=-1)
+        self.roll_press_peak = torch.maximum(self.roll_press_peak, press.amax(dim=-1))
+
+    def roll_press_sq_mean(self) -> torch.Tensor:
+        """[N] 物理の回で平均した、肩 roll の胴への力の 2 乗の和（左右）"""
+        return self.roll_press_sq / max(self.n, 1)
+
     def after_substep(self, arm_torque: torch.Tensor, arm_limit: torch.Tensor, contact_force=None) -> None:
         """物理 1 回の後。arm_torque [N, 腕]・arm_limit [腕]・contact_force [N, 部品]（無ければ None）"""
         self.sat_count += (arm_torque.abs() >= self.ratio * arm_limit).float()
