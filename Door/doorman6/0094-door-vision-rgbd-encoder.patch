 IMAGENET_MEAN = (0.485, 0.456, 0.406)
 IMAGENET_STD = (0.229, 0.224, 0.225)
 
+# 11-06（カラー＋深度、計画 docs/plan/2026-11-06-g1-door-depth-rl.md）: 深度はカラーと同じカメラ・同じ画角（69°×42°）で描き、
+# 縦横 1/2 に間引いて 54×96 で使う（実機は D435i の深度 87°×58° の中央を切り出して同じ形にする）。単位は m、測れない所は 0
+DEPTH_MAX = 3.0  # これより遠い所は 3 m に詰める（扉の課題で要るのは 0.2〜2.5 m）
+DEPTH_STRIDE = 2  # 108×192 → 54×96
 
+
+def depth_clean(depth: torch.Tensor) -> torch.Tensor:
+    """描いた深度 [..., H, W] の無限・非数を 0（測れない）にし、DEPTH_MAX で詰める。間引き（DEPTH_STRIDE）もここでする"""
+    d = depth[..., ::DEPTH_STRIDE, ::DEPTH_STRIDE].float()
+    d = torch.where(torch.isfinite(d), d, torch.zeros_like(d))
+    return d.clamp(0.0, DEPTH_MAX)
+
+
+def depth_noise(d: torch.Tensor, gen: torch.Generator | None = None) -> torch.Tensor:
+    """深度 [B, H, W]（m・0 は測れない）に、D435 の型の揺れと欠けを足した写し（実物の深度を録るまでの仮の型。D1 で合わせ直す）。
+    - 1 枚ごとの尺度の片寄り ±1%（σ）・画素ごとの揺れ σ = 3 mm + 8 mm × (距離 m)²（2 m で 3.5 cm）
+    - 最短距離（1 枚ごとに 0.17〜0.30 m）より近い所は欠ける
+    - 奥行きが跳ぶ縁（隣と 5 cm 以上の差）の 7 割が欠ける（投光器の影と縁の誤対応）
+    - 画素ごとの欠け 0〜3%・四角い欠けの塊 0〜3 個（暗い面・金属のつや）"""
+    b, h, w = d.shape
+    dev = d.device
+
+    def u(lo, hi, *shape):
+        return torch.rand(*shape, device=dev, generator=gen) * (hi - lo) + lo
+
+    valid = d > 0
+    out = d * (1.0 + 0.01 * torch.randn(b, 1, 1, device=dev, generator=gen))
+    out = out + torch.randn(d.shape, device=dev, generator=gen) * (0.003 + 0.008 * d**2)
+    drop = out < u(0.17, 0.30, b, 1, 1)
+    gx = torch.zeros_like(d, dtype=torch.bool)
+    gx[:, :, 1:] = (d[:, :, 1:] - d[:, :, :-1]).abs() > 0.05
+    gy = torch.zeros_like(d, dtype=torch.bool)
+    gy[:, 1:, :] = (d[:, 1:, :] - d[:, :-1, :]).abs() > 0.05
+    drop |= (gx | gy) & (torch.rand(d.shape, device=dev, generator=gen) < 0.7)
+    drop |= torch.rand(d.shape, device=dev, generator=gen) < u(0.0, 0.03, b, 1, 1)
+    yy = torch.arange(h, device=dev)[None, :, None]
+    xx = torch.arange(w, device=dev)[None, None, :]
+    for _ in range(3):
+        on = torch.rand(b, 1, 1, device=dev, generator=gen) < 0.5
+        bh = u(2, h / 4, b, 1, 1)
+        bw = u(2, w / 4, b, 1, 1)
+        y0 = u(0, h, b, 1, 1)
+        x0 = u(0, w, b, 1, 1)
+        drop |= on & (yy >= y0) & (yy < y0 + bh) & (xx >= x0) & (xx < x0 + bw)
+    out = torch.where(valid & ~drop, out, torch.zeros_like(out))
+    return out.clamp(0.0, DEPTH_MAX)
+
+
+def depth_input(d: torch.Tensor) -> torch.Tensor:
+    """深度 [B, H, W]（m）→ 深度の枝の入力 [B, 2, H, W]（距離 / DEPTH_MAX と、測れた所の 1）"""
+    return torch.stack([d / DEPTH_MAX, (d > 0).float()], dim=1)
+
+
+class DepthBranch(nn.Module):
+    """深度の枝: [B, 2, 54, 96] → [B, 256]。小さな CNN を最初から学ぶ（ImageNet の重みは深度に向かない）。
+    最後は平均で潰さず並びのまま平らにする（画面の中の位置が扉の位置の手掛かり）"""
+
+    def __init__(self, out_dim: int = 256, in_hw: tuple[int, int] = (54, 96)):
+        super().__init__()
+        self.conv = nn.Sequential(
+            nn.Conv2d(2, 32, 5, stride=2, padding=2), nn.ELU(),
+            nn.Conv2d(32, 64, 3, stride=2, padding=1), nn.ELU(),
+            nn.Conv2d(64, 64, 3, stride=2, padding=1), nn.ELU(),
+            nn.Conv2d(64, 32, 1), nn.ELU(),
+        )
+        with torch.no_grad():
+            n = self.conv(torch.zeros(1, 2, *in_hw)).numel()
+        self.fc = nn.Sequential(nn.Linear(n, out_dim), nn.ELU())
+        self.out_dim = out_dim
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return self.fc(self.conv(x).flatten(1))
+
