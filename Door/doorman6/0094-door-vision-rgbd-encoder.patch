+class DoorRGBDEncoder(nn.Module):
+    """11-06: カラー [N, H, W, 3]（uint8）と深度 [N, H/2, W/2]（m）→ 特徴 [N, feat_dim]。
+    カラーの枝は ResNet18（ImageNet で学習済み）→ 512、深度の枝は DepthBranch → 256。つないで線形＋LayerNorm。
+    color_off [N]（bool）の台はカラーの枝の出力を 0 にする（カラーを落とす練習。シミュレータで網がカラーだけに頼らないように）"""
+
+    uses_depth = True
+
+    def __init__(self, feat_dim: int = 128, pretrained: bool = True):
+        super().__init__()
+        import torchvision
+
+        weights = torchvision.models.ResNet18_Weights.IMAGENET1K_V1 if pretrained else None
+        r = torchvision.models.resnet18(weights=weights)
+        self.trunk = nn.Sequential(*list(r.children())[:-1])  # → [N, 512, 1, 1]
+        self.depth = DepthBranch()
+        self.proj = nn.Linear(512 + self.depth.out_dim, feat_dim)
+        self.norm = nn.LayerNorm(feat_dim)
+        self.feat_dim = feat_dim
+        self.register_buffer("img_mean", torch.tensor(IMAGENET_MEAN).view(1, 3, 1, 1))
+        self.register_buffer("img_std", torch.tensor(IMAGENET_STD).view(1, 3, 1, 1))
+
+    def preprocess(self, rgb_u8: torch.Tensor) -> torch.Tensor:
+        x = rgb_u8[..., :3].permute(0, 3, 1, 2).float() / 255.0
+        return (x - self.img_mean) / self.img_std
+
+    def forward_normalized(self, x_rgb: torch.Tensor, x_depth: torch.Tensor, color_off: torch.Tensor | None = None):
+        c = self.trunk(x_rgb).flatten(1)
+        if color_off is not None:
+            c = torch.where(color_off[:, None], torch.zeros_like(c), c)
+        return self.norm(self.proj(torch.cat([c, self.depth(x_depth)], dim=-1)))
+
+    def forward(self, rgb_u8: torch.Tensor, depth_m: torch.Tensor, color_off: torch.Tensor | None = None):
+        return self.forward_normalized(self.preprocess(rgb_u8), depth_input(depth_m), color_off)
+
