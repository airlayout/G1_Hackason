index 0000000..c8d11b5
--- /dev/null
+++ b/gr00t/rl/utils/hand_links.py
@@ -0,0 +1,26 @@
+# G1_Hackason: 手の剛体名を robot の設定から引く（指の無い G1 29 関節版のため）。
+#
+# 元の DoorMan は剛体名に "left_hand" / "right_hand" を含むものを手として部分一致で集めていた。
+# 29 関節の USD では手（rubber hand）は wrist_yaw_link に統合されていて、この一致では 1 つも見つからない。
+# 設定に次のキーがあればそれを使い、無ければ元の部分一致に戻る（43 関節版の動きは変わらない）。
+#   - hand_contact_body_names: 接触センサの filter に使う手の剛体（並びも filter と同じ）
+#   - left/right_hand_palm_body: palm として位置を取る剛体
+#   - left/right_hand_palm_offset: palm の剛体から見た palm の原点（その剛体の座標系）
+
+LEGACY_PALM_BODY = {"left": "left_hand_palm_link", "right": "right_hand_palm_link"}
+
+
+def hand_contact_body_names(robot_config) -> list[str]:
+    names = robot_config.get("hand_contact_body_names", None)
+    if names:
+        return list(names)
+    return [n for n in robot_config.body_names if ("left_hand" in n or "right_hand" in n)]
+
+
+def palm_body_name(robot_config, side: str) -> str:
+    return robot_config.get(f"{side}_hand_palm_body", None) or LEGACY_PALM_BODY[side]
+
+
+def palm_offset(robot_config, side: str) -> list[float]:
+    offset = robot_config.get(f"{side}_hand_palm_offset", None)
+    return [0.0, 0.0, 0.0] if offset is None else [float(v) for v in offset]
