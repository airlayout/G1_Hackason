<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_cmd_router</name>
  <version>0.1.0</version>
  <description>
    Nav2からの速度指令を安全処理し、SDK側プロセスへIPC送信するSafety Manager /
    Command Routerノード(仕様書7章・8章、Planning.md D-04/D-10/D-14/D-27)。
  </description>
  <maintainer email="noreply@example.com">g1_hackathon</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>diagnostic_msgs</depend>
  <!-- Nav2 Goal のキャンセル用。nav2_msgs ではなく汎用の action_msgs を使うので
       Nav2 が入っていない環境でもビルドできる -->
  <depend>action_msgs</depend>
  <!-- STANDBY→READY のゲートと走行中の鮮度監視(仕様書7章)。どちらも ros-base に
       含まれるので、Nav2 が無い環境でもビルドできる性質は保たれる -->
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
