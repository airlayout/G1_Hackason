<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_navigation</name>
  <version>0.1.0</version>
  <description>
    Nav2設定(costmap/controller/planner)と疑似データでの動作確認用launch
    (Planning.md D-21/D-22/D-23、Phase 2c前倒し検証)。
  </description>
  <maintainer email="noreply@example.com">g1_hackathon</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>g1_cmd_router</exec_depend>
  <exec_depend>g1_state_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
