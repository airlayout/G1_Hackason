# /etc/default/g1-sdk-bridge にこの内容を置く。
# g1-sdk-bridge.service から EnvironmentFile で読まれる。

# G1 の内蔵スイッチ側のインターフェース名
G1_NETWORK_INTERFACE=eth0
G1_DOMAIN_ID=0

# D-27: 送信周期(50ms) < duration <= cmd_timeout を満たすこと。
# 既定の 0.20 秒で歩容が成立することは 2026-09-09 に実機で確認済み。
G1_SDK_DURATION=0.20
G1_CMD_TIMEOUT=0.30

# ⚠️⚠️ **発進ゲート。ここを "--arm" にすると G1 が実際に動くようになる。**
#
# 有効にする前に必ず確認すること:
#   - 人が支えられる位置にいる
#   - 純正リモコンで停止できる状態にある
#   - 前方に 2m 以上の空間がある(指令を止めても約2秒動き続ける。§3.3.1)
#
# 試験が終わったら空に戻すこと。
G1_ARM=
