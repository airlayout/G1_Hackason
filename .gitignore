# Python
__pycache__/
*.py[cod]

# 実行ログ（実行のたびに増えるため管理対象外）
logs/
*.log
# MuJoCo が実行時にカレントディレクトリへ吐くログ（拡張子が .TXT なので *.log に該当しない）
MUJOCO_LOG.TXT

# 学習済み checkpoint（IsaacSim_Env/checkpoints/ は共有のため追跡対象。それ以外の .pt は除外）
*.pt
!IsaacSim_Env/checkpoints/*.pt

# SLAM の作業中に保存した確認用の地図（完成版のみ手動で追加する）
IsaacSim_Env/maps/check*
# スキャンのキャッシュ（40MB 超。再収集できるので追跡しない）
IsaacSim_Env/maps/scans*.npz
IsaacSim_Env/maps/direct*
IsaacSim_Env/maps/projection*
*_preview.png

# G1_HuggingFace/ 配下の外部クローン（それぞれ独自の .git を持つため、
# サブモジュール化を避けてこのリポジトリの追跡対象からは除外する）
G1_HuggingFace/unitree_sdk2_python/
G1_HuggingFace/lerobot/
G1_HuggingFace/cyclonedds/
G1_HuggingFace/venv/

# 実機 Mapping の実行成果物・ローカル設定・配備物
Mapping/real/runs/*
!Mapping/real/runs/.gitkeep
Mapping/real/.env
Mapping/real/dist/
Mapping/real/.mapping-state.json

# このPCだけに置くローカル専用データ（共有しない・再取得できるもの）
_local/
