# Python
__pycache__/
*.py[cod]

# 実行ログ（実行のたびに増えるため管理対象外）
logs/
*.log
# MuJoCo が実行時にカレントディレクトリへ吐くログ（拡張子が .TXT なので *.log に該当しない）
MUJOCO_LOG.TXT

# 学習済み checkpoint（IsaacSim_Env/checkpoints/ は共有のため追跡対象。それ以外の .pt は除外）
*.pt
!IsaacSim_Env/checkpoints/*.pt

# SLAM の作業中に保存した確認用の地図（完成版のみ手動で追加する）
IsaacSim_Env/maps/check*
# スキャンのキャッシュ（40MB 超。再収集できるので追跡しない）
IsaacSim_Env/maps/scans*.npz
IsaacSim_Env/maps/direct*
IsaacSim_Env/maps/projection*
*_preview.png

# G1_HuggingFace/ 配下の外部クローン（それぞれ独自の .git を持つため、
# サブモジュール化を避けてこのリポジトリの追跡対象からは除外する）
G1_HuggingFace/unitree_sdk2_python/
G1_HuggingFace/lerobot/
G1_HuggingFace/cyclonedds/
G1_HuggingFace/venv/

# 実機 Mapping の実行成果物・ローカル設定・配備物
Mapping/real/runs/*
!Mapping/real/runs/.gitkeep
Mapping/real/.env
Mapping/real/dist/
Mapping/real/.mapping-state.json

# Perception の検出結果出力（再生成できるため追跡しない）
Perception/sim/outputs/*
!Perception/sim/outputs/.gitkeep
Perception/real/outputs/*
!Perception/real/outputs/.gitkeep

# このPCだけに置くローカル専用データ（共有しない・再取得できるもの）
_local/

# Navigation の sim 資産（fetch_assets.sh が取り直す。手で編集しない前提のvendored物と、
# pcd_to_mjcf.py などが生成する MJCF / STL / hfield が同居するため丸ごと除外する）
# 上流のコミットで固定してあり、bash Navigation/sim/fetch_assets.sh で再取得できる（24MB）
Navigation/sim/assets/
# 記録から作り直せる地図（runs/ 自体が除外されているのと同じ理由）
# scans.npz から再生成できる中間成果物でもある
Navigation/sim/maps/
# Navigation 専用の uv 環境（uv sync で再生成できる）
Navigation/.venv/
# nav3 専用の3.12 venv（rclpy用。--system-site-packagesで作り直せる。1GB超）
Navigation/nav3/.venv_amcl/

# 外部リポジトリのクローン（それぞれ独自の .git を持つ）
Mapping/real/vendor/

# 深度カメラの撮影結果がリポジトリ直下に落ちたもの
Mapping/real/DepthCamera_*.json
Mapping/real/DepthCapture_*.png

# nav2_option: 点群→占有格子ツール専用venv(pip installで再生成できる。open3d同梱で1.8GB超)
Navigation/nav2_option/tools/pointcloud_to_occupancy_grid/.venv/
# nav2_option: ビルド成果物(colcon build / cmake で再生成できる)
Navigation/nav2_option/g1_sdk_bridge_cpp/build/
Navigation/nav2_option/g1_ws/build/
Navigation/nav2_option/g1_ws/install/
Navigation/nav2_option/g1_ws/log/

# 地図の素になる巨大ファイル（2026-09-16 追加）
# ⚠️ **消さないこと。** 地図を作り直すときに要る。git に入れないだけ。
#    生成物（trajectory/*.tum と maps/*.pgm）はリポジトリに入れてあるので、
#    これらが無くても地図は使える。
Navigation/nav2_option/0911_robag/
# 2026-09-23 に Sorasta で取った計測一式(rosbag 877MB + RGB 313MB)。地図の素
Navigation/nav2_option/0923_rosbag/
Navigation/nav2_option/maps/clouds/
Navigation/*.pcd
