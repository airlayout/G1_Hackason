# G1と直結する現場PCのNIC名。IPアドレスではない。
G1_IFACE=enp3s0
G1_HOST=192.168.123.164
G1_USER=unitree

# パスワードをリポジトリへ保存しない。PCD自動回収に使うSSH秘密鍵のホスト側パス。
G1_SSH_KEY=

ROS_DOMAIN_ID=0

# RVizは互換性優先でsoftware renderingを使う。GPU passthroughする場合のみ0にする。
LIBGL_ALWAYS_SOFTWARE=1

# G1ファームウェア差はここで吸収する。
RAW_POINTS_TOPIC=/utlidar/cloud_livox_mid360
RAW_IMU_TOPIC=/utlidar/imu_livox_mid360
ONBOARD_POINTS_TOPIC=/unitree/slam_mapping/points
ONBOARD_ODOM_TOPIC=/unitree/slam_mapping/odom

# 1802でG1本体上に保存するディレクトリ。
ONBOARD_REMOTE_MAP_DIR=/home/unitree/maps

MAPPING_RUNS_DIR=./runs
MIN_FREE_GIB=5
MIN_MAP_POINTS=1000

# PointCloud2内timestampの解釈: auto / absolute_seconds / relative_seconds /
# relative_nanoseconds / infer
POINT_TIMESTAMP_MODE=auto
ALLOW_INFERRED_POINT_TIME=true
