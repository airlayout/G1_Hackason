# G1と直結する現場PCのNIC名。IPアドレスではない。
G1_IFACE=enp3s0
G1_HOST=192.168.123.164

ROS_DOMAIN_ID=0

# RVizは互換性優先でsoftware renderingを使う。GPU passthroughする場合のみ0にする。
LIBGL_ALWAYS_SOFTWARE=1

# G1ファームウェア差はここで吸収する。
RAW_POINTS_TOPIC=/utlidar/cloud_livox_mid360
RAW_IMU_TOPIC=/utlidar/imu_livox_mid360
ONBOARD_POINTS_TOPIC=/unitree/slam_mapping/points
ONBOARD_ODOM_TOPIC=/unitree/slam_mapping/odom

# G1 PC2上のLeRobot ImageServer。画像はJPEGのままrosbagへ記録する。
# 3DGSを目的にする計測ではCAMERA_REQUIRED=trueのまま使用する。
CAMERA_ENABLED=true
CAMERA_REQUIRED=true
CAMERA_HOST=192.168.123.164
CAMERA_ZMQ_PORT=5555
CAMERA_NAME=head_camera
CAMERA_FRAME_ID=camera_color_optical_frame

# 実機の選択したストリームprofileから取得したCameraInfoで埋める。
# 0のままでも画像記録はできるが、validateは校正未確定をWARNにする。
CAMERA_WIDTH=0
CAMERA_HEIGHT=0
CAMERA_FX=0.0
CAMERA_FY=0.0
CAMERA_CX=0.0
CAMERA_CY=0.0

# 1802へ渡すG1内部の保存先。PC側成果物はこのファイルを回収せず、rosbagから作る。
ONBOARD_REMOTE_MAP_DIR=/home/unitree/maps

MAPPING_RUNS_DIR=./runs
MIN_FREE_GIB=5
MIN_MAP_POINTS=1000

# ライブ密度マップ。densityは同じボクセルを観測したスキャン数を0〜1へ正規化する。
MAP_VOXEL_SIZE=0.05
DENSITY_TARGET_SCANS=10

# PointCloud2内timestampの解釈: auto / absolute_seconds / relative_seconds /
# relative_nanoseconds / infer
POINT_TIMESTAMP_MODE=auto
ALLOW_INFERRED_POINT_TIME=true
