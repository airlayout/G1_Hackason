{
  /*** LiDAR-IMU odometry（CPU・屋内）***
  // ⚠️ use_wheel は false。G1 の脚 odom は /dog_odom（nav_msgs/Odometry）で、
  //    GLIM の wheel 拘束が要求するのは sensor_msgs/JointState の左右輪速度である。
  //    形が違うのでそのままでは繋がらない（README に書いた）。
  */
  "odometry_estimation": {
    "so_name": "libodometry_estimation_cpu.so",
    "initialization_mode": "LOOSE",
    "initialization_window_size": 1.0,
    "init_pose_damping_scale": 1e10,
    "smoother_lag": 5.0,
    "use_isam2_dogleg": false,
    "isam2_relinearize_skip": 1,
    "isam2_relinearize_thresh": 0.1,
    "fix_imu_bias": false,
    "registration_type": "GICP",
    "max_iterations": 8,
    "lru_thresh": 100,
    "target_downsampling_rate": 0.1,
    "ivox_resolution": 0.5,
    "ivox_min_dist": 0.1,
    "vgicp_resolution": 0.25,
    "vgicp_voxelmap_levels": 2,
    "vgicp_voxelmap_scaling_factor": 2.0,
    "save_imu_rate_trajectory": true,
    "num_threads": 2,
    "use_wheel": false,
    "wheel_radius": 0.081,
    "wheel_base": 0.37,
    "differential_drive_model_noise": 1e6,
    "wheel_odometry_noise": 1e8,
    "enable_gps": false,
    "gps_noise": 50
  }
}
