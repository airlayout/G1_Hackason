# 作ったばかりの地図を目で確かめるための設定（2026-09-18）。
# 流すのは quickstart/show_map_rviz.sh。2D は /map、3D は /cloud_pcd。
# ⚠️ 窓の大きさは X の解像度（既定 1920x1080）と揃えてある。
#    大きいと import -window root に半分しか写らない。
Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded: []
    Splitter Ratio: 0.6
  Tree Height: 700
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
- Class: nav2_rviz_plugins/Navigation 2
  Name: Navigation 2
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 90; 90; 90
    Enabled: true
    Line Style:
      Line Width: 0.03
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 40
    Reference Frame: <Fixed Frame>
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: false
    Autocompute Value Bounds:
      Max Value: 2.5
      Min Value: -1.0
      Value: false
    Axis: Z
    Channel Name: density
    Class: rviz_default_plugins/PointCloud2
    Color: 220; 220; 220
    Color Transformer: AxisColor
    Decay Time: 300
    Enabled: false
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 1
    Min Color: 45; 74; 120
    Min Intensity: 0
    Name: SLAM map (純正 SLAM 用。この構成では起こさないので切る)
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 2
    Size (m): 0.025
    Style: Points
    Topic:
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /unitree/slam_mapping/points_stamped
    Use Fixed Frame: true
    Use rainbow: true
    Value: false
  - Alpha: 0.85
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 80; 220; 255
    Color Transformer: FlatColor
    Decay Time: 1
    Enabled: false
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Min Color: 0; 0; 0
    Name: LiDAR raw (livox_frame)
    Position Transformer: XYZ
    Selectable: false
    Size (Pixels): 3
    Size (m): 0.03
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /utlidar/cloud_livox_mid360
    Use Fixed Frame: true
    Use rainbow: false
    Value: false
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 1.65
      Min Value: -1.35
      Value: false
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 80; 130; 255
    Color Transformer: AxisColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 1
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: 3D 事前地図 /cloud_pcd（0911・掃除済み）
    Position Transformer: XYZ
    Selectable: false
    Size (Pixels): 2
    Size (m): 0.03
    Style: Points
    Topic:
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /cloud_pcd
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Angle Tolerance: 0.1
    Class: rviz_default_plugins/Odometry
    Covariance:
      Orientation:
        Alpha: 0.35
        Color: 255; 255; 127
        Color Style: Unique
        Frame: Local
        Offset: 1
        Scale: 1
        Value: false
      Position:
        Alpha: 0.3
        Color: 204; 51; 204
        Scale: 1
        Value: false
    Enabled: false
    Keep: 200
    Name: Odometry
    Position Tolerance: 0.1
    Shape:
      Alpha: 1
      Axes Length: 0.4
      Axes Radius: 0.04
      Color: 255; 85; 0
      Head Length: 0.12
      Head Radius: 0.06
      Shaft Length: 0.3
      Shaft Radius: 0.03
      Value: Arrow
    Topic:
      Depth: 10
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /unitree/slam_mapping/odom
    Value: false
  - Class: rviz_default_plugins/TF
    Enabled: true
    Frame Timeout: 15
    Frames:
      All Enabled: true
    Marker Scale: 0.7
    Name: TF (base_link の向き)
    Show Arrows: true
    Show Axes: true
    Show Names: true
    Tree: {}
    Update Interval: 0
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: false
    Name: OctoMap voxels (要 G1_OCTOMAP=1)
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /occupied_cells_vis_array
    Value: false
  - Class: rviz_default_plugins/Map
    Enabled: false
    Name: Projected map 2D (ライブ OctoMap の投影。要 G1_OCTOMAP=1)
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /projected_map
    Alpha: 0.7
    Color Scheme: map
    Draw Behind: true
    Value: false
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /projected_map_updates
    Use Timestamp: false
  - Class: rviz_default_plugins/Map
    Enabled: true
    Name: 2D 走る地図 /map（0911・maxRange 2m）
    Alpha: 0.9
    Color Scheme: map
    Draw Behind: true
    Value: true
    Use Timestamp: false
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map_updates
  - Class: rviz_default_plugins/Path
    Enabled: true
    Name: Nav2 plan
    Alpha: 1.0
    Buffer Length: 1
    Color: 255; 85; 255
    Line Style: Lines
    Line Width: 0.03
    Offset:
      X: 0
      Y: 0
      Z: 0
    Value: true
    Pose Style: None
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /plan
  - Class: rviz_default_plugins/Map
    Enabled: false
    Name: Global Costmap（経路が引けない理由の切り分け）
    Alpha: 0.5
    Color Scheme: costmap
    Draw Behind: false
    Value: false
    Use Timestamp: false
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /global_costmap/costmap
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /global_costmap/costmap_updates
  - Class: rviz_default_plugins/Map
    Enabled: true
    Name: Local Costmap（段 A の合否）
    Alpha: 0.7
    Color Scheme: costmap
    Draw Behind: false
    Value: true
    Use Timestamp: false
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/costmap
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/costmap_updates
  - Class: rviz_default_plugins/Polygon
    Enabled: true
    Name: Footprint (robot_radius 0.30)
    Alpha: 1.0
    Color: 25; 255; 0
    Value: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/published_footprint
  Enabled: true
  Global Options:
    Background Color: 32; 35; 42
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /goal_pose
  # 走行中に押して止める口（2026-09-18 に足した）。/cancel_nav に PointStamped を撃つ。
  # ⚠️ **Nav2 パネルの Cancel は「2D Goal Pose」のクリックを切れない**
  #    （パネルは自分が投げたゴールしか掴まない。09-18 実測）。
  # 受けるのは stray_guard.py --cancel-topic。**Nav2 と同じ側に常駐させること**
  #    （キャンセルはサービス呼び出しなので AP を越えない）。
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /cancel_nav
  - Class: nav2_rviz_plugins/GoalTool
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: map
      Distance: 42.0
      Yaw: 2.55
      Pitch: 0.42
      Focal Point:
        X: 8.0
        Y: -2.0
        Z: 0.0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Near Clip Distance: 0.01
      Value: Orbit (rviz)
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 1024
  Hide Left Dock: false
  Hide Right Dock: true
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1920
  X: 0
  Y: 28
